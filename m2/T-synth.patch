+    # whole, writers of one global through `var_external`, and a timed program under an
+    # event task. The least of three counts.
+    defp reductions_to_configure(count) do
+      writer = program("var_external shared bool\nvar_input go bool\nxic go ote shared", "writer")
+
+      timed =
+        program(
+          "var_input go bool\nvar t1 ton\nvar_output done bool\nxic go ton t1 500\n" <>
