+
+  defp not_a_program("", base, _configuration),
+    do: "`#{base}` has no extension: a program's file ends in `.ld`, as in `#{base}.ld`"
+
+  defp not_a_program(extension, base, _configuration),
+    do:
+      "`#{base}` is not a program's file: its extension is `#{extension}`, and a program's " <>
