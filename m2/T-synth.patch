+
+      lines =
+        ["var_global estop bool at panel.i.0", "var_global shared bool", "var_global spare dint"] ++
+          Enum.flat_map(1..count, &instance_lines/1)
+
+      source = Enum.join(lines, "\n")
+
+      Enum.min(
+        for _ <- 1..3 do
+          {:reductions, before} = Process.info(self(), :reductions)
+          {:ok, _configuration} = Configuration.compile("big", source, given)
+          {:reductions, later} = Process.info(self(), :reductions)
+          later - before
+        end
+      )
+    end
