+        "task e#{i} single estop interval #{i + 5} priority 0",
+        "var_global pb#{i} bool at panel.i.#{i}",
+        "var_global k#{i} bool at panel.q.#{i}",
+        "var_global sp#{i} dint at drive.q.#{i}.0",
+        "var_global f#{i} bool #{rem(i, 2)}",
+        "program m#{i} motor with t#{i}",
+        "m#{i}.start pb#{i}",
+        "m#{i}.stop f#{i}",
+        "m#{i}.overtemp 0",
+        "m#{i}.reset k#{i}",
+        "m#{i}.motor k#{i}",
+        "m#{i}.speed_sp sp#{i}",
