new file mode 100644
index 0000000..a7da829
--- /dev/null
+++ b/lib/logex/configuration.ex
@@ -0,0 +1,1385 @@
+defmodule Logex.Configuration do
+  @moduledoc """
+  A configuration: the program instances one resource runs, the globals and I/O points
+  that connect them, and the tasks that schedule them (M2-2, M2-3, M2-4, M2-6;
+  `docs/organisation.md` §4.4). It is data, and its saved form is a configuration file,
+  `plant.lxcf`, read by `Logex.Configuration.Text`.
+
+  *Spike.* This module stands in for the one checked constructor that the scheduler's
+  design (M2-1) owns. What the configuration file needs from it is its contract: `check/3`
+  takes the entries `Logex.Configuration.Text.read/1` gives, or the same entries built in
+  Elixir with no lines, and the compiled programs by type name, and runs every check below
+  once, so a configuration from text and one from Elixir meet the same rules with the same
+  messages; `new!/3` is its Elixir face, raising them all at once.
+
+      compile(name, source, programs) :: {:ok, %Configuration{}} | {:error, [diagnostic]}
+      compile_file(path)              :: {:ok, %Configuration{}} | {:error, [diagnostic]}
+      check(name, entries, programs)  :: {:ok, %Configuration{}} | {:error, [diagnostic]}
+      new!(name, entries, programs)   :: %Configuration{}
+
+  A mistake in the text or the wiring is a `%Logex.Diagnostic{stage: :configure}` (a
+  file that cannot be read, or a type with no file, `:file`), located at its line of the
+  configuration file. Entries that no text could say, and a call that breaks this
+  contract, raise `ArgumentError`. Warnings ride on the configuration, as a program's ride
+  on it: `warnings`, in line order.
+  """
+
+  alias Logex.{Declarations, Diagnostic, Program, Tag}
+  alias Logex.Configuration.Text
+
+  # The extension decision 3 asked for before M2-2 (`.lcf` was its placeholder).
+  @extension ".lxcf"
+
+  @enforce_keys [:name]
+  defstruct [
+    :name,
+    tasks: [],
+    globals: [],
+    instances: [],
+    connections: [],
+    programs: %{},
+    warnings: []
+  ]
+
+  @max 2_147_483_647
+
+  @doc "The configuration file's extension, `.lxcf`."
+  def extension, do: @extension
+
+  @doc """
+  Compiles a configuration's `source` against compiled program types, `programs`, a map
+  from each type's name to its `%Logex.Program{}`: the pure seam, with no file I/O
+  (`docs/organisation.md` §4.4, "Loading"). `{:ok, %Logex.Configuration{}}`, or
+  `{:error, diagnostics}` with every mistake, in line order. A lex error stops it and is
+  the only diagnostic.
+  """
+  def compile(name, source, programs)
+
+  def compile(name, _source, _programs) when not is_binary(name),
+    do: raise(ArgumentError, "a configuration's name is a string, got: #{inspect(name)}")
+
+  def compile(_name, source, _programs) when not is_binary(source),
+    do:
+      raise(
+        ArgumentError,
+        "Logex.Configuration.compile/3 takes source text as a binary, got: #{inspect(source)}"
+      )
+
+  def compile(name, source, programs) do
+    named!(name)
+    programs!(programs)
+    from_text(Text.read(source), name, programs, MapSet.new(), [])
+  end
+
+  @doc """
+  Checks a configuration given as entries, in the shape `Logex.Configuration.Text.read/1`
+  gives, against compiled program types: the one checked constructor that the text and
+  the Elixir data path share. An entry built in Elixir has no line (`nil`), and a
+  diagnostic about it none either, after those that have one.
+
+  An entry that no configuration line could say (a name that does not lex as one name, a
+  negative number, a field of the wrong kind) raises `ArgumentError`, as
+  `Logex.Parser.well_formed!/1` does for a program's tree.
+  """
+  def check(name, entries, programs) do
+    named!(name)
+    programs!(programs)
+    Text.entries!(entries)
+    checked(name, entries, programs, MapSet.new(), [])
+  end
+
+  @doc """
+  The Elixir face of `check/3`: the configuration, or one `ArgumentError` whose message is
+  every problem, a line each, in `check/3`'s order, as `Logex.Runtime.call/4` raises every
+  input problem at once. `docs/organisation.md` §4.4, "Loading": a constructor built from
+  Elixir data runs the same checks, as `Logex.Tag.new!/4` does.
+
+  An entry from Elixir has no line: a line is where a configuration file declares an
+  entry, and every message that cites one relies on that, as `Logex.Tag.new!/4` refuses a
+  line on a tag. Warnings do not raise; they ride on the configuration.
+  """
+  def new!(name, entries, programs) do
+    named!(name)
+    programs!(programs)
+    Text.entries!(entries)
+    Enum.each(entries, &unlined!/1)
+    built(checked(name, entries, programs, MapSet.new(), []))
+  end
+
+  defp unlined!({_kind, nil, _fields}), do: :ok
+
+  defp unlined!(entry),
+    do:
+      raise(
+        ArgumentError,
+        "an entry built in Elixir has no line: a line is where a configuration file " <>
+          "declares an entry, got: #{inspect(entry)}"
+      )
+
+  defp built({:ok, configuration}), do: configuration
+
+  defp built({:error, diagnostics}),
+    do: raise(ArgumentError, Enum.map_join(diagnostics, "\n", &Diagnostic.format/1))
+
+  @doc """
+  Reads and compiles the configuration file at `path`, naming the configuration after the
+  file: `plant.lxcf` is `plant`. Each program type a `program` line names is read from
+  the file of that name beside it, `motor` from `motor.ld`, and compiled with
+  `Logex.compile_file/1` once. Every diagnostic and warning carries its file.
+
+  A path that does not end in `.lxcf`, a file that cannot be read, and a program type with
+  no file are `:file` diagnostics, not exceptions; the last is located at the `program`
+  line that first names the type. A type whose file has mistakes adds them, each in its
+  own file, after the configuration's own, and its instances are not checked further.
+  """
+  def compile_file(path) when is_binary(path), do: by_extension(Path.extname(path), path)
+
+  def compile_file(path),
+    do:
+      raise(
+        ArgumentError,
+        "Logex.Configuration.compile_file/1 takes a path as a binary, got: #{inspect(path)}"
+      )
+
+  defp by_extension(@extension, path), do: loaded(File.read(path), path)
+
+  defp by_extension(".ld", path),
+    do:
+      {:error,
+       [
+         file_problem(
+           path,
+           "`#{Path.basename(path)}` is a program's file, not a configuration's: compile it " <>
+             "with Logex.compile_file/1, and name its type on a `program` line"
+         )
+       ]}
+
+  defp by_extension(_other, path),
+    do:
+      {:error,
+       [
+         file_problem(
+           path,
+           "`#{Path.basename(path)}` is not a configuration file: a configuration's file " <>
+             "ends in `#{@extension}`, as in `plant#{@extension}`"
+         )
+       ]}
+
+  defp loaded({:error, reason}, path),
+    do: {:error, [file_problem(path, "cannot be read: #{:file.format_error(reason)}")]}
+
+  defp loaded({:ok, source}, path) do
+    name = Path.basename(path, @extension)
+    named = name_problems(name, path)
+    in_file(types(Text.read(source), Path.dirname(path), name, named), path)
+  end
+
+  defp name_problems(name, path), do: shaped(Declarations.name?(name), name, path)
+
+  defp shaped(true, _name, _path), do: []
+
+  defp shaped(false, name, path),
+    do: [file_problem(path, name_message(name) <> " (rename the file)")]
+
+  defp name_message(name),
+    do:
+      "#{inspect(name)} cannot name a configuration: a name is a letter or `_`, " <>
+        "then letters, digits or `_`"
+
+  # Each type a `program` line names, in the order of its first line, read once from its
+  # file beside the configuration.
+  defp types({:error, [%Diagnostic{stage: :lex}] = lexed, []}, _dir, _name, named),
+    do: {:error, named ++ lexed, []}
+
+  defp types(read, dir, name, named) do
+    entries = entries_of(read)
+
+    {programs, failed, relocated, theirs} =
+      entries
+      |> first_lines()
+      |> Enum.reduce({%{}, MapSet.new(), [], []}, &load(&1, &2, dir))
+
+    early = named ++ problems_of(read) ++ Enum.reverse(relocated)
+    files = Map.new(programs, fn {type, _program} -> {type, Path.join(dir, type <> ".ld")} end)
+    {checked(name, entries, programs, failed, early, files), Enum.reverse(theirs)}
+  end
+
+  defp entries_of({:ok, entries}), do: entries
+  defp entries_of({:error, _problems, entries}), do: entries
+
+  defp problems_of({:ok, _entries}), do: []
+  defp problems_of({:error, problems, _entries}), do: problems
+
+  defp first_lines(entries) do
+    entries
+    |> Enum.flat_map(&typed_line/1)
+    |> Enum.uniq_by(fn {type, _line} -> type end)
+  end
+
+  defp typed_line({:program, line, %{type: type}}), do: loadable(type_name?(type), type, line)
+  defp typed_line(_entry), do: []
+
+  defp loadable(true, type, line), do: [{type, line}]
+  defp loadable(false, _type, _line), do: []
+
+  defp load({type, line}, {programs, failed, relocated, theirs}, dir) do
+    path = Path.join(dir, type <> ".ld")
+    found = {programs, failed, relocated, theirs}
+    on_disk(File.exists?(path), type, line, path, dir, found)
+  end
+
+  defp on_disk(true, type, line, path, _dir, found),
+    do: loaded_type(Logex.compile_file(path), type, line, path, found)
+
+  # No file of the type's name: the configuration names a type that is not there, the
+  # same mistake `compile/3` reports with the types given, so the same stage and a
+  # did-you-mean among the program files beside it (§4.4, "Unknown names").
+  defp on_disk(false, type, line, _path, dir, {programs, failed, relocated, theirs}) do
+    problem = %Diagnostic{stage: :configure, line: line, message: missing_type(type, beside(dir))}
+    {programs, MapSet.put(failed, type), [problem | relocated], theirs}
+  end
+
+  defp beside(dir), do: listed_types(File.ls(dir))
+
+  defp listed_types({:ok, files}),
+    do: for(file <- Enum.sort(files), Path.extname(file) == ".ld", do: Path.rootname(file))
+
+  defp listed_types({:error, _reason}), do: []
+
+  defp missing_type(type, types),
+    do:
+      "unknown program type `#{type}`: there is no `#{type}.ld` beside this configuration" <>
+        files_hint(Declarations.suggest(type, types, & &1, "program types"), types)
+
+  defp files_hint("", []), do: ", nor any program file"
+
+  defp files_hint("", types),
+    do: ": the program files beside it are " <> listed(Enum.map(types, &(&1 <> ".ld")))
+
+  defp files_hint(suggestion, _types), do: suggestion
+
+  defp loaded_type({:ok, program}, type, _line, _path, {programs, failed, relocated, theirs}),
+    do: {Map.put(programs, type, program), failed, relocated, theirs}
+
+  # The only `:file` diagnostic a readable name ending in `.ld` gets is that it cannot be
+  # read, and that is the configuration's mistake, at the line that names the type.
+  defp loaded_type(
+         {:error, [%Diagnostic{stage: :file, message: message}]},
+         type,
+         line,
+         path,
+         {programs, failed, relocated, theirs}
+       ) do
+    problem = %Diagnostic{
+      stage: :file,
+      line: line,
+      message: "no program type `#{type}`: #{path} #{message}"
+    }
+
+    {programs, MapSet.put(failed, type), [problem | relocated], theirs}
+  end
+
+  defp loaded_type(
+         {:error, diagnostics},
+         type,
+         _line,
+         _path,
+         {programs, failed, relocated, theirs}
+       ),
+       do: {programs, MapSet.put(failed, type), relocated, Enum.reverse(diagnostics, theirs)}
+
+  defp in_file({:error, _named_and_lexed, []} = lexed, path), do: stamped(lexed, path)
+
+  defp in_file({{:ok, config}, []}, path),
+    do: {:ok, %{config | warnings: stamp(config.warnings, path)}}
+
+  defp in_file({{:ok, _config}, theirs}, _path), do: {:error, theirs}
+  defp in_file({{:error, ours}, theirs}, path), do: {:error, stamp(ours, path) ++ theirs}
+
+  defp stamped({:error, diagnostics, []}, path), do: {:error, stamp(diagnostics, path)}
+
+  defp stamp(diagnostics, path), do: Enum.map(diagnostics, &file(&1, path))
+
+  defp file(%Diagnostic{file: nil} = diagnostic, path), do: %{diagnostic | file: path}
+  defp file(diagnostic, _path), do: diagnostic
+
+  defp file_problem(path, message),
+    do: %Diagnostic{stage: :file, line: nil, file: path, message: message}
+
+  defp from_text({:error, [%Diagnostic{stage: :lex}] = lexed, []}, _name, _programs, _failed, _),
+    do: {:error, lexed}
+
+  defp from_text(read, name, programs, failed, early),
+    do: checked(name, entries_of(read), programs, failed, early ++ problems_of(read))
+
+  # The host's side of the contract.
+  defp named!(name) when is_binary(name), do: named!(Declarations.name?(name), name)
+
+  defp named!(name),
+    do: raise(ArgumentError, "a configuration's name is a string, got: #{inspect(name)}")
+
+  defp named!(true, _name), do: :ok
+  defp named!(false, name), do: raise(ArgumentError, name_message(name))
+
+  defp programs!(programs) when is_map(programs) and not is_struct(programs),
+    do: Enum.each(programs, &program!/1)
+
+  defp programs!(programs),
+    do:
+      raise(
+        ArgumentError,
+        "programs must be a map of type names to %Logex.Program{}, as in " <>
+          ~s|%{"motor" => motor}, got: #{inspect(programs)}|
+      )
+
+  defp program!({type, %Program{name: type, tags: tags, rungs: rungs}})
+       when is_binary(type) and is_map(tags) and is_list(rungs),
+       do: :ok
+
+  defp program!({type, %Program{name: name}}) when is_binary(type),
+    do:
+      raise(
+        ArgumentError,
+        "the program given as `#{type}` is named #{inspect(name)}: a type is given under " <>
+          "its own name"
+      )
+
+  defp program!({type, program}),
+    do:
+      raise(
+        ArgumentError,
+        "programs must be a map of type names to %Logex.Program{}, got: " <>
+          inspect(%{type => program})
+      )
+
+  # ---------------------------------------------------------------------------------------
+  # The checks, once for both paths. State: every declared name by name, and its folded
+  # twin; what was declared of each kind; and the problems and warnings, as {line, text}.
+
+  defp checked(name, entries, programs, failed, early, files \\ %{}) do
+    state = %{
+      files: files,
+      names: %{},
+      folded: %{},
+      tasks: [],
+      globals: %{},
+      points: %{},
+      instances: [],
+      connections: [],
+      inputs: %{},
+      drivers: %{},
+      uses: MapSet.new(),
+      broken: MapSet.new(),
+      by_name: %{},
+      analysis: %{},
+      programs: programs,
+      failed: failed,
+      problems: [],
+      warnings: []
+    }
+
+    state = Enum.reduce(entries, state, &declare/2)
+    state = Enum.reduce(Enum.reverse(state.tasks), state, &triggered/2)
+    state = Enum.reduce(Enum.reverse(state.instances), state, &scheduled/2)
+
+    state =
+      entries
+      |> Enum.filter(&match?({:connection, _, _}, &1))
+      |> Enum.reduce(state, &connected/2)
+
+    state = Enum.reduce(Enum.reverse(state.instances), state, &unconnected/2)
+    state = externals(state)
+    state = any_program(state)
+    state = warned(state)
+    result(name, state, early)
+  end
+
+  defp result(name, %{problems: []} = state, []) do
+    {:ok,
+     %__MODULE__{
+       name: name,
+       tasks: Enum.reverse(state.tasks),
+       globals: Enum.map(sorted_globals(state), &Map.drop(&1, [:location, :order])),
+       instances: Enum.map(Enum.reverse(state.instances), &Map.delete(&1, :program)),
+       connections: Enum.reverse(state.connections),
+       programs: state.programs,
+       warnings: diagnostics(state.warnings, :warning)
+     }}
+  end
+
+  defp result(_name, state, early),
+    do: {:error, Enum.sort_by(early ++ diagnostics(state.problems, :error), &order/1)}
+
+  defp sorted_globals(state), do: Enum.sort_by(Map.values(state.globals), & &1.order)
+
+  defp diagnostics(found, severity),
+    do:
+      found
+      |> Enum.reverse()
+      |> Enum.map(fn {line, message} ->
+        %Diagnostic{stage: :configure, line: line, message: message, severity: severity}
+      end)
+      |> Enum.sort_by(&order/1)
+
+  # Line order, a diagnostic with no line (an entry from Elixir, or the file) last.
+  defp order(%Diagnostic{line: nil}), do: {1, 0}
+  defp order(%Diagnostic{line: line}), do: {0, line}
+
+  defp problem(state, line, message), do: %{state | problems: [{line, message} | state.problems]}
+  defp warning(state, line, message), do: %{state | warnings: [{line, message} | state.warnings]}
+
+  # Declarations: every task, global and instance enters one namespace (§4.4), in line
+  # order. A broken line's name enters it too, through the same name checks, so a name
+  # that is a keyword is refused there as anywhere; once in, nothing that names it is
+  # reported again.
+  defp declare({:task, line, task}, state) do
+    {state, entered} = enter(state, :task, task.name, line)
+    state = task_problems(state, line, task)
+    keep(entered, state, :tasks, Map.put(task, :line, line))
+  end
+
+  defp declare({:global, line, global}, state) do
+    {state, entered} = enter(state, :global, global.name, line)
+    {state, location} = locate(state, line, global, entered)
+    state = initial_problems(state, line, global, location)
+    global = Map.merge(global, %{line: line, location: location, order: line_order(line, state)})
+    keep_global(entered, state, global)
+  end
+
+  defp declare({:program, line, program}, state) do
+    {state, entered} = enter(state, :instance, program.name, line)
+    {state, compiled} = typed(state, line, program.type)
+    instance = Map.merge(program, %{line: line, program: compiled})
+    keep(entered, analysed(state, program.type, compiled), :instances, instance)
+  end
+
+  defp declare({:declared, line, %{kind: :connection} = connection}, state),
+    do: %{
+      state
+      | inputs: Map.put(state.inputs, {connection.instance, connection.member}, {:broken, line})
+    }
+
+  defp declare({:declared, line, %{kind: kind, name: name}}, state) do
+    {state, _entered} = enter(state, kind, name, line)
+    %{state | broken: MapSet.put(state.broken, name)}
+  end
+
+  defp declare({:connection, _line, _connection}, state), do: state
+
+  defp line_order(nil, state), do: {1, map_size(state.globals)}
+  defp line_order(line, _state), do: {0, line}
+
+  defp keep(false, state, _field, _value), do: state
+
+  defp keep(true, state, field, value) do
+    state = Map.update!(state, field, &[value | &1])
+    %{state | by_name: Map.put(state.by_name, {field, value.name}, value)}
+  end
+
+  # What each type writes and which timers it runs, worked out once a type, not once an
+  # instance, so a configuration's check stays linear in its instances.
+  defp analysed(state, _type, nil), do: state
+
+  defp analysed(state, type, _program) when is_map_key(state.analysis, type), do: state
+
+  defp analysed(state, type, program),
+    do: %{state | analysis: Map.put(state.analysis, type, {writes(program), timers(program)})}
+
+  defp written_by(state, instance), do: elem(Map.fetch!(state.analysis, instance.type), 0)
+  defp timers_of(state, instance), do: elem(Map.fetch!(state.analysis, instance.type), 1)
+
+  defp keep_global(false, state, _global), do: state
+
+  defp keep_global(true, state, global),
+    do: %{state | globals: Map.put(state.globals, global.name, global)}
+
+  defp enter(state, kind, name, line),
+    do: named(name_problem(kind, name), state, kind, name, line)
+
+  defp named(nil, state, kind, name, line),
+    do: clash(Map.get(state.folded, String.downcase(name)), state, kind, name, line)
+
+  defp named(message, state, _kind, _name, line), do: {problem(state, line, message), false}
+
+  defp clash(nil, state, kind, name, line) do
+    state = %{
+      state
+      | names: Map.put(state.names, name, {kind, line}),
+        folded: Map.put(state.folded, String.downcase(name), name)
+    }
+
+    {state, true}
+  end
+
+  defp clash(name, state, _kind, name, line) do
+    {kind, first} = Map.fetch!(state.names, name)
+    {problem(state, line, "`#{name}` is declared twice: #{first_as(first, kind)}"), false}
+  end
+
+  defp clash(twin, state, _kind, name, line) do
+    {kind, first} = Map.fetch!(state.names, twin)
+
+    message =
+      "`#{name}` and `#{twin}`#{at_line(first)} differ only in case: names are " <>
+        "case-sensitive, so these would be two (`#{twin}` is #{a(kind)})"
+
+    {problem(state, line, message), false}
+  end
+
+  defp name_problem(kind, name),
+    do: name_problem(Text.keyword?(name), String.contains?(name, "."), kind, name)
+
+  defp name_problem(true, _dotted, kind, name),
+    do: "`#{name}` is a keyword and cannot name #{a(kind)}"
+
+  defp name_problem(false, true, kind, name),
+    do:
+      "`#{name}` cannot name #{a(kind)}: `.` is kept for a path, as in `m1.start`, " <>
+        "and a location, as in `panel.i.0`"
+
+  defp name_problem(false, false, _kind, _name), do: nil
+
+  defp word(:task), do: "task"
+  defp word(:global), do: "global"
+  defp word(:instance), do: "instance"
+
+  defp a(:instance), do: "an instance"
+  defp a(kind), do: "a " <> word(kind)
+
+  defp first_as(nil, kind), do: "the first is #{a(kind)}"
+  defp first_as(line, kind), do: "first on line #{line}, as #{a(kind)}"
+
+  defp at_line(nil), do: ""
+  defp at_line(line), do: " (line #{line})"
+
+  # A task: a priority, an interval or a trigger, and numbers in range (D3.1, D3.3).
+  defp task_problems(state, line, task) do
+    state
+    |> scheduling(line, task)
+    |> interval(line, task)
+    |> priority(line, task)
+  end
+
+  defp scheduling(state, line, %{interval: nil, single: nil, name: name}),
+    do:
+      problem(
+        state,
+        line,
+        "task `#{name}` needs an interval, as in `task #{name} interval 10 priority 1`, " <>
+          "or a trigger, as in `task #{name} single estop priority 0`"
+      )
+
+  defp scheduling(state, _line, _task), do: state
+
+  defp interval(state, line, %{interval: 0, name: name}),
+    do:
+      problem(
+        state,
+        line,
+        "the interval of `#{name}` is 0: an interval is at least 1 ms, and an instance " <>
+          "that runs every cycle is declared without `with`"
+      )
+
+  defp interval(state, line, %{interval: ms, name: name}) when is_integer(ms) and ms > @max,
+    do:
+      problem(
+        state,
+        line,
+        "the interval of `#{name}` is `#{ms}` ms: an interval is 1 to #{@max} ms"
+      )
+
+  defp interval(state, _line, _task), do: state
+
+  defp priority(state, line, %{priority: nil, name: name}),
+    do:
+      problem(
+        state,
+        line,
+        "task `#{name}` needs a priority, as in `task #{name} interval 10 priority 1`: " <>
+          "0 is the highest"
+      )
+
+  defp priority(state, line, %{priority: p, name: name}) when p > @max,
+    do:
+      problem(
+        state,
+        line,
+        "the priority of `#{name}` is `#{p}`: a priority is 0 to #{@max}, and 0 is the highest"
+      )
+
+  defp priority(state, _line, _task), do: state
+
+  # A global: its location, if any (§4.5), and its initial value.
+  # A refused global (a name declared twice, or a keyword) has its location checked, but
+  # does not take it: one mistake, one message.
+  defp locate(state, _line, %{at: nil}, _entered), do: {state, nil}
+
+  defp locate(state, line, %{at: at} = global, entered),
+    do: located(location(at), state, line, global, entered)
+
+  # A location: a device of one name part, `i` or `q`, then one integer field or more
+  # (decision 6, `docs/organisation.md` §4.5), each written one way: `i` or `q` lowercase,
+  # and an address field with no leading zero, so two spellings never name one point.
+  defp location(at), do: spelled(parsed(String.split(at, ".")), at)
+
+  defp parsed([device, direction, _ | _] = parts) when direction in ["i", "q", "I", "Q"] do
+    address = Enum.drop(parts, 2)
+    addressed(Enum.all?(address, &digits?/1), device, direction, address)
+  end
+
+  defp parsed(_parts), do: :error
+
+  defp addressed(true, device, direction, address),
+    do:
+      {:ok,
+       {device, String.to_existing_atom(String.downcase(direction)),
+        Enum.map(address, &String.to_integer/1)}}
+
+  defp addressed(false, _device, _direction, _address), do: :error
+
+  defp digits?(part), do: String.match?(part, ~r/\A[0-9]+\z/)
+
+  defp spelled(:error, _at), do: :error
+  defp spelled({:ok, key}, at), do: canonical(canonical_text(key) == at, key)
+
+  defp canonical(true, key), do: {:ok, key}
+  defp canonical(false, key), do: {:respell, key}
+
+  defp canonical_text({device, direction, address}),
+    do:
+      Enum.join(
+        [device, Atom.to_string(direction) | Enum.map(address, &Integer.to_string/1)],
+        "."
+      )
+
+  defp located({:ok, key}, state, line, global, true),
+    do: taken(Map.get(state.points, key), state, line, global, key)
+
+  defp located({:ok, key}, state, _line, _global, false), do: {state, key}
+
+  defp located({:respell, key}, state, line, %{at: at}, _entered),
+    do:
+      {problem(
+         state,
+         line,
+         "`#{at}` is not a location as written: a location's `i` or `q` is lowercase and " <>
+           "its address has no leading zero, so it is written `#{canonical_text(key)}`"
+       ), nil}
+
+  defp located(:error, state, line, %{at: at}, _entered),
+    do:
+      {problem(
+         state,
+         line,
+         "`#{at}` is not a location: a location is a device, `i` or `q`, and an address, " <>
+           "as in `panel.i.0`"
+       ), nil}
+
+  defp taken(nil, state, line, global, key),
+    do: {%{state | points: Map.put(state.points, key, {global.name, line})}, key}
+
+  defp taken({other, first}, state, line, global, key),
+    do:
+      {problem(
+         state,
+         line,
+         "`#{global.name}` is at `#{global.at}`, where `#{other}` already is#{at_line(first)}: " <>
+           "a location holds one global"
+       ), key}
+
+  defp initial_problems(state, _line, %{initial: nil}, _location), do: state
+
+  defp initial_problems(state, line, %{name: name, at: at}, {_device, :i, _address})
+       when is_binary(at),
+       do:
+         problem(
+           state,
+           line,
+           "`#{name}` is an input point: its value comes from the input image, so it takes " <>
+             "no initial value"
+         )
+
+  defp initial_problems(state, line, %{name: name, at: at}, {_device, :q, _address})
+       when is_binary(at),
+       do:
+         problem(
+           state,
+           line,
+           "`#{name}` is an output point: it takes no initial value, and is 0 until its " <>
+             "driver writes it"
+         )
+
+  defp initial_problems(state, line, %{type: type, name: name, initial: value}, _location),
+    do: fits(Declarations.fits?(type, value), state, line, type, name, value)
+
+  defp fits(true, state, _line, _type, _name, _value), do: state
+
+  defp fits(false, state, line, :bool, name, value),
+    do:
+      problem(
+        state,
+        line,
+        "`#{name}` is a bool: its initial value must be 0 or 1, found `#{value}`"
+      )
+
+  defp fits(false, state, line, :dint, name, value),
+    do: problem(state, line, "`#{name}` is a dint: `#{value}` does not fit in 32 bits")
+
+  # A program line's type: a name, not a keyword, and one of the types given.
+  defp typed(state, line, type) do
+    type_problem(type_name?(type), Text.keyword?(type), state, line, type)
+  end
+
+  defp type_name?(type), do: Declarations.name?(type) and not Text.keyword?(type)
+
+  defp type_problem(_name?, true, state, line, type),
+    do: {problem(state, line, "`#{type}` is a keyword and cannot name a program type"), nil}
+
+  defp type_problem(false, false, state, line, type),
+    do:
+      {problem(
+         state,
+         line,
+         "`#{type}` cannot name a program type: a type is named by its file, `motor.ld` " <>
+           "for `motor`, and a name is a letter or `_`, then letters, digits or `_`"
+       ), nil}
+
+  defp type_problem(true, false, state, line, type),
+    do:
+      known_type(
+        Map.fetch(state.programs, type),
+        MapSet.member?(state.failed, type),
+        state,
+        line,
+        type
+      )
+
+  defp known_type({:ok, program}, _failed, state, _line, _type), do: {state, program}
+  defp known_type(:error, true, state, _line, _type), do: {state, nil}
+
+  defp known_type(:error, false, state, line, type),
+    do: {problem(state, line, unknown_type(type, Map.keys(state.programs))), nil}
+
+  defp unknown_type(type, []),
+    do: "unknown program type `#{type}`: no program types were given"
+
+  defp unknown_type(type, types),
+    do:
+      suggested_type(
+        Declarations.suggest(type, types, & &1, "program types"),
+        type,
+        Enum.sort(types)
+      )
+
+  defp suggested_type("", type, types),
+    do: "unknown program type `#{type}`: the types given are #{listed(types)}"
+
+  defp suggested_type(suggestion, type, _types),
+    do: "unknown program type `#{type}`" <> suggestion
+
+  # References, once every name is declared: a configuration's lines may come in any
+  # order, as §4.4's example names `estop` on a task line before its `var_global`.
+  defp triggered(%{single: nil}, state), do: state
+
+  defp triggered(%{single: source, line: line}, state),
+    do: trigger(resolve(state, source, :global, line), state, line, source)
+
+  defp trigger({:ok, %{type: :bool}}, state, _line, source),
+    do: %{state | uses: MapSet.put(state.uses, source)}
+
+  defp trigger({:ok, global}, state, line, _source),
+    do:
+      problem(
+        state,
+        line,
+        "`#{global.name}` is a #{global.type}#{at_line(global.line)}: a task's `single` is a " <>
+          "bool global"
+      )
+
+  defp trigger({:error, message}, state, line, _source), do: problem(state, line, message)
+  defp trigger(:skip, state, _line, _source), do: state
+
+  defp scheduled(%{task: nil}, state), do: state
+
+  defp scheduled(%{task: task, line: line}, state),
+    do: in_task(resolve(state, task, :task, line), state, line)
+
+  defp in_task({:error, message}, state, line), do: problem(state, line, message)
+  defp in_task(_found, state, _line), do: state
+
+  # What a name refers to: `{:ok, entity}`, `{:error, message}`, or `:skip` for a name a
+  # broken line declared, which was reported there.
+  defp resolve(state, name, want, line) do
+    found(Map.get(state.names, name), MapSet.member?(state.broken, name), state, name, want, line)
+  end
+
+  defp found(_any, true, _state, _name, _want, _line), do: :skip
+  defp found({want, _line}, false, state, name, want, _at), do: entity(state, want, name)
+
+  defp found({kind, line}, false, _state, name, want, _at),
+    do: {:error, "`#{name}` is #{a(kind)}#{at_line(line)}, not #{a(want)}"}
+
+  defp found(nil, false, state, name, want, _at), do: {:error, undeclared(state, name, want)}
+
+  defp entity(state, :global, name), do: {:ok, Map.fetch!(state.globals, name)}
+  defp entity(state, :task, name), do: {:ok, Map.fetch!(state.by_name, {:tasks, name})}
+  defp entity(state, :instance, name), do: {:ok, Map.fetch!(state.by_name, {:instances, name})}
+
+  defp undeclared(state, name, kind),
+    do: undeclared(String.contains?(name, "."), state, name, kind)
+
+  # A name with a `.` where a global is wanted: `docs/organisation.md` §4.7, position
+  # decides what `.` means, and each wrong reading gets a message that names it.
+  defp undeclared(true, state, name, _kind) do
+    [first | _] = String.split(name, ".")
+    dotted(Map.get(state.names, first), location(name), state, name, first)
+  end
+
+  defp undeclared(false, state, name, kind),
+    do: keyworded(Text.keyword?(name), state, name, kind)
+
+  # No program-to-program connection (§5): instances share a value through a global.
+  defp dotted({:instance, _line}, _location, _state, name, _first),
+    do:
+      "`#{name}` is an instance's member: instances share a value only through a global, " <>
+        "which one drives and the other reads"
+
+  # A raw location in a connection or a `single` (§5: not adopted; §4.7).
+  defp dotted(_declared, {kind, key}, state, name, _first) when kind in [:ok, :respell],
+    do: "`#{name}` is a location, " <> where_located(Map.get(state.points, key), name)
+
+  defp dotted({kind, line}, :error, _state, name, first),
+    do:
+      "`#{name}` names a member of `#{first}`, but `#{first}` is #{a(kind)}#{at_line(line)}, " <>
+        "not an instance"
+
+  defp dotted(nil, :error, state, name, first),
+    do:
+      "`#{name}` names a member of an instance, and there is no instance `#{first}`" <>
+        Declarations.suggest(first, names_of(state, :instance), & &1, "names")
+
+  defp where_located({global, line}, _name),
+    do:
+      "written only after `at` on a `var_global` line: name the global at it, " <>
+        "`#{global}`#{at_line(line)}"
+
+  defp where_located(nil, name),
+    do:
+      "written only after `at` on a `var_global` line: declare a global at it, as in " <>
+        "`var_global point bool at #{name}`, and name that"
+
+  # A keyword names nothing in a configuration file, so no message advises declaring one.
+  defp keyworded(true, _state, name, kind),
+    do:
+      "no #{word(kind)} `#{name}`: `#{name}` is a keyword of a configuration file, and " <>
+        "nothing in one is named so"
+
+  defp keyworded(false, state, name, kind),
+    do: no(Declarations.suggest(name, names_of(state, kind), & &1, "names"), name, kind)
+
+  defp no(suggestion, name, kind) when suggestion != "",
+    do: "no #{word(kind)} `#{name}`#{suggestion}"
+
+  defp no("", name, :global),
+    do: "no global `#{name}`: declare it, as in `var_global #{name} bool`"
+
+  defp no("", name, :task),
+    do:
+      "no task `#{name}`: declare it with a `task` line, as in " <>
+        "`task #{name} interval 10 priority 1`"
+
+  defp no("", name, :instance),
+    do: "no instance `#{name}`: declare it, as in `program #{name} motor`"
+
+  defp names_of(state, kind), do: for({name, {^kind, _}} <- state.names, do: name)
+
+  # Connections, in line order: the member's section gives the direction.
+  defp connected({:connection, line, connection}, state) do
+    path = connection.instance <> "." <> connection.member
+    begun(Map.has_key?(state.names, connection.instance), location(path), state, line, connection)
+  end
+
+  # A line that begins with a location, `panel.q.0 m1.motor`, reads it as an instance's
+  # member; when no instance has that name, the message names the location reading (§4.7).
+  defp begun(false, {kind, _key}, state, line, connection) when kind in [:ok, :respell],
+    do:
+      problem(
+        state,
+        line,
+        "`#{connection.instance}.#{connection.member}` is a location, written only after " <>
+          "`at` on a `var_global` line: a connection begins with an instance's var_input or " <>
+          "var_output, as in `m1.start`"
+      )
+
+  defp begun(_declared, _location, state, line, connection),
+    do: on_instance(resolve(state, connection.instance, :instance, line), state, line, connection)
+
+  defp on_instance({:ok, %{program: nil}}, state, _line, _connection), do: state
+
+  defp on_instance({:ok, instance}, state, line, connection),
+    do: member(String.contains?(connection.member, "."), instance, state, line, connection)
+
+  defp on_instance({:error, message}, state, line, _connection), do: problem(state, line, message)
+  defp on_instance(:skip, state, _line, _connection), do: state
+
+  defp member(true, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` goes too deep: a connection names an " <>
+          "instance's var_input or var_output, as in `#{instance.name}.start`"
+      )
+
+  defp member(false, instance, state, line, connection),
+    do:
+      sectioned(
+        Map.get(instance.program.tags, connection.member),
+        instance,
+        state,
+        line,
+        connection
+      )
+
+  defp sectioned(nil, instance, state, line, connection) do
+    names =
+      for {name, %Tag{section: s}} <- instance.program.tags,
+          s in [:var_input, :var_output],
+          do: name
+
+    problem(
+      state,
+      line,
+      "`#{instance.name}` is a `#{instance.type}`, which declares no `#{connection.member}`" <>
+        Declarations.suggest(connection.member, names, & &1, "members")
+    )
+  end
+
+  defp sectioned(%Tag{section: :var} = _tag, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` is internal to `#{instance.type}` (declared " <>
+          "`var`): only a var_input or var_output connects"
+      )
+
+  defp sectioned(%Tag{section: :var_external}, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` is a var_external of `#{instance.type}`, " <>
+          "which reaches the global `#{connection.member}` itself: only a var_input or " <>
+          "var_output connects"
+      )
+
+  defp sectioned(%Tag{section: :var_input} = tag, instance, state, line, connection) do
+    key = {instance.name, connection.member}
+    sourced(Map.get(state.inputs, key), tag, instance, state, line, connection)
+  end
+
+  defp sectioned(%Tag{section: :var_output} = tag, instance, state, line, connection),
+    do: sink(connection.to, tag, instance, state, line, connection)
+
+  # A var_input: one source, a global or a constant, of its type (decision 7).
+  defp sourced(nil, tag, instance, state, line, connection) do
+    key = {instance.name, connection.member}
+    state = %{state | inputs: Map.put(state.inputs, key, {connection.to, line})}
+    source(connection.to, tag, instance, state, line, connection)
+  end
+
+  # The var_input's first connection was a broken line, reported there: this one is not
+  # reported as a second source, but its own source is still checked.
+  defp sourced({:broken, _first}, tag, instance, state, line, connection),
+    do: source(connection.to, tag, instance, state, line, connection)
+
+  defp sourced({to, first}, _tag, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` is already connected, to `#{shown(to)}`" <>
+          "#{at_line(first)}: a var_input has one source"
+      )
+
+  defp source({:constant, value}, tag, instance, state, line, connection) do
+    path = "#{instance.name}.#{connection.member}"
+    state = record(state, instance, connection, :input, line)
+    constant_fits(Declarations.fits?(tag.type, value), tag.type, path, value, state, line)
+  end
+
+  defp source({:global, name}, tag, instance, state, line, connection) do
+    found = resolve(state, name, :global, line)
+    read_global(found, tag, instance, used(state, found), line, connection)
+  end
+
+  defp read_global({:ok, global}, tag, instance, state, line, connection) do
+    state = record(state, instance, connection, :input, line)
+    agree(global.type == tag.type, global, tag, instance, state, line, connection)
+  end
+
+  defp read_global({:error, message}, _tag, _instance, state, line, _connection),
+    do: problem(state, line, message)
+
+  defp read_global(:skip, _tag, _instance, state, _line, _connection), do: state
+
+  defp constant_fits(true, _type, _path, _value, state, _line), do: state
+
+  defp constant_fits(false, :bool, path, value, state, line),
+    do: problem(state, line, "`#{path}` is a bool: only 0 or 1 fit, found `#{value}`")
+
+  defp constant_fits(false, :dint, path, value, state, line),
+    do: problem(state, line, "`#{path}` is a dint: `#{value}` does not fit in 32 bits")
+
+  defp agree(true, _global, _tag, _instance, state, _line, _connection), do: state
+
+  defp agree(false, global, tag, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` is a #{tag.type}, but `#{global.name}` is a " <>
+          "#{global.type}#{at_line(global.line)}"
+      )
+
+  # A var_output drives globals, one line a sink, and a sink has one driver.
+  defp sink({:constant, value}, _tag, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{instance.name}.#{connection.member}` is a var_output, which drives a global: it " <>
+          "cannot drive the constant `#{value}`"
+      )
+
+  defp sink({:global, name}, tag, instance, state, line, connection) do
+    found = resolve(state, name, :global, line)
+    drive(found, tag, instance, used(state, found), line, connection)
+  end
+
+  defp drive({:ok, %{location: {_d, :i, _a}} = global}, _tag, instance, state, line, connection),
+    do:
+      problem(
+        state,
+        line,
+        "`#{global.name}` is an input point#{at_line(global.line)}: " <>
+          "`#{instance.name}.#{connection.member}`, a var_output, cannot drive it"
+      )
+
+  defp drive({:ok, %{type: type} = global}, %Tag{type: type}, instance, state, line, connection),
+    do: driver(Map.get(state.drivers, global.name), global, instance, state, line, connection)
+
+  defp drive({:ok, global}, tag, instance, state, line, connection),
+    do: agree(false, global, tag, instance, state, line, connection)
+
+  defp drive({:error, message}, _tag, _instance, state, line, _connection),
+    do: problem(state, line, message)
+
+  defp drive(:skip, _tag, _instance, state, _line, _connection), do: state
+
+  defp driver(nil, global, instance, state, line, connection) do
+    path = "#{instance.name}.#{connection.member}"
+    state = %{state | drivers: Map.put(state.drivers, global.name, {path, line})}
+    record(state, instance, connection, :output, line)
+  end
+
+  defp driver({path, first}, global, _instance, state, line, _connection),
+    do: problem(state, line, "`#{global.name}` is already driven by `#{path}`#{at_line(first)}")
+
+  defp record(state, instance, connection, direction, line) do
+    entry = %{
+      instance: instance.name,
+      member: connection.member,
+      direction: direction,
+      to: connection.to,
+      line: line
+    }
+
+    %{state | connections: [entry | state.connections]}
+  end
+
+  defp used(state, {:ok, global}), do: %{state | uses: MapSet.put(state.uses, global.name)}
+  defp used(state, _found), do: state
+
+  defp shown({:global, name}), do: name
+  defp shown({:constant, value}), do: "#{value}"
+
+  # Decision 7: every var_input of an instance is connected, cited at its `program` line.
+  defp unconnected(%{program: nil}, state), do: state
+
+  defp unconnected(instance, state) do
+    missing =
+      for {name, %Tag{section: :var_input} = tag} <- instance.program.tags,
+          not Map.has_key?(state.inputs, {instance.name, name}),
+          do: tag
+
+    missing
+    |> Enum.sort_by(&{&1.line || 0, &1.name})
+    |> Enum.map(& &1.name)
+    |> unconnected_message(instance)
+    |> then(&leave(&1, state, instance.line))
+  end
+
+  defp unconnected_message([], _instance), do: nil
+
+  defp unconnected_message([one], instance),
+    do:
+      "`#{instance.name}` leaves its var_input `#{one}` unconnected: connect it to a global, " <>
+        "a point or a constant, as in `#{instance.name}.#{one} 0`"
+
+  defp unconnected_message([first | _] = names, instance),
+    do:
+      "`#{instance.name}` leaves its var_inputs #{listed(names)} unconnected: connect each to " <>
+        "a global, a point or a constant, as in `#{instance.name}.#{first} 0`"
+
+  defp leave(nil, state, _line), do: state
+  defp leave(message, state, line), do: problem(state, line, message)
+
+  # M2-4: each type's var_externals bind to globals by name (Ed 2 §2.4.3), checked once per
+  # type, at the `program` line of its first instance.
+  defp externals(state) do
+    state.instances
+    |> Enum.reverse()
+    |> Enum.reject(&is_nil(&1.program))
+    |> Enum.uniq_by(& &1.type)
+    |> Enum.reduce(state, &bound/2)
+  end
+
+  defp bound(instance, state) do
+    writes = written_by(state, instance)
+
+    instance.program.tags
+    |> Map.values()
+    |> Enum.filter(&(&1.section == :var_external))
+    |> Enum.sort_by(&{&1.line || 0, &1.name})
+    |> Enum.reduce(state, &binding(&1, &2, instance, writes))
+  end
+
+  defp binding(tag, state, instance, writes) do
+    found = external(Map.get(state.names, tag.name), state, tag.name, instance.line)
+    bind(found, tag, used(state, found), instance, Map.get(writes, tag.name))
+  end
+
+  defp external(nil, _state, _name, _line), do: :absent
+  defp external(_declared, state, name, line), do: resolve(state, name, :global, line)
+
+  defp bind({:ok, %{type: type} = global}, %Tag{type: type}, state, instance, written),
+    do: written_point(global.location, global, state, instance, written)
+
+  defp bind({:ok, global}, tag, state, instance, _written),
+    do:
+      problem(
+        state,
+        instance.line,
+        "#{declares(state, instance, tag)}, but `#{global.name}` is a #{global.type}#{at_line(global.line)}"
+      )
+
+  defp bind(:absent, tag, state, instance, _written),
+    do: problem(state, instance.line, no_global(state, instance, tag))
+
+  defp bind({:error, message}, tag, state, instance, _written) do
+    problem(state, instance.line, "#{declares(state, instance, tag)}, but " <> message)
+  end
+
+  defp bind(:skip, _tag, state, _instance, _written), do: state
+
+  defp no_global(state, instance, tag),
+    do:
+      "#{declares(state, instance, tag)}, but this configuration declares no `var_global #{tag.name}`" <>
+        Declarations.suggest(tag.name, names_of(state, :global), & &1, "names")
+
+  defp written_point({_device, :i, _address}, global, state, instance, line)
+       when is_integer(line),
+       do:
+         problem(
+           state,
+           instance.line,
+           "`#{instance.type}` writes its `var_external #{global.name}`" <>
+             "#{its(state, instance.type, line)}, but " <>
+             "`#{global.name}` is an input point#{at_line(global.line)}: nothing drives an input point"
+         )
+
+  defp written_point(_location, _global, state, _instance, _line), do: state
+
+  defp declares(state, instance, tag),
+    do:
+      "`#{instance.type}` declares `var_external #{tag.name} #{tag.type}`" <>
+        its(state, instance.type, tag.line)
+
+  # Where a type's line is: its own file, when the loader read it from one (the
+  # configuration's diagnostic is in the configuration's file, so the type's file is named
+  # in the message), or just its line.
+  defp its(state, type, line), do: in_type_file(Map.get(state.files, type), line)
+
+  defp in_type_file(_file, nil), do: ""
+  defp in_type_file(nil, line), do: " on its line #{line}"
+  defp in_type_file(file, line), do: " on line #{line} of #{file}"
+
+  # IEC requires one program at least (Ed 2 Annex B.1.7; Ed 3 Annex A). A broken `program`
+  # line counts, as it was reported already.
+  defp any_program(state), do: programs_declared(names_of(state, :instance), state)
+
+  defp programs_declared([], state),
+    do: problem(state, nil, "this configuration declares no `program`: it would run nothing")
+
+  defp programs_declared(_instances, state), do: state
+
+  # Warnings, in the configuration's warnings: nothing here stops a compile.
+  defp warned(state) do
+    state
+    |> unused_globals()
+    |> undriven_points()
+    |> idle_tasks()
+    |> writers()
+    |> event_timers()
+  end
+
+  defp unused_globals(state) do
+    state
+    |> sorted_globals()
+    |> Enum.reject(&MapSet.member?(state.uses, &1.name))
+    |> Enum.reduce(state, &warning(&2, &1.line, "`#{&1.name}` is declared but nothing uses it"))
+  end
+
+  defp undriven_points(state) do
+    written = external_writers(state)
+
+    state
+    |> sorted_globals()
+    |> Enum.filter(&match?({_d, :q, _a}, &1.location))
+    |> Enum.filter(&MapSet.member?(state.uses, &1.name))
+    |> Enum.reject(&(Map.has_key?(state.drivers, &1.name) or Map.has_key?(written, &1.name)))
+    |> Enum.reduce(
+      state,
+      &warning(
+        &2,
+        &1.line,
+        "`#{&1.name}` is an output point, but nothing drives it: it stays at 0"
+      )
+    )
+  end
+
+  defp idle_tasks(state) do
+    running = MapSet.new(state.instances, & &1.task)
+
+    state.tasks
+    |> Enum.reverse()
+    |> Enum.reject(&MapSet.member?(running, &1.name))
+    |> Enum.reduce(state, &warning(&2, &1.line, "task `#{&1.name}` runs no instance"))
+  end
+
+  # M2-4: two writers of one global through `var_external`, or one and a connection, are
+  # a warning (§4.4, "One driver per sink"): the later write in a cycle wins.
+  defp writers(state) do
+    state
+    |> external_writers()
+    |> Enum.sort()
+    |> Enum.reduce(state, &written_twice/2)
+  end
+
+  defp external_writers(state) do
+    for instance <- Enum.reverse(state.instances),
+        instance.program != nil,
+        {name, _line} <- written_by(state, instance),
+        match?(%Tag{section: :var_external}, Map.get(instance.program.tags, name)),
+        Map.has_key?(state.globals, name),
+        reduce: %{} do
+      found -> Map.update(found, name, [instance], &[instance | &1])
+    end
+    |> Map.new(fn {name, writers} -> {name, Enum.reverse(writers)} end)
+  end
+
+  defp written_twice({global, [first | later]}, state) do
+    state = Enum.reduce(later, state, &second_writer(&1, &2, first, global))
+    driven_too(Map.get(state.drivers, global), [first | later], state, global)
+  end
+
+  defp second_writer(instance, state, first, global),
+    do:
+      warning(
+        state,
+        instance.line,
+        "`#{instance.name}` writes `#{global}` through its `var_external`, as `#{first.name}` " <>
+          "does#{at_line(first.line)}: the later of the two in a cycle wins"
+      )
+
+  defp driven_too(nil, _writers, state, _global), do: state
+
+  defp driven_too({path, line}, writers, state, global),
+    do:
+      Enum.reduce(writers, state, fn instance, state ->
+        warning(
+          state,
+          instance.line,
+          "`#{instance.name}` writes `#{global}` through its `var_external`, and `#{path}` " <>
+            "drives it#{at_line(line)}: the later of the two in a cycle wins"
+        )
+      end)
+
+  # M2-6 (§4.6, "Caveats"): a `ton` in a program an event task runs times across events. A
+  # task with `single` and `interval` is an event task too: its periods stop while its
+  # trigger stays 1 (IEC's rule 2), and a timing `ton` counts that time as well.
+  defp event_timers(state) do
+    events =
+      for %{single: s, name: name} = task <- state.tasks, s != nil, into: %{}, do: {name, task}
+
+    state.instances
+    |> Enum.reverse()
+    |> Enum.filter(&(&1.program != nil and Map.has_key?(events, &1.task)))
+    |> Enum.reduce(state, &event_timer(timers_of(&2, &1), &1, Map.fetch!(events, &1.task), &2))
+  end
+
+  defp event_timer([], _instance, _task, state), do: state
+
+  defp event_timer([{timer, line} | _], instance, task, state),
+    do:
+      warning(
+        state,
+        instance.line,
+        "`#{instance.name}` runs #{on_events(task)}, and `#{instance.type}` runs " <>
+          "`ton #{timer}`#{its(state, instance.type, line)}: a timer that is timing counts " <>
+          "#{between(task)} too"
+      )
+
+  defp on_events(%{interval: nil, name: name}), do: "only on the events of `#{name}`"
+
+  defp on_events(%{name: name, single: single}),
+    do: "on the events of `#{name}`, and on its interval only while `#{single}` is 0"
+
+  defp between(%{interval: nil}), do: "the time between events"
+  defp between(%{single: single}), do: "the time `#{single}` holds its interval off"
+
+  # What a program writes, and the timers it runs: each tag by its first line. A spike's
+  # walk, like Logex.Warnings' and Logex.Edit's; `PLAN.md` B5's one walk would serve all.
+  defp writes(program) do
+    signatures = Map.new(Map.values(Logex.Compiler.instructions()))
+
+    for {symbol, line, operands} <- instructions(program),
+        {{:write, _type}, {:name, _, name}} <- Enum.zip(Map.get(signatures, symbol, []), operands),
+        reduce: %{} do
+      found -> Map.put_new(found, name, line)
+    end
+  end
+
+  defp timers(program),
+    do: for({:ton, line, [{:name, _, timer} | _]} <- instructions(program), do: {timer, line})
+
+  defp instructions(%Program{rungs: rungs}) do
+    rungs
+    |> Enum.reduce([], fn {:rung, elements}, gathered -> gather(elements, gathered) end)
+    |> Enum.reverse()
+  end
+
+  defp gather(elements, gathered), do: Enum.reduce(elements, gathered, &gathered/2)
+  defp gathered({:branches, legs}, gathered), do: Enum.reduce(legs, gathered, &gather/2)
+  defp gathered(instruction, gathered), do: [instruction | gathered]
+
+  defp listed([one]), do: "`#{one}`"
+  defp listed([a, b]), do: "`#{a}` and `#{b}`"
+
+  defp listed(names) do
+    {init, [last]} = Enum.split(names, -1)
+    Enum.map_join(init, ", ", &"`#{&1}`") <> " and `#{last}`"
+  end
+end
diff --git a/lib/logex/configuration/text.ex b/lib/logex/configuration/text.ex
new file mode 100644
index 0000000..d79d209
--- /dev/null
+++ b/lib/logex/configuration/text.ex
@@ -0,0 +1,671 @@
+defmodule Logex.Configuration.Text do
+  @moduledoc """
+  A configuration file's text, read into plain data (M2-2, M2-3, M2-6;
+  `docs/organisation.md` §4.4). By hand, like `Logex.Parser`: `Logex.Lexer`'s tokens, one
+  line at a time, by recursive descent.
+
+      file        -> line*                      the lexer drops blank lines and comments
+      line        -> task | global | program | connection
+      task        -> 'task' NAME ['single' NAME] ['interval' INT] 'priority' INT
+      global      -> 'var_global' NAME TYPE [INT] ['at' NAME]
+      program     -> 'program' NAME NAME ['with' NAME]
+      connection  -> PATH (NAME | INT)          PATH: a name with `.` parts, as `m1.start`
+      TYPE        -> 'bool' | 'dint'
+
+  `line/1` reads `line` by its first token; `task/3`, `inputs/3` and `value/5` read
+  `task`; `global/3`, `typed/4`, `initial/3` and `located/4` read `global`; `program/3`,
+  `typed_program/4` and `scheduled/4` read `program`; and `connection/4` reads
+  `connection`. Every decision is made on the next token alone.
+
+  Everything the lexer settles is reused whole: positions, `//` comments, a run of
+  newlines as one line end, a lone CR as a newline (B8), and the `.` rule that makes
+  `m1.start` and `panel.q.0` one name token. `Logex.Parser` is not used: a configuration
+  has no rungs and no branch groups, so `(`, `|` and `)` are refused here, and the `.ld`
+  grammar, `test/fixtures/frontend_golden.txt` and `printer_test.exs`'s `@required_shapes`
+  do not change.
+
+  **What it reads into.** A list of entries in line order, each `{kind, line, fields}`,
+  the shape of the parse AST's leaves:
+
+      {:task, line, %{name:, single: nil | global, interval: nil | ms, priority: nil | p}}
+      {:global, line, %{name:, type: :bool | :dint, initial: nil | n, at: nil | location}}
+      {:program, line, %{name:, type:, task: nil | task}}
+      {:connection, line, %{instance:, member:, to: {:global, name} | {:constant, n}}}
+
+  This is the grammar only, and a mistake in it is located at its token, with a column.
+  What the words mean (a keyword used as a name, a priority given, an interval of at
+  least 1, a name that is declared) is checked once, by the constructor the text and the
+  Elixir data path share (`Logex.Configuration.check/3`), so a task with no priority reads
+  as `priority: nil` and is refused there, as it would be from Elixir.
+
+  **Keywords**, in any case, are reserved in a configuration file only
+  (`docs/organisation.md` §4.8, decision 10): `keywords/0`.
+  """
+
+  alias Logex.{Declarations, Diagnostic}
+
+  # Each word a configuration file reserves, and the line it belongs on.
+  @keywords %{
+    "task" => :line,
+    "var_global" => :line,
+    "program" => :line,
+    "single" => :task,
+    "interval" => :task,
+    "priority" => :task,
+    "with" => :program,
+    "at" => :global,
+    "bool" => :type,
+    "dint" => :type
+  }
+
+  @types %{"bool" => :bool, "dint" => :dint}
+
+  # A task's inputs, in IEC's order (Ed 2 Annex B.1.7, `task_initialization`).
+  @inputs %{"single" => 0, "interval" => 1, "priority" => 2}
+
+  @doc "The words a configuration file reserves, lowercase. Each is reserved in any case."
+  def keywords, do: Map.keys(@keywords)
+
+  @doc "Whether `word` is a configuration file's keyword, in any case."
+  def keyword?(word) when is_binary(word), do: Map.has_key?(@keywords, String.downcase(word))
+
+  def keyword?(word),
+    do:
+      raise(
+        ArgumentError,
+        "Logex.Configuration.Text.keyword?/1 takes a word as a string, got: #{inspect(word)}"
+      )
+
+  @doc """
+  Reads a configuration's source: `{:ok, entries}`, or `{:error, diagnostics, entries}`
+  with one diagnostic for each line that could not be read, at its token and column, in
+  line order. A lex error stops the read and is the only diagnostic.
+
+  The entries of an error are the lines that could be read and, for each broken line
+  whose name could be, `{:declared, line, %{kind: kind, name: name}}`, or for a broken
+  connection `{:declared, line, %{kind: :connection, instance: i, member: m}}`, so a
+  caller can check the rest without reporting that name as undeclared or that var_input
+  as unconnected: one mistake, one message.
+  """
+  def read(source) when is_binary(source), do: lexed(Logex.Lexer.tokenize(source))
+
+  def read(source),
+    do:
+      raise(
+        ArgumentError,
+        "Logex.Configuration.Text.read/1 takes source text as a binary, got: #{inspect(source)}"
+      )
+
+  defp lexed({:ok, tokens, _end_line}), do: lines(split(tokens, [], []), [], [])
+
+  defp lexed({:error, {location, module, reason}, _line}),
+    do: {:error, [problem(:lex, location, module.format_error(reason))], []}
+
+  defp lines([], entries, []), do: {:ok, Enum.reverse(entries)}
+  defp lines([], entries, problems), do: {:error, Enum.reverse(problems), Enum.reverse(entries)}
+
+  defp lines([tokens | rest], entries, problems),
+    do: lines(rest, entries, problems, grouped(Enum.find(tokens, &delimiter?/1), tokens))
+
+  defp lines(rest, entries, problems, {:ok, entry}), do: lines(rest, [entry | entries], problems)
+
+  defp lines(rest, entries, problems, {:error, problem, declared}),
+    do: lines(rest, Enum.reverse(declared, entries), [problem | problems])
+
+  # `(`, `|` and `)` delimit a program's branch groups, and a configuration has none.
+  defp delimiter?({kind, _location}) when kind in [:bst, :nxb, :bnd], do: true
+  defp delimiter?(_token), do: false
+
+  defp grouped(nil, tokens), do: line(tokens)
+
+  defp grouped(delimiter, _tokens),
+    do: {:error, fail(delimiter, "a configuration line cannot hold `#{symbol(delimiter)}`"), []}
+
+  # A line is read by its first word, never empty, since the lexer coalesces newlines.
+  defp line([{:name, _, word} = first | rest]),
+    do: keyed(Map.get(@keywords, String.downcase(word)), String.downcase(word), first, rest)
+
+  defp line([{:int_lit, _, value} = first | _]),
+    do: {:error, fail(first, unknown("#{value}")), []}
+
+  defp keyed(:line, "task", first, rest), do: task(rest, first, line_of(first))
+  defp keyed(:line, "var_global", first, rest), do: global(rest, first, line_of(first))
+  defp keyed(:line, "program", first, rest), do: program(rest, first, line_of(first))
+  defp keyed(nil, _key, {:name, _, word} = first, rest), do: unkeyed(word, first, rest)
+
+  defp keyed(where, _key, {:name, _, word} = first, _rest),
+    do: {:error, fail(first, placed(word, where)), []}
+
+  defp unkeyed(word, first, rest), do: dotted(String.contains?(word, "."), word, first, rest)
+
+  defp dotted(true, path, first, rest), do: connection(rest, path, first, line_of(first))
+  defp dotted(false, word, first, _rest), do: {:error, fail(first, unknown(word)), []}
+
+  defp unknown(word),
+    do: suggested(Declarations.suggest(word, ["task", "var_global", "program"]), word)
+
+  defp suggested("", word),
+    do:
+      "unknown configuration line `#{word}`: a line starts with `task`, `var_global` or " <>
+        "`program`, or is a connection, as in `m1.start pb_start_1`"
+
+  defp suggested(suggestion, word), do: "unknown configuration line `#{word}`" <> suggestion
+
+  defp placed(word, :task),
+    do:
+      "a line cannot start with `#{word}`: it goes on a `task` line, " <>
+        "as in `task fast interval 10 priority 1`"
+
+  defp placed(word, :program),
+    do:
+      "a line cannot start with `#{word}`: it goes on a `program` line, " <>
+        "as in `program m1 motor with fast`"
+
+  defp placed(word, _global_or_type),
+    do:
+      "a line cannot start with `#{word}`: it goes on a `var_global` line, " <>
+        "as in `var_global k1 bool at panel.q.0`"
+
+  # task -> 'task' NAME ['single' NAME] ['interval' INT] 'priority' INT
+  defp task([], first, _line),
+    do: {:error, fail(first, "`task` needs a name, as in `task fast interval 10 priority 1`"), []}
+
+  defp task([{:int_lit, _, value} = token | _], _first, _line),
+    do: {:error, fail(token, "expected a task's name after `task`, found `#{value}`"), []}
+
+  defp task([{:name, _, word} = token | rest], _first, line),
+    do: named_task(Map.has_key?(@inputs, String.downcase(word)), word, token, rest, line)
+
+  defp named_task(true, word, token, _rest, _line),
+    do:
+      {:error,
+       fail(token, "`task` needs a name before `#{word}`, " <> example(String.downcase(word))),
+       []}
+
+  defp named_task(false, name, _token, rest, line),
+    do: inputs(rest, %{name: name, single: nil, interval: nil, priority: nil}, line)
+
+  defp inputs([], task, line), do: {:ok, {:task, line, task}}
+
+  defp inputs([{:name, _, word} = token | rest], task, line),
+    do: input(Map.fetch(@inputs, String.downcase(word)), token, rest, task, line)
+
+  defp inputs([token | _], task, line),
+    do: {:error, fail(token, unexpected_on_task(token, task)), declared(:task, line, task)}
+
+  defp input(:error, token, _rest, task, line),
+    do: {:error, fail(token, unexpected_on_task(token, task)), declared(:task, line, task)}
+
+  defp input({:ok, rank}, {:name, _, word} = token, rest, task, line) do
+    key = String.downcase(word)
+    ordered(order(key, rank, task), key, token, rest, task, line)
+  end
+
+  defp ordered(:ok, key, token, rest, task, line), do: value(key, rest, token, task, line)
+
+  defp ordered(message, _key, token, _rest, task, line),
+    do: {:error, fail(token, message), declared(:task, line, task)}
+
+  # A task's inputs come once each, in IEC's order: `single`, `interval`, `priority`.
+  defp order(key, rank, task),
+    do: once(Map.fetch!(task, field(key)), key, rank, task)
+
+  defp once(nil, key, rank, task),
+    do: before(Enum.find(["interval", "priority"], &later?(&1, rank, task)), key)
+
+  defp once(_given, key, _rank, task),
+    do: "`#{key}` is given twice on the line of task `#{task.name}`"
+
+  defp later?(other, rank, task),
+    do: Map.fetch!(@inputs, other) > rank and Map.fetch!(task, field(other)) != nil
+
+  defp before(nil, _key), do: :ok
+  defp before(later, key), do: "`#{key}` goes before `#{later}`, " <> example(key)
+
+  defp value("single", [{:name, _, global} = source | rest], token, task, line),
+    do: trigger(Map.has_key?(@inputs, String.downcase(global)), source, token, rest, task, line)
+
+  defp value(key, [{:int_lit, _, number} | rest], _token, task, line) when key != "single",
+    do: inputs(rest, Map.put(task, field(key), number), line)
+
+  defp value(key, rest, token, task, line),
+    do:
+      {:error, fail(at_found(rest, token), takes(key) <> found(rest)),
+       declared(:task, line, task)}
+
+  defp trigger(false, {:name, _, global}, _token, rest, task, line),
+    do: inputs(rest, Map.put(task, :single, global), line)
+
+  # `single interval 10`: the word after `single` is the next input, not its global.
+  defp trigger(true, source, _token, _rest, task, line),
+    do: {:error, fail(source, takes("single") <> found([source])), declared(:task, line, task)}
+
+  defp takes("single"), do: "`single` needs a bool global, as in `single estop`"
+  defp takes("interval"), do: "`interval` takes a number of milliseconds, as in `interval 10`"
+  defp takes("priority"), do: "`priority` takes a number, 0 the highest, as in `priority 1`"
+
+  defp field("single"), do: :single
+  defp field("interval"), do: :interval
+  defp field("priority"), do: :priority
+
+  defp unexpected_on_task(token, task),
+    do:
+      "unexpected #{describe(token)} on the line of task `#{task.name}`: a task takes " <>
+        "`single`, `interval` and `priority`"
+
+  defp example("single"), do: "as in `task trip single estop priority 0`"
+  defp example(_key), do: "as in `task fast interval 10 priority 1`"
+
+  # global -> 'var_global' NAME TYPE [INT] ['at' NAME]
+  defp global([], first, _line),
+    do:
+      {:error, fail(first, "`var_global` needs a name and a type, as in `var_global estop bool`"),
+       []}
+
+  defp global([{:int_lit, _, value} = token | _], _first, _line),
+    do: {:error, fail(token, "expected a global's name after `var_global`, found `#{value}`"), []}
+
+  defp global([{:name, _, word} = token | rest], first, line),
+    do: named_global(Map.get(@keywords, String.downcase(word)), word, token, rest, first, line)
+
+  defp named_global(kind, word, token, _rest, _first, _line) when kind in [:type, :global],
+    do:
+      {:error,
+       fail(token, "`var_global` needs a name before `#{word}`, as in `var_global estop bool`"),
+       []}
+
+  defp named_global(_kind, name, _token, rest, first, line),
+    do: typed(rest, %{name: name, type: nil, initial: nil, at: nil}, line, first)
+
+  defp typed([], global, line, first),
+    do:
+      {:error,
+       fail(
+         first,
+         "`#{global.name}` needs a type: `var_global #{global.name} bool` or " <>
+           "`var_global #{global.name} dint`"
+       ), declared(:global, line, global)}
+
+  defp typed([{:int_lit, _, value} = token | _], global, line, _first),
+    do:
+      {:error, fail(token, "`#{global.name}` needs a type before its initial value `#{value}`"),
+       declared(:global, line, global)}
+
+  defp typed([{:name, _, word} = token | rest], global, line, _first),
+    do: type_word(String.downcase(word), word, token, rest, global, line)
+
+  defp type_word("at", _word, token, _rest, global, line),
+    do:
+      {:error,
+       fail(
+         token,
+         "`#{global.name}` needs a type before `at`, as in " <>
+           "`var_global #{global.name} bool at panel.q.0`"
+       ), declared(:global, line, global)}
+
+  defp type_word(key, _word, _token, rest, global, line) when is_map_key(@types, key),
+    do: initial(rest, %{global | type: Map.fetch!(@types, key)}, line)
+
+  defp type_word(_key, word, token, _rest, global, line),
+    do:
+      {:error, fail(token, unknown_type(Logex.FbType.builtin(word), word, global.name)),
+       declared(:global, line, global)}
+
+  defp unknown_type(%Logex.FbType{name: type}, _word, name),
+    do:
+      "`#{name}` cannot be a `#{type}`: a global is a `bool` or a `dint`, and a #{type} " <>
+        "is declared inside a program, as in `var #{name} #{type}`"
+
+  defp unknown_type(nil, word, _name),
+    do:
+      "unknown type `#{word}`: a global is a `bool` or a `dint`" <>
+        Declarations.suggest(word, ["bool", "dint"], & &1, "types")
+
+  defp initial([{:int_lit, _, value} | rest], global, line),
+    do: located(rest, %{global | initial: value}, line, nil)
+
+  defp initial(rest, global, line), do: located(rest, global, line, nil)
+
+  defp located([], global, line, _at), do: {:ok, {:global, line, global}}
+
+  defp located([{:name, _, word} = token | rest], global, line, nil),
+    do: at(String.downcase(word), token, rest, global, line)
+
+  defp located([extra | _], global, line, _at),
+    do: {:error, fail(extra, after_global(extra, global)), declared(:global, line, global)}
+
+  defp at("at", _token, [{:name, _, location} | rest], global, line),
+    do: located(rest, %{global | at: location}, line, location)
+
+  defp at("at", token, rest, global, line),
+    do:
+      {:error,
+       fail(at_found(rest, token), "`at` needs a location, as in `at panel.i.0`" <> found(rest)),
+       declared(:global, line, global)}
+
+  defp at(_word, token, _rest, global, line),
+    do: {:error, fail(token, after_global(token, global)), declared(:global, line, global)}
+
+  defp after_global(token, global),
+    do: "unexpected #{describe(token)} after the declaration of `#{global.name}`"
+
+  # program -> 'program' NAME NAME ['with' NAME]
+  defp program([], first, _line),
+    do:
+      {:error,
+       fail(
+         first,
+         "`program` needs an instance name and a program type, as in `program m1 motor`"
+       ), []}
+
+  defp program([{:int_lit, _, value} = token | _], _first, _line),
+    do: {:error, fail(token, "expected an instance name after `program`, found `#{value}`"), []}
+
+  defp program([{:name, _, name} | rest], first, line), do: typed_program(rest, name, line, first)
+
+  defp typed_program([], name, line, first),
+    do:
+      {:error,
+       fail(first, "`program #{name}` needs a program type, as in `program #{name} motor`"),
+       declared(:instance, line, %{name: name})}
+
+  defp typed_program([{:int_lit, _, value} = token | _], name, line, _first),
+    do:
+      {:error, fail(token, "expected a program type after `program #{name}`, found `#{value}`"),
+       declared(:instance, line, %{name: name})}
+
+  defp typed_program([{:name, _, type} = token | rest], name, line, _first),
+    do: program_type(String.downcase(type), type, token, rest, name, line)
+
+  defp program_type("with", _type, token, _rest, name, line),
+    do:
+      {:error,
+       fail(
+         token,
+         "`program #{name}` needs a program type before `with`, " <>
+           "as in `program #{name} motor with fast`"
+       ), declared(:instance, line, %{name: name})}
+
+  defp program_type(_key, type, _token, rest, name, line),
+    do: scheduled(rest, %{name: name, type: type, task: nil}, line, nil)
+
+  defp scheduled([], program, line, _with), do: {:ok, {:program, line, program}}
+
+  defp scheduled([{:name, _, word} = token | rest], program, line, nil),
+    do: with_task(String.downcase(word), token, rest, program, line)
+
+  defp scheduled([extra | _], program, line, _with),
+    do: {:error, fail(extra, after_program(extra, program)), declared(:instance, line, program)}
+
+  defp with_task("with", _token, [{:name, _, task} | rest], program, line),
+    do: scheduled(rest, %{program | task: task}, line, task)
+
+  defp with_task("with", token, rest, program, line),
+    do:
+      {:error,
+       fail(
+         at_found(rest, token),
+         "`with` needs a task, as in `program #{program.name} #{program.type} with fast`" <>
+           found(rest)
+       ), declared(:instance, line, program)}
+
+  defp with_task(_word, token, _rest, program, line),
+    do: {:error, fail(token, after_program(token, program)), declared(:instance, line, program)}
+
+  defp after_program(token, %{task: nil} = program),
+    do: "unexpected #{describe(token)} after `program #{program.name} #{program.type}`"
+
+  defp after_program(token, program),
+    do:
+      "unexpected #{describe(token)} after " <>
+        "`program #{program.name} #{program.type} with #{program.task}`"
+
+  # connection -> PATH (NAME | INT). The member's section gives the direction, which the
+  # constructor checks, so the line carries no arrow (decision 5).
+  defp connection(rest, path, first, line) do
+    [instance, member] = String.split(path, ".", parts: 2)
+    wire(rest, %{instance: instance, member: member}, line, first, path)
+  end
+
+  defp wire([{:name, _, global}], connection, line, _first, _path),
+    do: {:ok, {:connection, line, Map.put(connection, :to, {:global, global})}}
+
+  defp wire([{:int_lit, _, value}], connection, line, _first, _path),
+    do: {:ok, {:connection, line, Map.put(connection, :to, {:constant, value})}}
+
+  defp wire([], connection, line, first, path),
+    do:
+      {:error,
+       fail(
+         first,
+         "`#{path}` needs a global or a constant to connect, as in `#{path} pb_start_1`"
+       ), declared(:connection, line, connection)}
+
+  defp wire([to, extra | _], connection, line, _first, path),
+    do:
+      {:error, fail(extra, "unexpected #{describe(extra)} after `#{path} #{plain(to)}`"),
+       declared(:connection, line, connection)}
+
+  defp declared(:connection, line, connection),
+    do: [
+      {:declared, line,
+       %{kind: :connection, instance: connection.instance, member: connection.member}}
+    ]
+
+  defp declared(kind, line, %{name: name}), do: [{:declared, line, %{kind: kind, name: name}}]
+
+  # A word of the wrong kind is located at itself; a missing one at the word that wants it.
+  defp at_found([], token), do: token
+  defp at_found([found | _], _token), do: found
+
+  defp found([]), do: ""
+  defp found([token | _]), do: ", found #{describe(token)}"
+
+  defp describe({:name, _, word}), do: "`#{word}`"
+  defp describe({:int_lit, _, value}), do: "`#{value}`"
+
+  defp plain({:name, _, word}), do: word
+  defp plain({:int_lit, _, value}), do: "#{value}"
+
+  defp symbol({:bst, _}), do: "("
+  defp symbol({:nxb, _}), do: "|"
+  defp symbol({:bnd, _}), do: ")"
+
+  defp line_of({:name, {line, _}, _word}), do: line
+
