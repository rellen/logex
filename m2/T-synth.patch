+
+  defp case_of(4, d),
+    do: [
+      {:task, Enum.random([nil, 1, 0]),
+       %{name: junk(d), single: junk(d), interval: junk(d), priority: junk(d)}}
+    ]
+
+  defp case_of(5, d),
+    do: [
+      {:global, Enum.random([nil, 2]),
+       %{name: junk(d), type: Enum.random([:bool, :dint, junk(d)]), initial: junk(d), at: junk(d)}}
+    ]
+
+  defp case_of(6, d),
+    do: [{:program, nil, %{name: junk(d), type: Enum.random(["motor", junk(d)]), task: junk(d)}}]
+
+  defp case_of(7, d),
+    do: [
+      {:connection, nil,
+       %{
+         instance: Enum.random(["m1", junk(d)]),
+         member: junk(d),
+         to: Enum.random([{:global, junk(d)}, {:constant, junk(d)}, junk(d)])
+       }}
+    ]
+
+  defp case_of(8, d), do: %{junk(d) => junk(d)}
+
+  defp case_of(9, _d),
+    do:
+      Enum.random([
+        "program m1 motor\nm1.start 0",
+        "task t interval 1 priority 0\n(",
+        "x.y.z 1 2",
+        "\r\n\r",
+        "var_global a bool at p.i.0"
+      ])
+end
