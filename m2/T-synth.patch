+  defp fail({_kind, location}, message), do: problem(:configure, location, message)
+
+  defp problem(stage, {line, column}, message),
+    do: %Diagnostic{stage: stage, line: line, column: column, message: message}
+
+  @doc """
+  The canonical text of `entries`, one line each, in their order: lowercase keywords, one
+  space between words, no indentation and no comments. An entry with a line is printed on
+  that line, the lines between left empty; entries with no line, from Elixir, are printed
+  on lines 1, 2, 3 and on. `read/1` reads the text back as the same entries, each at the
+  line it was printed on, which is how the data path is held to what the text can say
+  (`docs/organisation.md` §4.9, "One model, held as data").
+
+  Entries no configuration line could say raise `ArgumentError`, as `entries!/1` does.
+  """
+  def print(entries) do
+    entries!(entries)
+    entries |> Enum.reduce({1, []}, &placed_line/2) |> elem(1) |> Enum.reverse() |> Enum.join()
+  end
+
+  defp placed_line({_kind, nil, _fields} = entry, {next, text}),
+    do: {next + 1, [printed(entry) <> "\n" | text]}
+
+  defp placed_line({_kind, line, _fields} = entry, {next, text}),
+    do: {line + 1, [String.duplicate("\n", line - next) <> printed(entry) <> "\n" | text]}
+
+  defp printed({:task, _line, task}),
+    do:
+      Enum.join(
+        ["task", task.name] ++
+          given("single", task.single) ++
+          given("interval", task.interval) ++ given("priority", task.priority),
+        " "
+      )
+
+  defp printed({:global, _line, global}),
+    do:
+      Enum.join(
+        ["var_global", global.name, Atom.to_string(global.type)] ++
+          given(nil, global.initial) ++ given("at", global.at),
+        " "
+      )
+
+  defp printed({:program, _line, program}),
+    do: Enum.join(["program", program.name, program.type] ++ given("with", program.task), " ")
+
+  defp printed({:connection, _line, connection}),
+    do: "#{connection.instance}.#{connection.member} #{to_text(connection.to)}"
+
+  defp given(_word, nil), do: []
+  defp given(nil, value), do: ["#{value}"]
+  defp given(word, value), do: [word, "#{value}"]
+
+  defp to_text({:global, name}), do: name
+  defp to_text({:constant, value}), do: "#{value}"
+
+  @doc """
+  Raises `ArgumentError` unless every one of `entries` is one a configuration line can say:
+  `{kind, line, fields}` of the four kinds `read/1` gives, with that kind's fields; every
+  name one name token to the lexer, and a connection's instance one with no `.`, its
+  `instance.member` again one; every number an integer of 0 or more; and the lines all
+  nil, for entries built in Elixir, or positive and rising from entry to entry, one entry
+  a line, as `read/1` gives them. The text's own definition of its data, as
+  `Logex.Parser.well_formed!/1` is a program's: `print/1` and
+  `Logex.Configuration.check/3` both check their entries with it.
+  """
+  def entries!(entries) when is_list(entries) do
+    Enum.each(entries, &entry!/1)
+    lines!(entries, Enum.map(entries, &elem(&1, 1)))
+  end
+
+  def entries!(entries),
+    do: raise(ArgumentError, "entries must be a list, got: #{inspect(entries)}")
+
+  defp entry!({kind, line, fields} = entry)
+       when is_map(fields) and (is_nil(line) or (is_integer(line) and line > 0)),
+       do: fields!(kind, fields, entry)
+
+  defp entry!(entry),
+    do: unsaid!("an entry is {kind, line, fields}, its line nil or positive", entry)
+
+  defp fields!(:task, %{name: n, single: s, interval: i, priority: p} = f, entry)
+       when map_size(f) == 4 do
+    name!(n, entry)
+    optional_name!(s, entry)
+    count!(i, entry)
+    count!(p, entry)
+  end
+
+  defp fields!(:global, %{name: n, type: t, initial: i, at: at} = f, entry)
+       when map_size(f) == 4 and t in [:bool, :dint] do
+    name!(n, entry)
+    count!(i, entry)
+    optional_name!(at, entry)
+  end
+
+  defp fields!(:program, %{name: n, type: t, task: task} = f, entry) when map_size(f) == 3 do
+    name!(n, entry)
+    name!(t, entry)
+    optional_name!(task, entry)
+  end
+
+  defp fields!(:connection, %{instance: i, member: m, to: to} = f, entry)
+       when map_size(f) == 3 do
+    path!(i, m, entry)
+    to!(to, entry)
+  end
+
+  defp fields!(_kind, _fields, entry),
+    do:
+      unsaid!(
+        "an entry is a :task, :global, :program or :connection with that kind's fields, " <>
+          "a global's type :bool or :dint",
+        entry
+      )
+
+  # A connection's first word is one name token, split at its first `.`: what `read/1`
+  # reads as instance and member is exactly what joins back into that token.
+  defp path!(instance, member, entry) when is_binary(instance) and is_binary(member) do
+    name!(instance, entry)
+    undotted!(String.contains?(instance, "."), entry)
+    name!(instance <> "." <> member, entry)
+  end
+
+  defp path!(_instance, _member, entry), do: unsaid!("a name lexes as one name token", entry)
+
+  defp undotted!(false, _entry), do: :ok
+
+  defp undotted!(true, entry),
+    do: unsaid!("a connection's instance has no `.`: its first `.` begins the member", entry)
+
+  defp to!({:global, name}, entry), do: name!(name, entry)
+  defp to!({:constant, value}, entry), do: count!(value, entry)
+
+  defp to!(_to, entry),
+    do: unsaid!("a connection is `to` {:global, name} or {:constant, n}", entry)
+
+  defp optional_name!(nil, _entry), do: :ok
+  defp optional_name!(name, entry), do: name!(name, entry)
+
+  # The lexer is the one rule for a name, as for a program's tree.
+  defp name!(word, entry) when is_binary(word),
+    do: one_name!(Logex.Lexer.tokenize(word), word, entry)
+
+  defp name!(_word, entry), do: unsaid!("a name lexes as one name token", entry)
+
+  defp one_name!({:ok, [{:name, _, word}], _}, word, _entry), do: :ok
+  defp one_name!(_lexed, _word, entry), do: unsaid!("a name lexes as one name token", entry)
+
+  defp count!(nil, _entry), do: :ok
+  defp count!(n, _entry) when is_integer(n) and n >= 0, do: :ok
+
+  defp count!(_n, entry),
+    do:
+      unsaid!(
+        "a number is an integer, 0 or more: a negative one does not lex yet (PLAN.md §5)",
+        entry
+      )
+
+  # Lines are where a file declares each entry: none from Elixir, or rising, one a line.
+  defp lines!(entries, lines), do: lined!(Enum.uniq(lines), entries, nil)
+
+  defp lined!([nil], _entries, _last), do: :ok
+  defp lined!(_unique, [], _last), do: :ok
+
+  defp lined!(unique, [{_kind, line, _fields} | rest], last)
+       when is_integer(line) and (last == nil or line > last),
+       do: lined!(unique, rest, line)
+
+  defp lined!(_unique, [entry | _rest], last),
+    do:
+      unsaid!(
+        "lines are nil for entries built in Elixir, or rise from entry to entry, one entry " <>
+          "a line#{after_line(last)}",
+        entry
+      )
+
+  defp after_line(nil), do: ", and no line is nil beside one that is not"
+  defp after_line(last), do: ", and this one comes after line #{last}"
+
+  defp unsaid!(rule, entry),
+    do:
+      raise(
+        ArgumentError,
+        "not an entry a configuration file can say: #{rule}, got: #{inspect(entry)}"
+      )
+
+  # Tokens to lines: a line is the tokens between two `rnd`s, and is never empty.
+  defp split([{:rnd, _} | rest], line, lines), do: split(rest, [], add(line, lines))
+  defp split([token | rest], line, lines), do: split(rest, [token | line], lines)
+  defp split([], line, lines), do: Enum.reverse(add(line, lines))
+
+  defp add([], lines), do: lines
+  defp add(line, lines), do: [Enum.reverse(line) | lines]
+end
