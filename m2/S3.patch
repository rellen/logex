+  # Step 3: the due tasks in the order they run, each task's state moved on, and the
+  # overlaps they report. Each tuple sorts by priority, then due time, then declaration.
+  defp due(%__MODULE__{plan: %{tasks: periodic}, tasks: tasks}, now) do
+    due =
+      for {name, priority, interval, index, members} <- periodic,
+          %{next_due: next} <- [Map.fetch!(tasks, name)],
+          next <= now,
+          do: {priority, next, index, name, interval, members}
+
+    due = Enum.sort(due)
+
+    {tasks, overlaps} =
+      Enum.reduce(due, {tasks, []}, fn {_priority, next, _index, name, interval, _}, acc ->
+        missed(div(now - next, interval), next, name, interval, acc)
+      end)
+
+    {due, tasks, Enum.reverse(overlaps)}
+  end
+
+  defp missed(missed, next, name, interval, {tasks, overlaps}) do
+    tasks =
+      Map.update!(tasks, name, fn %{overlaps: count} ->
+        %{next_due: next + (missed + 1) * interval, overlaps: count + missed}
+      end)
+
+    {tasks, overlap(missed, name) ++ overlaps}
+  end
+
+  defp overlap(0, _name), do: []
+  defp overlap(missed, name), do: [{:overlap, name, missed}]
+
+  defp runs(due, %{taskless: taskless}),
+    do:
+      Enum.flat_map(due, fn {_, _, _, name, _, members} -> Enum.map(members, &{name, &1}) end) ++
+        Enum.map(taskless, &{:none, &1})
+
+  # One scan of one instance in a cycle: copy in, run, copy out.
+  defp scan_in({task, name}, {globals, instances, ran}, %__MODULE__{} = rt, now) do
+    {type, ins, outs} = Map.fetch!(rt.plan.wiring, name)
+    %Instance{first: first} = state = Map.fetch!(instances, name)
+    inputs = Map.new(ins, fn {var, from} -> {var, source(from, globals)} end)
+
+    {outputs, state} =
+      call(Map.fetch!(rt.config.programs, type), state, inputs, %Scan{now: now, first: first})
+
+    globals = Enum.reduce(outs, globals, fn {var, sink}, g -> Map.put(g, sink, outputs[var]) end)
+    {globals, Map.put(instances, name, state), [{:ran, task, name, now} | ran]}
+  end
+
+  defp source(constant, _globals) when is_integer(constant), do: constant
+  defp source(global, globals), do: Map.fetch!(globals, global)
+
+  @doc """
+  How long, in ms, until the next periodic task is due: what a runner sleeps on before its
+  next `cycle/3`. 0 when one is due now, as every task is after `start/1`, and `:infinity`
+  with no periodic task. A task-less instance runs in every cycle, whenever the runner
+  cycles, so it is not counted: the runner paces it (§4.6).
+  """
+  def next_due_in(runtime) do
+    rt = runtime!(runtime)
+
+    soonest(
+      for {name, _, _, _, _} <- rt.plan.tasks, do: Map.fetch!(rt.tasks, name).next_due - rt.now
+    )
+  end
+
+  defp soonest([]), do: :infinity
+  defp soonest(waits), do: Enum.min(waits)
+
+  @doc """
+  Each task's overlap count, by name: the periods it missed since the resource started or
+  restarted, the sum of the `{:overlap, task, missed}` events it gave.
+  """
+  def overlaps(runtime) do
+    rt = runtime!(runtime)
+    Map.new(rt.tasks, fn {name, %{overlaps: count}} -> {name, count} end)
+  end
+
+  @doc """
+  The value an access path names, the resource left out (§4.6): a global, `"k1"`; a tag
+  of an instance, `"m1.motor"`, of any section; or a member of a function block instance
+  that a program may name, `"m1.t1.acc"`. An internal member, a whole instance and
+  anything else the configuration does not declare is a host mistake.
+  """
+  def get(runtime, path) do
+    rt = runtime!(runtime)
+    reached!(rt, path!(path), path)
+  end
+
+  defp path!(path) when is_binary(path), do: parts(String.split(path, "."), path)
+  defp path!(path), do: raise(ArgumentError, "#{path_rule()}, got: #{inspect(path)}")
+
+  defp path_rule, do: ~s|a path is names joined by `.`, as in "m1.t1.acc"|
+
+  defp parts(parts, path), do: named_parts(Enum.all?(parts, &Declarations.name?/1), parts, path)
+
+  defp named_parts(true, parts, _path), do: parts
+
+  defp named_parts(false, _parts, path),
+    do: raise(ArgumentError, "#{path_rule()}, got: #{inspect(path)}")
+
+  defp reached!(%__MODULE__{globals: globals, instances: instances} = rt, [head | rest], path),
+    do: headed(Map.fetch(globals, head), Map.fetch(instances, head), rt, head, rest, path)
+
+  defp headed({:ok, value}, _instance, _rt, _head, [], _path), do: value
+
+  defp headed({:ok, _value}, _instance, rt, head, _rest, path),
+    do:
+      raise(
+        ArgumentError,
+        "`#{head}` is a #{global_type(rt, head)} global: it has no members, so `#{path}` names nothing"
+      )
+
+  defp headed(:error, {:ok, state}, rt, head, rest, _path), do: in_instance(rt, head, state, rest)
+
+  defp headed(:error, :error, rt, head, _rest, _path),
+    do:
+      raise(
+        ArgumentError,
+        "no global or instance is named `#{head}`" <>
+          Declarations.suggest(
+            head,
+            Map.keys(rt.globals) ++ Map.keys(rt.instances),
+            & &1,
+            "names"
+          )
+      )
+
+  defp global_type(rt, name), do: Enum.find(rt.config.globals, &(&1.name == name)).type
+
+  defp in_instance(rt, name, %Instance{type: type}, []),
+    do:
+      raise(
+        ArgumentError,
+        "`#{name}` is an instance of `#{type}`: name one of its tags, as in " <>
+          "`#{name}.#{rt.config.programs[type].tags |> Map.keys() |> Enum.min()}`"
+      )
+
+  defp in_instance(rt, name, %Instance{type: type, env: env}, [tag | deeper]) do
+    %Program{tags: tags} = Map.fetch!(rt.config.programs, type)
+
+    tagged(
+      Map.get(tags, tag),
+      Map.get(env, tag, 0),
+      "#{name}.#{tag}",
+      deeper,
+      {name, type, tags, tag}
+    )
+  end
+
+  defp tagged(nil, _value, _shown, _deeper, {name, type, tags, tag}),
+    do:
+      raise(
+        ArgumentError,
+        "`#{name}` is an instance of `#{type}`, which declares no `#{tag}`" <>
+          Declarations.suggest(tag, Map.keys(tags))
+      )
+
+  defp tagged(%Tag{type: type}, value, shown, deeper, _where),
+    do: member_value(type, value, shown, deeper)
+
+  # A path past a tag walks its members, at any depth (M2-5's blocks nest), and stops at
+  # a value: a whole instance is not one.
+  defp member_value(%FbType{} = type, _value, shown, []),
+    do:
+      raise(
+        ArgumentError,
+        "`#{shown}` is a #{type.name}: name one of its members, as in " <>
+          "`#{shown}.#{hd(FbType.public(type)).name}`"
+      )
+
+  defp member_value(%FbType{} = type, value, shown, [part | deeper]),
+    do: in_member(FbType.member(type, part), as_map(value), shown, part, deeper, type)
+
+  defp member_value(_elementary, value, _shown, []), do: value
+
+  defp member_value(type, _value, shown, [part | _deeper]),
+    do:
+      raise(
+        ArgumentError,
+        "`#{shown}` is a #{type}: it has no members, so `#{shown}.#{part}` names nothing"
+      )
+
+  defp in_member({:ok, member}, value, shown, part, deeper, _type),
+    do: member_value(member.type, Map.get(value, part, 0), "#{shown}.#{part}", deeper)
+
+  defp in_member(:error, _value, shown, part, _deeper, type),
+    do:
+      raise(
+        ArgumentError,
+        "`#{part}` is not a member of `#{shown}`, a #{type.name}: its members are " <>
+          listed(Enum.map(FbType.public(type), &"`#{&1.name}`"))
+      )
+
+  defp listed(names), do: Enum.join(Enum.drop(names, -1), ", ") <> " and " <> List.last(names)
+
+  @doc """
+  Starts the resource again (`:warm` is `:cold` until `retain` exists): it is then as
+  `start/1` left it, but for the clock and the input image, which it keeps. Every global
+  but an input point goes back to its initial value, each instance through `restart/3`,
+  every task is due at the next cycle, and every overlap count is 0.
+  """
+  def restart(runtime, mode) do
+    rt = runtime!(runtime)
+    mode!(mode)
+
+    %{
+      rt
+      | globals: Map.new(rt.config.globals, &{&1.name, restarted(&1, rt)}),
+        instances:
+          Map.new(rt.instances, fn {name, %Instance{type: type} = state} ->
+            {name, restart(Map.fetch!(rt.config.programs, type), state, mode)}
+          end),
+        tasks: Map.new(rt.tasks, fn {name, _} -> {name, %{next_due: rt.now, overlaps: 0}} end)
+    }
+  end
+
+  defp restarted(%{name: name} = global, %__MODULE__{plan: %{inputs: inputs}, globals: globals})
+       when is_map_key(inputs, name),
+       do: Map.get(globals, global.name)
+
+  defp restarted(global, _rt), do: initial(global)
+
+  defp runtime!(%__MODULE__{} = rt), do: rt
+
+  defp runtime!(other),
+    do:
+      raise(
+        ArgumentError,
+        "expected a %Logex.Runtime{} from Logex.Runtime.start/1, got: #{inspect(other)}"
+      )
+
+  # Step 2: every input problem, a line each in key order, or the image with the inputs
+  # merged into it. Only an input point is set, with a value that fits its type, as
+  # call/4 sets only a var_input.
+  defp image!(%__MODULE__{globals: globals} = rt, inputs)
+       when is_map(inputs) and not is_struct(inputs) do
+    problems =
+      for {key, value} <- Enum.sort(inputs), problem = point_problem(key, value, rt), do: problem
+
+    imaged(problems, globals, inputs)
+  end
+
+  defp image!(_rt, inputs),
+    do:
+      raise(
+        ArgumentError,
+        ~s|inputs must be a map of input point names to values, as in %{"pb_start" => 1}, | <>
+          "got: #{inspect(inputs)}"
+      )
+
+  defp imaged([], globals, inputs), do: Map.merge(globals, inputs)
+  defp imaged(problems, _globals, _inputs), do: raise(ArgumentError, Enum.join(problems, "\n"))
+
+  defp point_problem(key, _value, _rt) when not is_binary(key),
+    do:
+      "input #{inspect(key)} is not a point name: a configuration's inputs are keyed by " <>
+        ~s|input point name, as a string, as in %{"pb_start" => 1}|
+
+  defp point_problem(key, value, %__MODULE__{plan: %{inputs: inputs}})
+       when is_map_key(inputs, key),
+       do: fit(%Tag{name: key, type: Map.fetch!(inputs, key), section: :var_input}, value)
+
+  defp point_problem(key, _value, rt),
+    do: not_a_point(Enum.find(rt.config.globals, &(&1.name == key)), key, rt)
+
+  defp not_a_point(%{at: nil}, key, _rt),
+    do:
+      "input `#{key}` is a global with no location, not an input point: only an input point " <>
+        "is set from outside"
+
+  defp not_a_point(%{at: at}, key, _rt),
+    do:
+      "input `#{key}` is an output point (at #{at}), not an input point: only an input point " <>
+        "is set from outside"
+
+  defp not_a_point(nil, key, rt) do
+    [head | rest] = String.split(key, ".")
+    other_name(Map.has_key?(rt.instances, head), rest, key, rt)
+  end
+
+  defp other_name(true, [], key, _rt),
+    do:
+      "input #{label(key)} is a program instance, not an input point: only an input point is set from outside"
+
+  defp other_name(true, _rest, key, _rt),
+    do:
+      "input #{label(key)} reaches into the instance `#{hd(String.split(key, "."))}`: only an " <>
+        "input point is set from outside"
+
+  defp other_name(false, [], key, %__MODULE__{tasks: tasks}) when is_map_key(tasks, key),
+    do: "input `#{key}` is a task, not an input point: only an input point is set from outside"
+
+  defp other_name(false, _rest, key, rt) do
+    points = Enum.sort(Map.keys(rt.plan.inputs))
+
+    "input #{label(key)} is not declared" <>
+      points_hint(Declarations.suggest(key, points, & &1, "names"), points)
+  end
+
+  defp points_hint("", []), do: ": this configuration has no input point"
+
+  defp points_hint("", points),
+    do: ": the input points are " <> Enum.map_join(points, ", ", &"`#{&1}`")
+
+  defp points_hint(suggestion, _points), do: suggestion
+
   # The evaluator's scan is the host's `now` and `first` with the instance's block list,
   # which holds for this one scan (OE-1), made a map once here so that each `ons` looks its
   # bit up: a walk of the list made the scan after a switch quadratic in the one-shots it
diff --git a/test/logex/api_contract_test.exs b/test/logex/api_contract_test.exs
index 2d033a4..5ade8d4 100644
--- a/test/logex/api_contract_test.exs
+++ b/test/logex/api_contract_test.exs
@@ -1476,4 +1476,736 @@ defmodule Logex.ApiContractTest do
   defp edit_reach(name, true), do: reached(:edit_reach, name)
 
   defp edit_reach(_name, false), do: :ok
+
+  # ---- M2-1: the walk over a configuration -----------------------------------------------
+  #
+  # Random configurations from one vocabulary, cycled by random host calls. Every host
+  # mistake is refused with a documented message and every call without one is accepted,
+  # made twice and gives the same result. An oracle scheduler, written from
+  # docs/organisation.md §4.6's text, predicts every cycle's outputs and events, every
+  # value get/2 reads, next_due_in/1 and the overlap counts. It keeps no next due time:
+  # a task with interval P is due in a cycle when one of its due times, the anchor (start
+  # or the last restart) plus a whole number of P, falls in the time since the previous
+  # cycle, and it missed one period for each further due time there. Its scans go through
+  # Logex.Runtime.call/4, the per-instance step, which the scheduler is defined by. The
+  # order of the due tasks is the one thing it restates, so scheduler_test.exs has a
+  # worked test of each key of it.
+
+  @walk_programs %{
+    "relay" => """
+    var_input a bool
+    var_input b bool
+    var_input k dint
+    var_output q bool
+    var_output n dint
+    var s bool
+    var t1 ton
+
+    ( xic a | xic q ) xio b ote q
+    xic a ons s move k n
+    xic t1.dn move 0 n
+    xic q ton t1 25
+    """,
+    "pass" => """
+    var_input x bool
+    var_output y bool
+    var_output z dint
+
+    xic x ote y
+    xic x move 5 z
+    xio x move 9 z
+    """
+  }
+
+  # The input points every walk's configuration has, and the unlocated globals any
+  # instance may read and one var_output may drive, so instances share values.
+  @walk_inputs [{"i0", :bool}, {"i1", :bool}, {"i2", :bool}, {"d0", :dint}]
+  @walk_shared [{"s0", :bool}, {"s1", :bool}, {"sd", :dint}]
+
+  # The documented refusals of the resource's API, by a fragment each.
+  @walk_refusals [
+    "expected a %Logex.Runtime{}",
+    "elapsed_ms must be",
+    "inputs must be a map",
+    "is not a point name",
+    "not an input point",
+    "reaches into the instance",
+    "is not declared",
+    "only 0 or 1 fit",
+    "its value must be an integer",
+    "does not fit in 32 bits",
+    "a path is names joined",
+    "no global or instance is named",
+    "global: it has no members",
+    "name one of its tags",
+    "which declares no",
+    "name one of its members",
+    "is not a member of",
+    ": it has no members, so",
+    "restart takes"
+  ]
+
+  # What the oracle must see happen, at least once each.
+  @walk_reach [
+    :ran_task,
+    :ran_none,
+    :overlap,
+    :first_cycle_overlap,
+    :idle_cycle,
+    :priority_order,
+    :due_time_order,
+    :declaration_order,
+    :saw_earlier_write,
+    :restart,
+    :infinity,
+    :next_due
+  ]
+
+  defp walk_programs,
+    do:
+      Map.new(@walk_programs, fn {name, src} ->
+        {name, elem(Logex.compile(src, name: name), 1)}
+      end)
+
+  # A configuration drawn at random, always valid: 0 to 3 tasks, 1 to 5 instances, each
+  # var_input from an input point, a shared global, a constant or a global another
+  # instance drives, and each var_output to none, one or two sinks.
+  defp walk_config(programs), do: Logex.Configuration.new!(walk_config_fields(programs))
+
+  defp walk_config_fields(programs) do
+    # Task names in random order, so declaration order and name order differ.
+    tasks =
+      for name <- Enum.take(Enum.shuffle(~w(t1 t2 t3)), :rand.uniform(4) - 1) do
+        %{name: name, interval: pick([1, 3, 5, 10, 10, 30]), priority: pick([0, 1, 1, 2])}
+      end
+
+    instances =
+      for i <- 1..:rand.uniform(5) do
+        %{
+          name: "m#{i}",
+          type: pick(Map.keys(programs)),
+          task: pick([nil | Enum.map(tasks, & &1.name)])
+        }
+      end
+
+    {connections, made} =
+      Enum.flat_map_reduce(instances, %{driven: MapSet.new(), new: []}, fn inst, made ->
+        tags = programs[inst.type].tags |> Map.values() |> Enum.sort_by(& &1.line)
+        Enum.flat_map_reduce(tags, made, &walk_wire(inst.name, &1, &2))
+      end)
+
+    walk_fields(programs, tasks, instances, connections, made)
+  end
+
+  defp walk_fields(programs, tasks, instances, connections, made) do
+    [
+      name: "walk",
+      programs: Map.values(programs),
+      tasks: tasks,
+      globals:
+        Enum.with_index(@walk_inputs, fn {n, t}, i -> %{name: n, type: t, at: "io.i.#{i}"} end) ++
+          for({n, t} <- @walk_shared, do: %{name: n, type: t}) ++ Enum.reverse(made.new),
+      instances: instances,
+      connections: connections
+    ]
+  end
+
+  defp walk_wire(inst, %Tag{section: :var_input, name: var, type: type}, made) do
+    sources =
+      for({n, ^type} <- @walk_inputs ++ @walk_shared, do: n) ++
+        for(%{name: n, type: ^type} <- made.new, do: n)
+
+    to = pick(sources ++ [pick(walk_constants(type))])
+    {[%{member: "#{inst}.#{var}", to: to}], made}
+  end
+
+  defp walk_wire(inst, %Tag{section: :var_output, name: var, type: type}, made) do
+    Enum.flat_map_reduce(1..pick([0, 1, 1, 2])//1, made, fn _, made ->
+      shared = for {n, ^type} <- @walk_shared, n not in made.driven, do: n
+      walk_sink(pick([:shared, :point, :global]), shared, "#{inst}.#{var}", type, made)
+    end)
+  end
+
+  defp walk_wire(_inst, _tag, made), do: {[], made}
+
+  defp walk_sink(:shared, [_ | _] = shared, member, _type, made) do
+    to = pick(shared)
+    {[%{member: member, to: to}], %{made | driven: MapSet.put(made.driven, to)}}
+  end
+
+  defp walk_sink(kind, _shared, member, type, made) do
+    n = length(made.new)
+    global = walk_global(kind, n, type)
+    {[%{member: member, to: global.name}], %{made | new: [global | made.new]}}
+  end
+
+  defp walk_global(:point, n, type), do: %{name: "o#{n}", type: type, at: "io.q.#{n}"}
+  defp walk_global(_kind, n, type), do: %{name: "g#{n}", type: type}
+
+  defp walk_constants(:bool), do: [0, 1]
+  defp walk_constants(:dint), do: [0, 5, 3000]
+
+  test "a resource refuses every host mistake with a documented ArgumentError, accepts " <>
+         "every call without one, and does what an oracle scheduler written from §4.6 says" do
+    programs = walk_programs()
+
+    for _ <- 1..300 do
+      config = walk_config(programs)
+      rt = Logex.Runtime.start(config)
+      oracle = oracle_start(config)
+      walk_resource(rt, oracle, 40)
+    end
+
+    assert Process.get(:walk_refused, MapSet.new()) == MapSet.new(@walk_refusals)
+    assert Process.get(:walk_reach, MapSet.new()) == MapSet.new(@walk_reach)
+  end
+
+  defp walk_resource(_rt, _oracle, 0), do: :ok
+
+  defp walk_resource(rt, oracle, n) do
+    {mistake?, call, check} = resource_operation(:rand.uniform(9), rt, oracle)
+
+    case walk_attempt(call) do
+      {:ok, result} ->
+        refute mistake?, "a host mistake was accepted"
+        {rt, oracle} = check.(result)
+        walk_resource(rt, oracle, n - 1)
+
+      :refused ->
+        assert mistake?, "a call without a host mistake was refused"
+        walk_resource(rt, oracle, n - 1)
+    end
+  end
+
+  # Each operation: whether it is a host mistake by the contract's own words, the call,
+  # and a check of an accepted result, which gives the runtime and the oracle back.
+  defp resource_operation(op, rt, oracle) when op in 1..4 do
+    elapsed = pick([0, 0, 1, 2, 3, 5, 10, 29, 30, 31, 100, 1000] ++ [-1, 1.5, nil])
+    inputs = walk_inputs(oracle)
+    mistake? = not (is_integer(elapsed) and elapsed >= 0) or bad_point_inputs?(inputs)
+
+    {mistake?, fn -> Logex.Runtime.cycle(rt, elapsed, inputs) end,
+     fn {rt, outputs, events} ->
+       {oracle, expected_outputs, expected_events} = oracle_cycle(oracle, elapsed, inputs)
+       assert {outputs, events} == {expected_outputs, expected_events}
+       check_reads(rt, oracle)
+       {rt, oracle}
+     end}
+  end
+
+  defp resource_operation(5, rt, oracle) do
+    good = good_paths(oracle)
+    path = pick(good ++ bad_paths(oracle))
+
+    {path not in good, fn -> Logex.Runtime.get(rt, path) end,
+     fn value ->
+       assert value == oracle_read(oracle, path)
+       {rt, oracle}
+     end}
+  end
+
+  defp resource_operation(6, rt, oracle) do
+    {false, fn -> {Logex.Runtime.next_due_in(rt), Logex.Runtime.overlaps(rt)} end,
+     fn {due_in, overlaps} ->
+       assert due_in == oracle_due_in(oracle)
+       assert overlaps == oracle.overlaps
+       walk_reached(due_kind(due_in))
+       {rt, oracle}
+     end}
+  end
+
+  defp resource_operation(7, rt, oracle) do
+    mode = pick([:cold, :warm, :cold, :hot])
+
+    {mode == :hot, fn -> Logex.Runtime.restart(rt, mode) end,
+     fn rt ->
+       oracle = oracle_restart(oracle, mode)
+       walk_reached(:restart)
+       check_reads(rt, oracle)
+       {rt, oracle}
+     end}
+  end
+
+  # Something other than a runtime, to any function.
+  defp resource_operation(_op, rt, oracle) do
+    junk = pick([nil, %{}, :rt, oracle.config, [rt]])
+
+    call =
+      pick([
+        fn -> Logex.Runtime.cycle(junk, 0, %{}) end,
+        fn -> Logex.Runtime.next_due_in(junk) end,
+        fn -> Logex.Runtime.overlaps(junk) end,
+        fn -> Logex.Runtime.get(junk, "i0") end,
+        fn -> Logex.Runtime.restart(junk, :cold) end
+      ])
+
+    {true, call, fn _ -> {rt, oracle} end}
+  end
+
+  defp due_kind(:infinity), do: :infinity
+  defp due_kind(_ms), do: :next_due
+
+  # Now and then not a map at all; otherwise a few keys, two in three of them input points,
+  # most with values that fit, so most cycles are accepted.
+  defp walk_inputs(oracle), do: walk_inputs(:rand.uniform(12), oracle)
+
+  defp walk_inputs(1, _oracle), do: pick([nil, [], %Scan{now: 0, first: true}])
+
+  defp walk_inputs(_, oracle) do
+    points = for {n, t} <- @walk_inputs, do: {n, t}
+
+    Map.new(1..:rand.uniform(3)//1, fn _ ->
+      case :rand.uniform(3) do
+        3 -> {pick(walk_bad_keys(oracle)), pick([0, 1])}
+        _ -> walk_point_value(pick(points))
+      end
+    end)
+  end
+
+  defp walk_point_value({name, :bool}), do: {name, pick([0, 1, 0, 1, 0, 1, 2])}
+
+  defp walk_point_value({name, :dint}),
+    do: {name, pick([0, 7, 2_147_483_647, 2_147_483_648, 1.0])}
+
+  defp walk_bad_keys(oracle),
+    do:
+      ["s0", "zz", "I0", :i0, "m1.a", "m1"] ++
+        Enum.map(oracle.config.tasks, & &1.name) ++
+        for(%{name: n, at: "io.q." <> _} <- oracle.config.globals, do: n)
+
+  # The contract's own words: only an input point, a bool 0 or 1, a dint in 32 bits.
+  defp bad_point_inputs?(inputs) when not is_map(inputs) or is_struct(inputs), do: true
+
+  defp bad_point_inputs?(inputs),
+    do:
+      Enum.any?(inputs, fn {key, value} ->
+        case List.keyfind(@walk_inputs, key, 0) do
+          {_, :bool} -> value not in [0, 1]
+          {_, :dint} -> not (is_integer(value) and value in -2_147_483_648..2_147_483_647//1)
+          nil -> true
+        end
+      end)
+
+  # Every path a host may read, from the configuration and the programs' text.
+  defp good_paths(oracle) do
+    globals = for %{name: n} <- oracle.config.globals, do: n
+
+    tags =
+      for %{name: inst, type: type} <- oracle.config.instances,
+          {tag, %Tag{type: t}} <- oracle.config.programs[type].tags,
+          path <- tag_paths("#{inst}.#{tag}", t),
+          do: path
+
+    globals ++ tags
+  end
+
+  defp tag_paths(path, %Logex.FbType{}), do: for(m <- ~w(pre acc dn tt en), do: "#{path}.#{m}")
+  defp tag_paths(path, _type), do: [path]
+
+  defp bad_paths(oracle) do
+    [first | _] = oracle.config.instances
+
+    ["zz", "i0.x", first.name, "#{first.name}.zz", "#{first.name}.a.x", "#{first.name}.x.x"] ++
+      ["#{first.name}.t1", "#{first.name}.t1.last", "#{first.name}.t1.acc.x", "m1..a", :m1, ""]
+  end
+
+  # Records the refusal's kind; an accepted call is made twice and must give the same
+  # result, since nothing in the runtime reads a clock or any state but its arguments.
+  defp walk_attempt(fun) do
+    result = fun.()
+    assert fun.() == result, "the same call gave two results"
+    {:ok, result}
+  rescue
+    error in ArgumentError ->
+      for line <- String.split(error.message, "\n") do
+        kind = Enum.find(@walk_refusals, &String.contains?(line, &1))
+        assert kind, "undocumented refusal: #{line}"
+        reached(:walk_refused, kind)
+      end
+
+      :refused
+  end
+
+  defp walk_reached(name), do: reached(:walk_reach, name)
+
+  # ---- the oracle -------------------------------------------------------------------------
+
+  defp oracle_start(config) do
+    %{
+      config: config,
+      now: 0,
+      anchor: 0,
+      prev: nil,
+      globals: Map.new(config.globals, &{&1.name, &1.initial || 0}),
+      states:
+        Map.new(config.instances, &{&1.name, Logex.Runtime.instance(config.programs[&1.type])}),
+      overlaps: Map.new(config.tasks, &{&1.name, 0})
+    }
+  end
+
+  # How many of a task's due times, anchor + k * interval, fall in the cycle's window: since
+  # the previous cycle, or from the anchor in the first cycle after it; and the first one.
+  defp dues(%{anchor: anchor, prev: prev}, interval, now) do
+    upto = fn t -> if t < anchor, do: 0, else: div(t - anchor, interval) + 1 end
+
+    case prev do
+      nil -> {upto.(now), anchor}
+      prev -> {upto.(now) - upto.(prev), anchor + upto.(prev) * interval}
+    end
+  end
+
+  # A cycle as §4.6 defines it: `{oracle, outputs, events}`.
+  defp oracle_cycle(oracle, elapsed, inputs) do
+    now = oracle.now + elapsed
+    config = oracle.config
+
+    due =
+      Enum.sort(
+        for {task, index} <- Enum.with_index(config.tasks),
+            {count, first} = dues(oracle, task.interval, now),
+            count > 0,
+            do: {task.priority, first, index, task.name, count - 1}
+      )
+
+    order_reach(due)
+    overlaps = for {_, _, _, name, missed} <- due, missed > 0, do: {:overlap, name, missed}
+    first_cycle_reach(oracle.prev, overlaps)
+
+    runs =
+      for(
+        {_, _, _, name, _} <- due,
+        %{name: inst, task: ^name} <- config.instances,
+        do: {name, inst}
+      ) ++
+        for %{name: inst, task: nil} <- config.instances, do: {:none, inst}
+
+    sample = Map.merge(oracle.globals, inputs)
+
+    {globals, states, ran} =
+      Enum.reduce(runs, {sample, oracle.states, []}, fn {task, inst}, {globals, states, ran} ->
+        {globals, state} = oracle_scan(config, inst, states[inst], globals, sample, now)
+        walk_reached(ran_kind(task))
+        {globals, Map.put(states, inst, state), [{:ran, task, inst, now} | ran]}
+      end)
+
+    for [] <- [runs], do: walk_reached(:idle_cycle)
+    for [_ | _] <- [overlaps], do: walk_reached(:overlap)
+
+    oracle = %{
+      oracle
+      | now: now,
+        prev: now,
+        globals: globals,
+        states: states,
+        overlaps:
+          Enum.reduce(due, oracle.overlaps, fn {_, _, _, name, missed}, acc ->
+            Map.update!(acc, name, &(&1 + missed))
+          end)
+    }
+
+    outputs = for %{name: n, at: "io.q." <> _} <- config.globals, into: %{}, do: {n, globals[n]}
+    {oracle, outputs, overlaps ++ Enum.reverse(ran)}
+  end
+
+  defp ran_kind(:none), do: :ran_none
+  defp ran_kind(_task), do: :ran_task
+
+  defp first_cycle_reach(nil, [_ | _]), do: walk_reached(:first_cycle_overlap)
+  defp first_cycle_reach(_prev, _overlaps), do: :ok
+
+  # Which key of the order decided something: priority or due time against declaration
+  # order, and declaration order against name order.
+  defp order_reach(due) do
+    for {p1, d1, i1, _, _} = a <- due, {p2, d2, i2, _, _} = b <- due, a < b do
+      cond do
+        p1 < p2 and i1 > i2 -> walk_reached(:priority_order)
+        p1 == p2 and d1 < d2 and i1 > i2 -> walk_reached(:due_time_order)
+        p1 == p2 and d1 == d2 and elem(a, 3) > elem(b, 3) -> walk_reached(:declaration_order)
+        true -> :ok
+      end
+    end
+  end
+
+  # One scan as §4.6 defines it: the connected var_inputs copied in from the globals as
+  # they stand, call/4 at the cycle's time, the connected var_outputs copied out.
+  defp oracle_scan(config, inst, state, globals, sample, now) do
+    program = config.programs[Enum.find(config.instances, &(&1.name == inst)).type]
+
+    mine =
+      for c <- config.connections, [^inst, var] <- [String.split(c.member, ".")], do: {var, c.to}
+
+    inputs =
+      for {var, to} <- mine, program.tags[var].section == :var_input, into: %{} do
+        value = if is_integer(to), do: to, else: globals[to]
+        if is_binary(to) and globals[to] != sample[to], do: walk_reached(:saw_earlier_write)
+        {var, value}
+      end
+
+    {outputs, state} =
+      Logex.Runtime.call(program, state, inputs, %Scan{now: now, first: state.first})
+
+    globals =
+      Enum.reduce(mine, globals, fn {var, to}, g ->
+        if program.tags[var].section == :var_output, do: Map.put(g, to, outputs[var]), else: g
+      end)
+
+    {globals, state}
+  end
+
+  defp oracle_restart(oracle, mode) do
+    points = for {n, _} <- @walk_inputs, do: n
+
+    %{
+      oracle
+      | anchor: oracle.now,
+        prev: nil,
+        overlaps: Map.new(oracle.overlaps, fn {n, _} -> {n, 0} end),
+        globals:
+          Map.new(oracle.config.globals, fn g ->
+            {g.name, if(g.name in points, do: oracle.globals[g.name], else: g.initial || 0)}
+          end),
+        states:
+          Map.new(oracle.states, fn {n, s} ->
+            {n, Logex.Runtime.restart(oracle.config.programs[s.type], s, mode)}
+          end)
+    }
+  end
+
+  defp oracle_due_in(%{config: %{tasks: []}}), do: :infinity
+
+  defp oracle_due_in(oracle) do
+    Enum.min(
+      for task <- oracle.config.tasks do
+        case oracle.prev do
+          nil ->
+            oracle.anchor - oracle.now
+
+          _ ->
+            oracle.anchor + (div(oracle.now - oracle.anchor, task.interval) + 1) * task.interval -
+              oracle.now
+        end
+      end
+    )
+  end
+
+  defp oracle_read(oracle, path) do
+    case String.split(path, ".") do
+      [global] -> oracle.globals[global]
+      [inst, tag] -> oracle.states[inst].env[tag]
+      [inst, tag, member] -> oracle.states[inst].env[tag][member]
+    end
+  end
+
+  # After a cycle or a restart, every path a host may read reads what the oracle holds.
+  defp check_reads(rt, oracle) do
+    for path <- good_paths(oracle),
+        do: assert(Logex.Runtime.get(rt, path) == oracle_read(oracle, path), path)
+  end
+
+  # ---- M2-1: the constructor, given what a host may get wrong ---------------------------
+
+  # Every kind of problem check/1 reports, by a pattern each: the walk below must reach
+  # every one, and every line of every refusal must be one of them.
+  @configuration_problems [
+    ~r/^Logex\.Configuration\.new!\/1 takes a keyword list/,
+    ~r/^a configuration needs a name/,
+    ~r/cannot name a configuration/,
+    ~r/^programs: must be a list/,
+    ~r/is not a %Logex\.Program\{\} from/,
+    ~r/^a program in a configuration needs a name/,
+    ~r/^two programs are named/,
+    ~r/^\w+: must be a list, as in/,
+    ~r/ is a map, as in /,
+    ~r/ from Elixir has no line/,
+    ~r/^(task|global|instance|connection) %\{.*\} has [a-z_:, ]+: an? \w+ has /,
+    ~r/^(task|global|instance|connection) %\{.*\} has no \w+:, as in/,
+    ~r/cannot name (a task|a global|an instance)/,
+    ~r/its interval is 1 to/,
+    ~r/its priority is 0/,
+    ~r/its type is :bool or :dint/,
+    ~r/a location is a device/,
+    ~r/is an input point: its value comes from outside/,
+    ~r/its initial value must be an integer/,
+    ~r/its initial value must be 0 or 1/,
+    ~r/does not fit in 32 bits/,
+    ~r/is negative, which no configuration line/,
+    ~r/a point has one global/,
+    ~r/is an instance of `.*`, but no program is named/,
+    ~r/its type is the name of one of the configuration's programs/,
+    ~r/runs under `.*`, but no task is named/,
+    ~r/its task is the name of a task, or nil/,
+    ~r/a configuration runs at least one instance/,
+    ~r/: globals, instances and tasks share one namespace/,
+    ~r/differ only in case/,
+    ~r/^connection .*: a member is an instance/,
+    ~r/^connection `.*`: no instance is named/,
+    ~r/which declares no/,
+    ~r/is internal to `/,
+    ~r/the constant must be 0 or 1/,
+    ~r/cannot be connected to the constant/,
+    ~r/the other end of a connection is a global/,
+    ~r/but no global is named/,
+    ~r/which is an? \w+, not a global/,
+    ~r/is a (bool|dint), but `.*` is a (bool|dint)/,
+    ~r/is already connected, to/,
+    ~r/is an input point: `.*` cannot drive it/,
+    ~r/is already driven by/,
+    ~r/is not connected: every var_input is connected/
+  ]
+
+  test "new!/1 refuses broken data with every problem, a documented line each, and " <>
+         "nothing else escapes; what it accepts starts and cycles" do
+    programs = walk_programs()
+
+    for _ <- 1..1500 do
+      fields =
+        Enum.reduce(1..:rand.uniform(3), walk_config_fields(programs), fn _, f ->
+          broken(f, programs)
+        end)
+
+      try do
+        config = Logex.Configuration.new!(fields)
+        {_rt, outputs, _events} = Logex.Runtime.cycle(Logex.Runtime.start(config), 0, %{})
+        assert is_map(outputs)
+        reached(:constructor, :accepted)
+      rescue
+        error in ArgumentError ->
+          for line <- String.split(error.message, "\n") do
+            kind = Enum.find(@configuration_problems, &Regex.match?(&1, line))
+            assert kind, "undocumented problem: #{line}"
+            reached(:constructor, Regex.source(kind))
+          end
+      end
+    end
+
+    assert Process.get(:constructor) ==
+             MapSet.new([:accepted | Enum.map(@configuration_problems, &Regex.source/1)])
+  end
+
+  # One thing a host may get wrong, at random.
+  defp broken(fields, programs), do: broken_list(Keyword.keyword?(fields), fields, programs)
+
+  defp broken_list(true, fields, programs), do: broken(:rand.uniform(10), fields, programs)
+  defp broken_list(false, fields, _programs), do: fields
+
+  defp broken(1, fields, programs) do
+    {:ok, unnamed} =
+      Logex.Compiler.instructionize(
+        elem(Logex.Compiler.parse(elem(Logex.Compiler.tokenize("var a bool"), 1)), 1)
+      )
+
+    pick([
+      fn -> pick([:x, [1], fields ++ [task: []], fields ++ [name: "w"]]) end,
+      fn -> Keyword.delete(fields, :name) end,
+      fn -> Keyword.put(fields, :name, pick(["a b", :w, 5])) end,
+      fn -> Keyword.put(fields, :programs, pick([5, %{}])) end,
+      fn ->
+        Keyword.update!(
+          fields,
+          :programs,
+          &appended(&1, pick([:junk, unnamed, hd(Map.values(programs))]))
+        )
+      end,
+      fn -> Keyword.put(fields, :instances, []) end,
+      fn -> Keyword.put(fields, pick([:tasks, :globals, :instances, :connections]), 5) end
+    ]).()
+  end
+
+  defp broken(2, fields, _programs) do
+    part = pick([:tasks, :globals, :instances, :connections])
+
+    element =
+      pick([
+        :junk,
+        %{name: "x", line: 3},
+        %{name: "x", with: 1},
+        Map.new(Enum.take([{:name, "nx"}, {:interval, 5}, {:member, "m1.zz"}], :rand.uniform(2)))
+      ])
+
+    Keyword.update(fields, part, [element], &appended(&1, element))
+  end
+
+  # A field of an element made wrong, or a name made to clash.
+  defp broken(n, fields, _programs) when n in 3..6 do
+    part = pick([:tasks, :globals, :instances, :connections, :connections])
+
+    case Keyword.get(fields, part) do
+      [_ | _] = list ->
+        i = :rand.uniform(length(list)) - 1
+        Keyword.put(fields, part, List.update_at(list, i, &broken_field(part, &1, fields)))
+
+      _ ->
+        fields
+    end
+  end
+
+  # A connection more or one fewer.
+  defp broken(7, fields, _programs) do
+    case Keyword.get(fields, :connections) do
+      [_ | _] = list ->
+        Keyword.put(
+          fields,
+          :connections,
+          pick([list ++ [pick(list)], tl(list), Enum.drop(list, -1)])
+        )
+
+      _ ->
+        fields
+    end
+  end
+
+  defp broken(_n, fields, _programs), do: fields
+
+  defp appended(list, element) when is_list(list), do: list ++ [element]
+  defp appended(other, _element), do: other
+
+  defp broken_field(:tasks, task, _fields) when is_map(task),
+    do:
+      pick([
+        fn -> Map.put(task, :interval, pick([0, -1, 1.5, 2_147_483_648])) end,
+        fn -> Map.put(task, :priority, pick([-1, 1.5, 2_147_483_648])) end,
+        fn -> Map.put(task, :name, pick(["a b", 5, "S0", "i0", "m1"])) end,
+        fn -> Map.delete(task, :priority) end
+      ]).()
+
+  defp broken_field(:globals, global, fields) when is_map(global),
+    do:
+      pick([
+        fn -> Map.put(global, :type, pick([:int, nil])) end,
+        fn -> Map.put(global, :initial, pick([2, -1, 1.0, 2_147_483_648])) end,
+        fn -> Map.put(global, :at, pick(["p.x.0", "p.i.00", "io.i.0", "io.q.0", 5])) end,
+        fn -> Map.put(global, :name, pick(["k.1", "m1", "I0", "s0"] ++ task_names(fields))) end,
+        fn -> Map.delete(global, :type) end
+      ]).()
+
+  defp broken_field(:instances, instance, fields) when is_map(instance),
+    do:
+      pick([
+        fn -> Map.put(instance, :type, pick(["motr", :relay])) end,
+        fn -> Map.put(instance, :task, pick(["zz", :t2])) end,
+        fn -> Map.put(instance, :name, pick([5, "i0", "M1"] ++ task_names(fields))) end
+      ]).()
+
+  defp broken_field(:connections, connection, fields) when is_map(connection),
+    do:
+      pick([
+        fn ->
+          Map.put(connection, :member, pick(["m1", "zz.a", "m1.zz", "m1.s", "m1.t1", :m1]))
+        end,
+        fn ->
+          Map.put(
+            connection,
+            :to,
+            pick(
+              [1.0, 2, -1, 2_147_483_648, "zz", "m1", "i0", "d0", "s0", 1] ++ task_names(fields)
+            )
+          )
+        end,
+        fn -> Map.delete(connection, :to) end
+      ]).()
+
+  defp broken_field(_part, element, _fields), do: element
+
+  defp task_names(fields),
+    do: for(%{name: n} <- List.wrap(Keyword.get(fields, :tasks)), is_binary(n), do: n)
 end
diff --git a/test/logex/configuration_test.exs b/test/logex/configuration_test.exs
new file mode 100644
index 0000000..e85add1
--- /dev/null
+++ b/test/logex/configuration_test.exs
@@ -0,0 +1,519 @@
+defmodule Logex.ConfigurationTest do
+  @moduledoc """
+  M2-1: `Logex.Configuration`, a configuration built from Elixir data, and `check/1`, the
+  one validator its constructor, `Logex.Runtime.start/1` and the configuration file's
+  reader share. Every problem is pinned whole: `new!/1` raises one `ArgumentError` whose
+  message is every problem, a line each, and each test asserts that whole list.
+  """
+  use ExUnit.Case, async: true
+
+  alias Logex.Configuration
+
+  @motor """
+  var_input start bool
+  var_input stop bool
+  var_input sp_in dint
+  var_output motor bool
+  var_output speed_sp dint 1200
+  var fault bool
+  var t1 ton
+
+  ( xic start | xic motor ) xio stop ote motor
+  xic fault move 0 speed_sp
+  xic motor move sp_in speed_sp
+  xic motor ton t1 50
+  """
+
+  setup do
+    {:ok, motor} = Logex.compile(@motor, name: "motor")
+    %{motor: motor, base: base(motor)}
+  end
+
+  # A configuration with every kind of element, which new!/1 accepts: two tasks, input and
+  # output points, unlocated globals, an instance on a task and a task-less one, a
+  # constant tie-off, and `m2` reading `m1`'s output point back.
+  defp base(motor),
+    do: [
+      name: "plant",
+      programs: [motor],
+      tasks: [
+        %{name: "fast", interval: 10, priority: 1},
+        %{name: "slow", interval: 50, priority: 2}
+      ],
+      globals: [
+        %{name: "pb_start", type: :bool, at: "panel.i.0"},
+        %{name: "pb_stop", type: :bool, at: "panel.i.1"},
+        %{name: "sp", type: :dint, at: "drive.i.0"},
+        %{name: "k1", type: :bool, at: "panel.q.0"},
+        %{name: "k2", type: :bool, at: "panel.q.1", initial: 1},
+        %{name: "sp_out", type: :dint, initial: 7},
+        %{name: "spare", type: :bool}
+      ],
+      instances: [
+        %{name: "m1", type: "motor", task: "fast"},
+        %{name: "m2", type: "motor"}
+      ],
+      connections: [
+        %{member: "m1.start", to: "pb_start"},
+        %{member: "m1.stop", to: "pb_stop"},
+        %{member: "m1.sp_in", to: "sp"},
+        %{member: "m1.motor", to: "k1"},
+        %{member: "m1.speed_sp", to: "sp_out"},
+        %{member: "m2.start", to: "k1"},
+        %{member: "m2.stop", to: 0},
+        %{member: "m2.sp_in", to: 900},
+        %{member: "m2.motor", to: "k2"}
+      ]
+    ]
+
+  # The problems new!/1 raises, a line each, or [] when it accepts.
+  defp problems(fields) do
+    Configuration.new!(opaque(fields))
+    []
+  rescue
+    error in ArgumentError -> String.split(error.message, "\n")
+  end
+
+  # Hides a deliberately wrong argument from the type checker (runtime_test.exs).
+  defp opaque(value), do: Process.get(:__opaque_to_the_type_checker__, value)
+
+  defp put(fields, part, list), do: Keyword.put(fields, part, list)
+  defp add(fields, part, element), do: Keyword.update!(fields, part, &(&1 ++ [element]))
+
+  defp replace(fields, part, name_key, name, element),
+    do:
+      Keyword.update!(fields, part, fn list ->
+        Enum.map(list, &if(Map.get(&1, name_key) == name, do: element, else: &1))
