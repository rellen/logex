+    @readme_steps [
+      %{"start" => 1},
+      %{"start" => 0},
+      %{"overtemp" => 1},
+      %{"stop" => 1},
+      %{"stop" => 0, "overtemp" => 0},
+      %{"reset" => 1},
+      %{"reset" => 0, "start" => 1}
