index 0000000..3d77a53
--- /dev/null
+++ b/test/logex/scheduler_test.exs
@@ -0,0 +1,478 @@
+defmodule Logex.SchedulerTest do
+  @moduledoc """
+  M2-1: a resource running a configuration (`docs/organisation.md` §4.6), each rule of a
+  cycle with a worked test, through the public API only: `Logex.Runtime.start/1`,
+  `cycle/3`, `next_due_in/1`, `overlaps/1`, `get/2` and `restart/2`. The seeded walk in
+  `api_contract_test.exs` checks the same rules against an oracle written from §4.6's
+  text; these tests are the worked cases a shared misreading would pass there.
+  """
+  use ExUnit.Case, async: true
+
+  alias Logex.{Configuration, Runtime}
+
+  # `x` in, `y` out, and a one-shot on `x` that moves 7 into `n`, so a first scan shows.
+  @relay """
+  var_input x bool
+  var_output y bool
+  var_output n dint
+  var s bool
+
+  xic x ote y
+  xic x ons s move 7 n
+  """
+
+  setup do
+    {:ok, relay} = Logex.compile(@relay, name: "relay")
+    %{relay: relay}
+  end
+
+  # Instances of `relay`, each `{name, task, source}`: its `x` from `source`, a global or a
+  # constant, its `y` to the output point `<name>_y` and its `n` to the global `<name>_n`.
+  # Every global `source` names is an input point unless `globals` declares it.
+  defp line(relay, tasks, instances, globals \\ []) do
+    declared = MapSet.new(globals, & &1.name)
+
+    inputs =
+      for {_, _, source} <- instances,
+          is_binary(source),
+          source not in declared,
+          uniq: true,
+          do: source
+
+    Configuration.new!(
+      name: "line",
+      programs: [relay],
+      tasks: tasks,
+      globals:
+        Enum.with_index(inputs, &%{name: &1, type: :bool, at: "panel.i.#{&2}"}) ++
+          globals ++
+          Enum.flat_map(Enum.with_index(instances), fn {{name, _, _}, i} ->
+            [
+              %{name: "#{name}_y", type: :bool, at: "panel.q.#{i}"},
+              %{name: "#{name}_n", type: :dint}
+            ]
+          end),
+      instances: for({name, task, _} <- instances, do: %{name: name, type: "relay", task: task}),
+      connections:
+        Enum.flat_map(instances, fn {name, _, source} ->
+          [
+            %{member: "#{name}.x", to: source},
+            %{member: "#{name}.y", to: "#{name}_y"},
+            %{member: "#{name}.n", to: "#{name}_n"}
+          ]
+        end)
+    )
+  end
+
+  defp task(name, interval, priority), do: %{name: name, interval: interval, priority: priority}
+
+  # Cycles through `{elapsed_ms, inputs}` steps: `{[{outputs, events}], runtime}`.
+  defp cycles(rt, steps),
+    do:
+      Enum.map_reduce(steps, rt, fn {elapsed, inputs}, rt ->
+        {rt, outputs, events} = Runtime.cycle(rt, elapsed, inputs)
+        {{outputs, events}, rt}
+      end)
+
+  defp ran(events), do: for({:ran, task, instance, _now} <- events, do: {task, instance})
+
+  describe "start/1" do
+    test "every task is due in the first cycle, even after no time at all", %{relay: relay} do
+      rt =
+        Runtime.start(
+          line(relay, [task("t5", 5, 0), task("t50", 50, 1)], [{"a", "t5", 1}, {"b", "t50", 1}])
+        )
+
+      assert Runtime.next_due_in(rt) == 0
+      {_rt, _outputs, events} = Runtime.cycle(rt, 0, %{})
+      assert events == [{:ran, "t5", "a", 0}, {:ran, "t50", "b", 0}]
+    end
+
+    # Fix F14: start/1 builds each instance as Runtime.instance/1 does, so its tags start
+    # at their initial values and its first scan is a first scan: the one-shot on an input
+    # already true does not fire, and fires on the next rise.
+    test "builds each instance through Runtime.instance/1: initial values, and a first scan " <>
+           "that holds every one-shot back",
+         %{relay: relay} do
+      rt = Runtime.start(line(relay, [], [{"a", nil, "pb"}]))
+
+      assert for(tag <- ~w(x y n s), do: Runtime.get(rt, "a.#{tag}")) ==
+               for(tag <- ~w(x y n s), do: Logex.Program.initial_env(relay)[tag])
+
+      {[{first, _}], rt} = cycles(rt, [{0, %{"pb" => 1}}])
+      assert {first, Runtime.get(rt, "a_n")} == {%{"a_y" => 1}, 0}
+      {_, rt} = cycles(rt, [{0, %{"pb" => 1}}])
+      assert Runtime.get(rt, "a_n") == 0
+      {_, rt} = cycles(rt, [{0, %{"pb" => 0}}, {0, %{"pb" => 1}}])
+      assert Runtime.get(rt, "a_n") == 7
+    end
+  end
+
+  describe "cycle/3, time and the input image" do
+    test "now advances by the elapsed time, and each scan runs at it", %{relay: relay} do
+      rt = Runtime.start(line(relay, [], [{"a", nil, 1}]))
+      {[{_, e1}, {_, e2}, {_, e3}], _rt} = cycles(rt, [{0, %{}}, {7, %{}}, {1000, %{}}])
+
+      assert [e1, e2, e3] == [
+               [{:ran, :none, "a", 0}],
+               [{:ran, :none, "a", 7}],
+               [{:ran, :none, "a", 1007}]
+             ]
+    end
+
+    test "the inputs merge into a persistent image: a host sends only what changed", %{
+      relay: relay
+    } do
+      rt = Runtime.start(line(relay, [], [{"a", nil, "pa"}, {"b", nil, "pb"}]))
+
+      {trace, rt} =
+        cycles(rt, [{0, %{"pa" => 1}}, {0, %{}}, {0, %{"pb" => 1}}, {0, %{"pa" => 0}}])
+
+      assert Enum.map(trace, &elem(&1, 0)) == [
+               %{"a_y" => 1, "b_y" => 0},
+               %{"a_y" => 1, "b_y" => 0},
+               %{"a_y" => 1, "b_y" => 1},
+               %{"a_y" => 0, "b_y" => 1}
+             ]
+
+      assert {Runtime.get(rt, "pa"), Runtime.get(rt, "pb")} == {0, 1}
+    end
+  end
+
+  describe "cycle/3, which tasks are due" do
+    # §4.6: next_due anchored at start, advanced by whole intervals after a run, so the
+    # phase never drifts. Stepped at 3 ms, a 10 ms task runs at the first cycle at or past
+    # each multiple of 10.
+    test "a periodic task runs at the first cycle at or past each multiple of its interval",
+         %{relay: relay} do
+      rt = Runtime.start(line(relay, [task("t", 10, 0)], [{"a", "t", 1}]))
+      {trace, _rt} = cycles(rt, [{0, %{}} | List.duplicate({3, %{}}, 20)])
+      times = for {_, events} <- trace, {:ran, "t", "a", now} <- events, do: now
+      assert times == [0, 12, 21, 30, 42, 51, 60]
+    end
+
+    # §4.6 "Missed periods are reported, not replayed": one run, `missed` added to the count,
+    # `{:overlap, task, missed}`, and next_due past now with the phase kept.
+    test "a task due more than once since it last ran runs once and reports the periods it " <>
+           "missed, keeping its phase",
+         %{relay: relay} do
+      rt = Runtime.start(line(relay, [task("t", 10, 0)], [{"a", "t", 1}]))
+      {_, rt} = cycles(rt, [{0, %{}}])
+      {rt, _outputs, events} = Runtime.cycle(rt, 47, %{})
+      assert events == [{:overlap, "t", 3}, {:ran, "t", "a", 47}]
+      assert Runtime.overlaps(rt) == %{"t" => 3}
+      assert Runtime.next_due_in(rt) == 3
+
+      {rt, _outputs, events} = Runtime.cycle(rt, 3, %{})
+      assert events == [{:ran, "t", "a", 50}]
+      {_rt, _outputs, events} = Runtime.cycle(rt, 9, %{})
+      assert events == []
+    end
+
+    # Anchored at start: a first cycle a whole interval after start/1 has missed the run
+    # due at 0, so it reports it. That is the rule, not a spurious overlap: the host asked
+    # to cycle at once (next_due_in/1 is 0) and did not.
+    test "a first cycle a whole interval after start reports the period it missed", %{
+      relay: relay
+    } do
+      rt = Runtime.start(line(relay, [task("t", 10, 0)], [{"a", "t", 1}]))
+      {_rt, _outputs, events} = Runtime.cycle(rt, 10, %{})
+      assert events == [{:overlap, "t", 1}, {:ran, "t", "a", 10}]
+
+      {_rt, _outputs, events} = Runtime.cycle(rt, 9, %{})
+      assert events == [{:ran, "t", "a", 9}]
+    end
+
+    test "a task with no instance keeps its phase and its overlap count", %{relay: relay} do
+      rt = Runtime.start(line(relay, [task("idle", 10, 0)], [{"a", nil, 1}]))
+      {rt, _outputs, events} = Runtime.cycle(rt, 25, %{})
+      assert events == [{:overlap, "idle", 2}, {:ran, :none, "a", 25}]
+      assert Runtime.next_due_in(rt) == 5
+    end
+  end
+
+  describe "cycle/3, the order of the scans" do
+    test "due tasks run by priority, 0 first, whatever their declaration order", %{relay: relay} do
+      rt =
+        Runtime.start(
+          line(relay, [task("low", 10, 5), task("high", 10, 0), task("mid", 10, 2)], [
+            {"l", "low", 1},
+            {"h", "high", 1},
+            {"m", "mid", 1}
+          ])
+        )
+
+      {_rt, _outputs, events} = Runtime.cycle(rt, 0, %{})
+      assert ran(events) == [{"high", "h"}, {"mid", "m"}, {"low", "l"}]
+    end
+
+    # Rule 3a: at one priority, the longest waiting runs first, and declaration order
+    # breaks a tie, the tasks declared out of name order so that name order cannot pass.
+    # At 45 ms both are late: `c`'s run has been due since 30, `b`'s and `a`'s since 40,
+    # so `c` runs first though declared second.
+    test "at one priority the earlier due time runs first, then declaration order", %{
+      relay: relay
+    } do
+      rt =
+        Runtime.start(
+          line(relay, [task("b", 20, 1), task("c", 30, 1), task("a", 20, 1)], [
+            {"ia", "a", 1},
+            {"ib", "b", 1},
+            {"ic", "c", 1}
+          ])
+        )
+
+      {rt, _outputs, events} = Runtime.cycle(rt, 0, %{})
+      assert ran(events) == [{"b", "ib"}, {"c", "ic"}, {"a", "ia"}]
+      {rt, _outputs, events} = Runtime.cycle(rt, 25, %{})
+      assert ran(events) == [{"b", "ib"}, {"a", "ia"}]
+      {_rt, _outputs, events} = Runtime.cycle(rt, 20, %{})
+      assert ran(events) == [{"c", "ic"}, {"b", "ib"}, {"a", "ia"}]
+    end
+
+    # More than 32 instances, so a map of them no longer iterates in name order
+    # (CONTRIBUTING.md): declaration order is a list, kept.
+    test "a task's instances run in declaration order, and the task-less ones last, once " <>
+           "each, in theirs",
+         %{relay: relay} do
+      names = for i <- 40..1//-1, do: "i#{i}"
+      tasked = for name <- names, do: {name, "t", 1}
+      free = for name <- ["z9", "a1", "m5"], do: {name, nil, 1}
+      rt = Runtime.start(line(relay, [task("t", 10, 0)], tasked ++ free))
+
+      {[{_, first}, {_, second}], _rt} = cycles(rt, [{0, %{}}, {0, %{}}])
+      assert ran(first) == Enum.map(names, &{"t", &1}) ++ Enum.map(~w(z9 a1 m5), &{:none, &1})
+      assert ran(second) == Enum.map(~w(z9 a1 m5), &{:none, &1})
+    end
+
+    # §4.6: an instance sees any global an earlier instance wrote in the same cycle, and
+    # never one a later instance writes.
+    test "an instance sees what an earlier one wrote in the same cycle, and not what a later " <>
+           "one writes",
+         %{relay: relay} do
+      config =
+        line(
+          relay,
+          [task("t", 10, 0)],
+          [{"first", "t", "g_late"}, {"second", "t", "pb"}, {"third", "t", "g_early"}],
+          [%{name: "g_late", type: :bool}, %{name: "g_early", type: :bool}]
+        )
+
+      # `second` drives `g_early`, which `third` reads, and `g_late`, which `first` reads.
+      config = %{
+        config
+        | connections:
+            config.connections ++
+              [
+                %{member: "second.y", to: "g_early", line: nil},
+                %{member: "second.y", to: "g_late", line: nil}
+              ]
+      }
+
+      rt = Runtime.start(config)
+      {rt, outputs, _events} = Runtime.cycle(rt, 0, %{"pb" => 1})
+      assert outputs == %{"first_y" => 0, "second_y" => 1, "third_y" => 1}
+      {_rt, outputs, _events} = Runtime.cycle(rt, 10, %{})
+      assert outputs == %{"first_y" => 1, "second_y" => 1, "third_y" => 1}
+    end
+  end
+
+  describe "cycle/3, copy-in, copy-out and the outputs" do
+    test "a var_input reads its global or its constant, and a var_output drives every global " <>
+           "it is connected to",
+         %{relay: relay} do
+      config =
+        line(relay, [], [{"a", nil, 1}, {"b", nil, "g"}], [%{name: "g", type: :bool}])
+
+      config = %{
+        config
+        | connections: config.connections ++ [%{member: "a.y", to: "g", line: nil}]
+      }
+
+      {_rt, outputs, _events} = Runtime.cycle(Runtime.start(config), 0, %{})
+      assert outputs == %{"a_y" => 1, "b_y" => 1}
+    end
+
+    test "the outputs are every output point, each cycle, whether or not anything ran", %{
+      relay: relay
+    } do
+      rt =
+        Runtime.start(
+          line(relay, [task("t", 10, 0)], [{"a", "t", "pb"}], [
+            %{name: "lamp", type: :bool, at: "panel.q.9", initial: 1},
+            %{name: "memo", type: :dint, initial: 3}
+          ])
+        )
+
+      {rt, outputs, _events} = Runtime.cycle(rt, 0, %{"pb" => 1})
+      assert outputs == %{"a_y" => 1, "lamp" => 1}
+      {_rt, outputs, events} = Runtime.cycle(rt, 1, %{"pb" => 0})
+      assert {outputs, events} == {%{"a_y" => 1, "lamp" => 1}, []}
+    end
+  end
+
+  describe "next_due_in/1" do
+    test "is the time to the soonest periodic task, ignoring task-less instances, and " <>
+           ":infinity with no periodic task",
+         %{relay: relay} do
+      rt = Runtime.start(line(relay, [task("a", 30, 0), task("b", 20, 0)], [{"x", nil, 1}]))
+      {rt, _, _} = Runtime.cycle(rt, 0, %{})
+      assert Runtime.next_due_in(rt) == 20
+      {rt, _, _} = Runtime.cycle(rt, 13, %{})
+      assert Runtime.next_due_in(rt) == 7
+      {rt, _, _} = Runtime.cycle(rt, 7, %{})
+      assert Runtime.next_due_in(rt) == 10
+
+      lone = Runtime.start(line(relay, [], [{"x", nil, 1}]))
+      assert Runtime.next_due_in(lone) == :infinity
+      {lone, _, _} = Runtime.cycle(lone, 5, %{})
+      assert Runtime.next_due_in(lone) == :infinity
+    end
+  end
+
+  describe "get/2" do
+    test "reads a global, a tag of any section, and a member a program may name" do
+      {:ok, timed} =
+        Logex.compile(
+          "var_input go bool\nvar_output d bool\nvar t1 ton\nxic go ton t1 20\nxic t1.dn ote d",
+          name: "timed"
+        )
+
+      config =
+        Configuration.new!(
+          name: "c",
+          programs: [timed],
+          globals: [
+            %{name: "go", type: :bool, at: "p.i.0"},
+            %{name: "memo", type: :dint, initial: 4}
+          ],
+          instances: [%{name: "m1", type: "timed"}],
+          connections: [%{member: "m1.go", to: "go"}]
+        )
+
+      rt = Runtime.start(config)
+      {rt, _, _} = Runtime.cycle(rt, 0, %{"go" => 1})
+      {rt, _, _} = Runtime.cycle(rt, 25, %{})
+
+      assert Enum.map(
+               ~w(go memo m1.go m1.d m1.t1.pre m1.t1.acc m1.t1.dn m1.t1.tt m1.t1.en),
+               &Runtime.get(rt, &1)
+             ) ==
+               [1, 4, 1, 1, 20, 20, 1, 0, 1]
+
+      assert_raise ArgumentError,
+                   "`last` is not a member of `m1.t1`, a ton: its members are `pre`, `acc`, " <>
+                     "`dn`, `tt` and `en`",
+                   fn -> Runtime.get(rt, "m1.t1.last") end
+
+      assert_raise ArgumentError,
+                   "`m1.t1` is a ton: name one of its members, as in `m1.t1.pre`",
+                   fn -> Runtime.get(rt, "m1.t1") end
+
+      assert_raise ArgumentError,
+                   "`m1.t1.acc` is a dint: it has no members, so `m1.t1.acc.x` names nothing",
+                   fn -> Runtime.get(rt, "m1.t1.acc.x") end
+    end
+  end
+
+  describe "restart/2" do
+    # As start/1 left it, but for the clock and the input image: every other global at its
+    # initial value, each instance restarted (a first scan again), every task due at the
+    # next cycle and every overlap count 0.
+    test "starts the resource again, keeping the clock and the input image", %{relay: relay} do
+      config =
+        line(relay, [task("t", 10, 0)], [{"a", "t", "pb"}], [
+          %{name: "memo", type: :dint, initial: 4}
+        ])
+
+      config = %{
+        config
+        | connections: config.connections ++ [%{member: "a.n", to: "memo", line: nil}]
+      }
+
+      rt = Runtime.start(config)
+      {_, rt} = cycles(rt, [{0, %{"pb" => 0}}, {10, %{"pb" => 1}}, {35, %{}}])
+      assert {Runtime.get(rt, "memo"), Runtime.overlaps(rt)} == {7, %{"t" => 2}}
+
+      rt = Runtime.restart(rt, :warm)
+      assert Runtime.get(rt, "pb") == 1
+      assert Runtime.get(rt, "memo") == 4
+      assert Runtime.get(rt, "a_n") == 0
+      assert Runtime.overlaps(rt) == %{"t" => 0}
+      assert Runtime.next_due_in(rt) == 0
+
+      # The next cycle, at elapsed 0, runs the task at the kept clock, 45 ms. The instance's
+      # one-shot is held back on its first scan though `pb` is still 1, so `n` stays at its
+      # initial 0, which the scan copies out over `memo`'s 4.
+      {rt, outputs, events} = Runtime.cycle(rt, 0, %{})
+      assert events == [{:ran, "t", "a", 45}]
+      assert {outputs, Runtime.get(rt, "memo")} == {%{"a_y" => 1}, 0}
+      assert Runtime.next_due_in(rt) == 10
+    end
+  end
+
+  # ---- growth -------------------------------------------------------------------------
+
+  # A cycle is linear in what it runs: counted in reductions rather than time, as
+  # logex_test.exs counts a compile, and the least of three counts. `n` instances under
+  # one task, each wired to two globals and an input point shared by all, and as many
+  # task-less ones; every one of them runs in the counted cycle.
+  defp reductions_to_cycle(relay, n) do
+    rt =
+      Runtime.start(
+        line(
+          relay,
+          [task("t", 10, 0)],
+          for(i <- 1..n, do: {"a#{i}", "t", "pb"}) ++ for(i <- 1..n, do: {"b#{i}", nil, "pb"})
+        )
+      )
+
+    count(fn -> Runtime.cycle(rt, 10, %{"pb" => 1}) end)
+  end
+
+  # `n` tasks of one instance each, all due and late in the counted cycle, at priorities
+  # and due times that differ, so the order sorts on every key.
+  defp reductions_to_cycle_tasks(relay, n) do
+    tasks = for i <- 1..n, do: task("t#{i}", 10 + rem(i, 7), rem(i, 5))
+    rt = Runtime.start(line(relay, tasks, for(i <- 1..n, do: {"a#{i}", "t#{i}", "pb"})))
+    {rt, _, _} = Runtime.cycle(rt, 0, %{})
+    count(fn -> Runtime.cycle(rt, 31, %{"pb" => 1}) end)
+  end
+
+  defp reductions_to_start(relay, n) do
+    count(fn ->
+      Runtime.start(line(relay, [task("t", 10, 0)], for(i <- 1..n, do: {"a#{i}", "t", "p#{i}"})))
+    end)
+  end
+
+  defp count(fun) do
+    Enum.min(
+      for _ <- 1..3 do
+        {:reductions, before} = Process.info(self(), :reductions)
+        fun.()
+        {:reductions, later} = Process.info(self(), :reductions)
+        later - before
+      end
+    )
+  end
+
+  describe "growth" do
+    # At 16x, not 4x, because `++` is charged few reductions for what it copies
+    # (CONTRIBUTING.md): events appended one scan at a time grew 4.4x for 4x the instances,
+    # within a 4x bound, and 25.6x for 16x, where a linear cycle grows 16.1x to 16.3x.
+    test "a cycle stays linear in the instances it runs", %{relay: relay} do
+      ratio = reductions_to_cycle(relay, 1600) / reductions_to_cycle(relay, 100)
+      assert ratio < 19.5, "16x the instances took #{Float.round(ratio, 2)}x the reductions"
+    end
+
+    test "a cycle stays linear in the tasks due", %{relay: relay} do
+      ratio = reductions_to_cycle_tasks(relay, 400) / reductions_to_cycle_tasks(relay, 100)
+      assert ratio < 5.5, "4x the tasks took #{Float.round(ratio, 2)}x the reductions"
+    end
+
+    test "new!/1 and start/1 stay linear in the configuration's size", %{relay: relay} do
+      ratio = reductions_to_start(relay, 400) / reductions_to_start(relay, 100)
+      assert ratio < 5.5, "4x the configuration took #{Float.round(ratio, 2)}x the reductions"
+    end
+  end
+end
