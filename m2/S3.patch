+      "`#{member}` is connected to `#{to}`, but no global is named `#{to}`" <>
+        Declarations.suggest(to, names, & &1, "names")
+
+  defp no_global(kind, member, to, _names),
+    do: "`#{member}` is connected to `#{to}`, which is #{kind}, not a global"
+
+  defp type_word(%FbType{name: name}), do: name
