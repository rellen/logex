+           "`#{name}.#{var}` is not connected: every var_input is connected, to a global or " <>
+             "a constant"}
+      )
+
+  # A program's tags in declaration order: those from Elixir, which have no line, first.
+  defp by_line(tags), do: Enum.sort_by(Map.values(tags), &{&1.line || 0, &1.name})
+
+  # ---- words ----------------------------------------------------------------------------
+
+  defp among(name, names, kind),
+    do: hint(Declarations.suggest(name, names, & &1, "names"), Enum.sort(names), kind)
+
+  defp hint("", [], kind), do: ": this configuration has no #{kind}"
+  defp hint("", names, kind), do: ": the #{kind} are " <> listed(Enum.map(names, &"`#{&1}`"))
+  defp hint(suggestion, _names, _kind), do: suggestion
+
+  defp article("instance"), do: "an instance"
+  defp article(kind), do: "a #{kind}"
+
+  defp listed([one]), do: one
+  defp listed(names), do: Enum.join(Enum.drop(names, -1), ", ") <> " and " <> List.last(names)
+
+  defp label(name) when is_binary(name), do: "`#{name}`"
+  defp label(name), do: inspect(name)
+end
