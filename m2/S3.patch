+
+    # One program type whose scans show the scheduler: `seen` comes in from a global and
+    # goes out again as `echo`, so a chain of instances shows the order they ran in; and
+    # `busy` is how long `go` has been true by the instance's own timer, so its outputs
+    # show the time it last ran.
+    @stamp """
+    var_input go bool
+    var_input seen bool
+    var_output echo bool
+    var_output busy dint
+    var t1 ton
+
+    xic seen ote echo
+    xic go ton t1 100000
+    xic go move t1.acc busy
+    """
+
+    @readme_motor """
+    var_input start bool
+    var_input stop bool
+    var_input overtemp bool
+    var_input reset bool
+    var_output motor bool
+    var_output run_lamp bool
+    var_output speed_sp dint 1200
+    var fault bool
+
+    ( xic start | xic motor ) xio stop ote motor
+    xic motor ote run_lamp
+    xic overtemp otl fault
+    xic reset otu fault
+    xic fault move 0 speed_sp
+    """
+
+    # PLAN.md M2-3's motor: the README's, plus a timer.
+    @m23_motor """
+    var_input start bool
+    var_input stop bool
+    var_input overtemp bool
+    var_input reset bool
+    var_output motor bool
+    var_output run_lamp bool
+    var_output speed_sp dint 1200
+    var_output running_ms dint
+    var fault bool
+    var t1 ton
