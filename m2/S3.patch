diff --git a/lib/logex/configuration.ex b/lib/logex/configuration.ex
new file mode 100644
index 0000000..93e4119
--- /dev/null
+++ b/lib/logex/configuration.ex
@@ -0,0 +1,816 @@
+defmodule Logex.Configuration do
+  @moduledoc """
+  A configuration with one resource (M2-1, `docs/organisation.md` §4.4 and §4.6): the
+  program types it runs, its periodic tasks, its globals (located or not), the program
+  instances it runs, and the connections that copy each instance's var_inputs in and its
+  var_outputs out. It is plain data, held in declaration order, and stateless:
+  `Logex.Runtime.start/1` makes a running resource of it.
+
+      Logex.Configuration.new!(
+        name: "line",
+        programs: [motor],
+        tasks: [%{name: "fast", interval: 10, priority: 1}],
+        globals: [
+          %{name: "pb_start", type: :bool, at: "panel.i.0"},
+          %{name: "pb_stop", type: :bool, at: "panel.i.1"},
+          %{name: "k1", type: :bool, at: "panel.q.0"}
+        ],
+        instances: [%{name: "m1", type: "motor", task: "fast"}],
+        connections: [
+          %{member: "m1.start", to: "pb_start"},
+          %{member: "m1.stop", to: "pb_stop"},
+          %{member: "m1.motor", to: "k1"}
+        ]
+      )
+
+  Each element says what one line of a configuration file will say (§4.4):
+
+  - a task, its `name`, `interval` in ms and `priority`, 0 the highest;
+  - a global, its `name`, `type` (`:bool` or `:dint`), an `initial` value and a location,
+    `at`, which makes it a point: `"panel.i.0"` an input point and `"panel.q.0"` an output
+    point, a device, `i` or `q`, then one or more address fields;
+  - an instance, its `name`, its program's name as `type`, and its `task`, nil for an
+    instance that runs once in every cycle;
+  - a connection, an instance's var_input or var_output as `member`, `"m1.start"`, and the
+    global or, for a var_input, the constant at its other end as `to`.
+
+  **One validator.** `new!/1` builds a configuration from Elixir and refuses it with every
+  problem `check/1` finds, in one `ArgumentError`, a problem a line. `check/1` is the one
+  validator: for `new!/1`, for `Logex.Runtime.start/1`, which checks again, and for the
+  configuration file's reader, which gives each problem the line of the element it
+  cites. It refuses what no configuration line can say: a name that is not one name, a
+  negative number, a location that is not one. It checks that:
+
+  - every name is one name; globals, instances and tasks share one namespace, in which no
+    two names differ only in case; program types have a namespace of their own;
+  - a task's interval is 1 to 2147483647 ms and its priority 0 to 2147483647;
+  - a global is a bool or a dint, its initial value fits it, an input point takes none,
+    and no two globals share a location;
+  - an instance's program is one of the configuration's, its task one of its tasks, and
+    the configuration runs at least one instance;
+  - a connection joins a var_input to a global or a constant, or a var_output to a global,
+    of the same type, and never a `var`; a var_input has one source, a global one driver,
+    and nothing drives an input point;
+  - every var_input of every instance is connected (decision 7).
+
+  A configuration built or edited by hand is outside the contract, and
+  `Logex.Runtime.start/1` checks it again.
+  """
+
+  alias Logex.{Declarations, FbType, Program, Tag}
+
+  @enforce_keys [:name, :programs, :tasks, :globals, :instances, :connections]
+  defstruct [:name, :programs, :tasks, :globals, :instances, :connections]
+
+  @type line :: pos_integer | nil
+  @type task :: %{name: String.t(), interval: pos_integer, priority: non_neg_integer, line: line}
+  @type global :: %{
+          name: String.t(),
+          type: :bool | :dint,
+          initial: non_neg_integer | nil,
+          at: String.t() | nil,
+          line: line
+        }
+  @type instance :: %{name: String.t(), type: String.t(), task: String.t() | nil, line: line}
+  @type connection :: %{member: String.t(), to: String.t() | non_neg_integer, line: line}
+  @type t :: %__MODULE__{
+          name: String.t(),
+          programs: %{String.t() => Program.t()},
+          tasks: [task],
+          globals: [global],
+          instances: [instance],
+          connections: [connection]
+        }
+
+  @parts [:name, :programs, :tasks, :globals, :instances, :connections]
+
+  # Each element's keys: the required ones, then the optional ones.
+  @keys %{
+    tasks: {[:name, :interval, :priority], []},
+    globals: {[:name, :type], [:initial, :at]},
+    instances: {[:name, :type], [:task]},
+    connections: {[:member, :to], []}
+  }
+  @kind %{tasks: "task", globals: "global", instances: "instance", connections: "connection"}
+  @example %{
+    tasks: ~s|%{name: "fast", interval: 10, priority: 1}|,
+    globals: ~s|%{name: "k1", type: :bool, at: "panel.q.0"}|,
+    instances: ~s|%{name: "m1", type: "motor", task: "fast"}|,
+    connections: ~s|%{member: "m1.start", to: "pb_start"}|
+  }
+
+  # Every integer a configuration holds is a dint, as a tag's is (IEC 61131-3 Ed 2 Table
+  # 10), and no line can say a negative one until a negative literal lexes.
+  @dint_max 2_147_483_647
+
+  @doc """
+  A configuration from Elixir data, checked by `check/1`: the configuration, or one
+  `ArgumentError` whose message is every problem, a line each. `fields` is a keyword list
+  of `name:`, a string shaped like a name, and the lists `programs:` (compiled by
+  `Logex.compile/2`, each under its own name), `tasks:`, `globals:`, `instances:` and
+  `connections:`, any left out for none. An element is a map of the keys the moduledoc
+  gives, an optional one left out for nil; one from Elixir has no line.
+  """
+  def new!(fields) when is_list(fields) do
+    config = fields |> keyword!() |> built()
+    raised(check(config), config)
+  end
+
+  def new!(fields), do: raise(ArgumentError, "#{takes()}, got: #{inspect(fields)}")
+
+  defp takes,
+    do:
+      "Logex.Configuration.new!/1 takes a keyword list of name:, programs:, tasks:, " <>
+        "globals:, instances: and connections:"
+
+  defp raised([], config), do: config
+
+  defp raised(problems, _config),
+    do: raise(ArgumentError, Enum.map_join(problems, "\n", &format/1))
+
+  defp format({nil, message}), do: message
+  defp format({line, message}), do: "line #{line}: #{message}"
+
+  # The keyword list's own shape: each part at most once, and no other key.
+  defp keyword!(fields) do
+    pairs? = Enum.all?(fields, &match?({key, _} when is_atom(key), &1))
+    shaped!(pairs?, fields)
+  end
+
+  defp shaped!(false, fields), do: raise(ArgumentError, "#{takes()}, got: #{inspect(fields)}")
+
+  defp shaped!(true, fields) do
+    keys = Keyword.keys(fields)
+    unknown = Enum.reject(keys, &(&1 in @parts))
+    twice = keys -- Enum.uniq(keys)
+    once!(unknown, twice, fields)
+  end
+
+  defp once!([key | _], _twice, _fields),
+    do: raise(ArgumentError, "#{takes()}: `#{key}:` is not one of them")
+
+  defp once!([], [key | _], _fields),
+    do: raise(ArgumentError, "#{takes()}: `#{key}:` is given twice")
+
+  defp once!([], [], fields), do: fields
+
+  # The struct, each part as given but for the elements' own shape: check/1 judges every
+  # value, so a junk one is a problem it lists, never an exception here.
+  defp built(fields),
+    do: %__MODULE__{
+      name: Keyword.get(fields, :name),
+      programs: programs(Keyword.get(fields, :programs, [])),
+      tasks: from_elixir(:tasks, Keyword.get(fields, :tasks, [])),
+      globals: from_elixir(:globals, Keyword.get(fields, :globals, [])),
+      instances: from_elixir(:instances, Keyword.get(fields, :instances, [])),
+      connections: from_elixir(:connections, Keyword.get(fields, :connections, []))
+    }
+
+  # Programs come as a list, each kept under its own name, so no key can differ from its
+  # program's name. What is not a named program, or a second of one name, is kept aside
+  # under a key no name has, `{:at, n}`, for check/1 to report.
+  defp programs(list) when is_list(list) do
+    {map, _n} =
+      Enum.reduce(list, {%{}, 0}, fn program, {map, n} -> {placed(program, map, n), n + 1} end)
+
+    map
+  end
+
+  defp programs(other), do: %{{:at, 0} => {:not_a_list, other}}
+
+  defp placed(%Program{name: name} = program, map, _n)
+       when is_binary(name) and not is_map_key(map, name),
+       do: Map.put(map, name, program)
+
+  defp placed(other, map, n), do: Map.put(map, {:at, n}, other)
+
+  # An element from Elixir has no line: one that brings one is kept whole, for check/1 to
+  # refuse, since a line is what marks an element read from a file.
+  defp from_elixir(part, list) when is_list(list), do: Enum.map(list, &without_line(part, &1))
+  defp from_elixir(_part, other), do: other
+
+  defp without_line(part, %{line: _} = map) when not is_struct(map),
+    do: {:line_from_elixir, part, map}
+
+  defp without_line(part, element), do: normal(part, element)
+
+  @doc """
+  Every problem with `config`, as `{line, message}`: the name's, then each program's, each
+  task's, each global's, each instance's, each name's that clashes with another, each
+  connection's, and each var_input's left unconnected, each in its part's order. `line` is
+  the line of the element the problem cites, nil for one from Elixir. A configuration with
+  none is one `Logex.Runtime.start/1` runs.
+  """
+  def check(%__MODULE__{} = config) do
+    tasks = normals(:tasks, config.tasks)
+    globals = normals(:globals, config.globals)
+    instances = normals(:instances, config.instances)
+    connections = normals(:connections, config.connections)
+    programs = usable(config.programs)
+    task_names = names_of(tasks)
+
+    Enum.flat_map(
+      [
+        configuration_name(config.name),
+        program_problems(config.programs),
+        each(:tasks, tasks, &task_problems/1),
+        each(:globals, globals, &global_problems/1),
+        shared_points(elements(globals)),
+        each(:instances, instances, &instance_problems(&1, programs, task_names)),
+        none_run(instances),
+        clashes(namespace(elements(tasks), elements(globals), elements(instances))),
+        each(:connections, connections, fn _connection -> [] end),
+        wiring(
+          elements(connections),
+          elements(instances),
+          programs,
+          {elements(globals), task_names}
+        )
+      ],
+      & &1
+    )
+  end
+
+  def check(other),
+    do:
+      raise(
+        ArgumentError,
+        "expected a %Logex.Configuration{} from Logex.Configuration.new!/1, got: " <>
+          inspect(other)
+      )
+
+  # ---- the shape of each part and element -------------------------------------------
+
+  # A part as check/1 reads it: `{:not_a_list, other}`, or each element made normal, a
+  # map of every key of its part, or a mark of what is wrong with it.
+  defp normals(_part, {:not_a_list, _other} = marked), do: marked
+  defp normals(part, list) when is_list(list), do: Enum.map(list, &normal(part, &1))
+  defp normals(_part, other), do: {:not_a_list, other}
+
+  defp normal(_part, {:line_from_elixir, _part2, _map} = marked), do: marked
+  defp normal(_part, {:not_an_element, _other} = marked), do: marked
+  defp normal(_part, {:extra_keys, _keys, _map} = marked), do: marked
+
+  defp normal(part, %{} = map) when not is_struct(map) do
+    {required, optional} = Map.fetch!(@keys, part)
+    allowed = [:line | required ++ optional]
+    extra = map |> Map.keys() |> Enum.reject(&(&1 in allowed))
+    normal_keys(extra, Map.merge(Map.from_keys(allowed, nil), map), map)
+  end
+
+  defp normal(_part, other), do: {:not_an_element, other}
+
+  defp normal_keys([], element, _map), do: element
+  defp normal_keys(extra, _element, map), do: {:extra_keys, Enum.sort(extra), map}
+
+  defp elements({:not_a_list, _other}), do: []
+  defp elements(list), do: Enum.filter(list, &(is_map(&1) and not is_struct(&1)))
+
+  defp each(part, {:not_a_list, other}, _problems),
+    do: [{nil, "#{part}: must be a list, as in [#{@example[part]}], got: #{inspect(other)}"}]
+
+  defp each(part, list, problems), do: Enum.flat_map(list, &element_problems(part, &1, problems))
+
+  defp element_problems(part, {:line_from_elixir, _part, map}, _problems),
+    do: [{nil, "#{article(@kind[part])} from Elixir has no line, got: #{inspect(map)}"}]
+
+  defp element_problems(part, {:not_an_element, other}, _problems),
+    do: [
+      {nil,
+       "#{part}: #{inspect(other)} is not #{article(@kind[part])}: " <>
+         "#{article(@kind[part])} is a map, " <>
+         "as in #{@example[part]}"}
+    ]
+
+  defp element_problems(part, {:extra_keys, keys, map}, _problems) do
+    {required, optional} = Map.fetch!(@keys, part)
+
+    [
+      {nil,
+       "#{@kind[part]} #{inspect(map)} has #{keys_text(keys)}: #{article(@kind[part])} has " <>
+         keys_text(required ++ optional)}
+    ]
+  end
+
+  defp element_problems(part, element, problems) do
+    {required, _optional} = Map.fetch!(@keys, part)
+
+    missing =
+      for key <- required, element[key] == nil do
+        {element.line,
+         "#{@kind[part]} #{inspect(Map.delete(element, :line))} has no #{key}:, " <>
+           "as in #{@example[part]}"}
+      end
+
+    missing ++ problems.(element)
+  end
+
+  defp keys_text(keys), do: keys |> Enum.map(&"#{&1}:") |> listed()
+
+  # ---- the name and the programs ------------------------------------------------------
+
+  defp configuration_name(nil), do: [{nil, ~s|a configuration needs a name, as in name: "plant"|}]
+  defp configuration_name(name), do: named(name, "a configuration", nil)
+
+  defp named(nil, _what, _line), do: []
+
+  defp named(name, what, line),
+    do: shape(is_binary(name) and Declarations.name?(name), name, what, line)
+
+  defp shape(true, _name, _what, _line), do: []
+
+  defp shape(false, name, what, line),
+    do: [{line, "#{inspect(name)} cannot name #{what}: #{rule()}"}]
+
+  defp rule, do: "a name is a letter or `_`, then letters, digits or `_`"
+
+  # The tasks an instance may name, or `:unknown` where the part is not a list, whose
+  # problem is reported once: an instance that names a task is then not reported too.
+  defp names_of({:not_a_list, _other}), do: :unknown
+  defp names_of(list), do: for(%{name: name} <- elements(list), is_binary(name), do: name)
+
+  # The programs check/1 can look into, each well-formed under its own name, or `:unknown`
+  # where the part is not a list, as for the tasks.
+  defp usable(%{{:at, 0} => {:not_a_list, _}}), do: :unknown
+
+  defp usable(%{} = programs) when not is_struct(programs),
+    do:
+      for(
+        {name, %Program{name: name, tags: tags, rungs: rungs} = program} <- programs,
+        is_binary(name) and is_map(tags) and is_list(rungs),
+        into: %{},
+        do: {name, program}
+      )
+
+  defp usable(_programs), do: :unknown
+
+  defp program_problems(%{} = programs) when not is_struct(programs),
+    do: programs |> Enum.sort_by(&program_order/1) |> Enum.flat_map(&program_problem/1)
+
+  defp program_problems(other), do: [{nil, not_programs(other)}]
+
+  defp not_programs(other),
+    do: "programs: must be a list of programs from Logex.compile/2, got: #{inspect(other)}"
+
+  defp program_order({{:at, n}, _}), do: {0, n}
+  defp program_order({name, _}), do: {1, name}
+
+  defp program_problem({{:at, _n}, {:not_a_list, other}}), do: [{nil, not_programs(other)}]
+
+  defp program_problem({{:at, _n}, %Program{name: name}}) when is_binary(name),
+    do: [{nil, "two programs are named `#{name}`: a configuration names each program type once"}]
+
+  defp program_problem({{:at, _n}, %Program{}}),
+    do: [{nil, "a program in a configuration needs a name: compile it with Logex.compile/2"}]
+
+  defp program_problem({{:at, _n}, other}),
+    do: [{nil, "programs: #{inspect(other)} is not a %Logex.Program{} from Logex.compile/2"}]
+
+  defp program_problem({name, %Program{name: name, tags: tags, rungs: rungs}})
+       when is_map(tags) and is_list(rungs),
+       do: []
+
+  defp program_problem({name, other}),
+    do: [
+      {nil,
+       "programs: #{inspect(name)} is not a %Logex.Program{} from Logex.compile/2: #{inspect(other)}"}
+    ]
+
+  # ---- tasks ----------------------------------------------------------------------------
+
+  defp task_problems(%{name: name, interval: interval, priority: priority, line: line}),
+    do:
+      named(name, "a task", line) ++
+        interval(name, interval, line) ++ priority(name, priority, line)
+
+  defp interval(_name, nil, _line), do: []
+  defp interval(_name, ms, _line) when is_integer(ms) and ms in 1..@dint_max//1, do: []
+
+  defp interval(name, ms, line),
+    do: [{line, "task #{label(name)}: its interval is 1 to #{@dint_max} ms, got: #{inspect(ms)}"}]
+
+  defp priority(_name, nil, _line), do: []
+  defp priority(_name, p, _line) when is_integer(p) and p in 0..@dint_max//1, do: []
+
+  defp priority(name, p, line),
+    do: [
+      {line,
+       "task #{label(name)}: its priority is 0, the highest, to #{@dint_max}, got: #{inspect(p)}"}
+    ]
+
+  # ---- globals --------------------------------------------------------------------------
+
+  defp global_problems(%{name: name, type: type, at: at, line: line} = global),
+    do:
+      named(name, "a global", line) ++
+        global_type(name, type, line) ++
+        location_problem(name, at, location(at), line) ++
+        initial(global, location(at) == {:ok, :input}, line)
+
+  defp global_type(_name, type, _line) when type in [nil, :bool, :dint], do: []
+
+  defp global_type(name, type, line),
+    do: [{line, "global #{label(name)}: its type is :bool or :dint, got: #{inspect(type)}"}]
+
+  defp location_problem(_name, nil, _found, _line), do: []
+  defp location_problem(_name, _at, {:ok, _kind}, _line), do: []
+
+  defp location_problem(name, at, :error, line),
+    do: [
+      {line,
+       "global #{label(name)}: a location is a device, `i` or `q`, then one or more " <>
+         ~s|address fields, as in "panel.q.0", got: #{inspect(at)}|}
+    ]
+
+  @doc """
+  What a location names: `{:ok, :input}` for an input point, `"<device>.i.<field>…"`,
+  `{:ok, :output}` for an output point, `"<device>.q.<field>…"`, or `:error`. The device
+  is one name, and each address field a whole number written without a leading zero, so
+  that one point has one spelling.
+  """
+  def location(at) when is_binary(at), do: address(String.split(at, "."))
+  def location(_at), do: :error
+
+  defp address([device, kind, field | fields]),
+    do: point(Declarations.name?(device) and Enum.all?([field | fields], &field?/1), kind)
+
+  defp address(_parts), do: :error
+
+  defp field?("0"), do: true
+  defp field?(field), do: String.match?(field, ~r/\A[1-9][0-9]*\z/)
+
+  defp point(true, "i"), do: {:ok, :input}
+  defp point(true, "q"), do: {:ok, :output}
+  defp point(_valid, _kind), do: :error
+
+  defp initial(%{initial: nil}, _input?, _line), do: []
+
+  defp initial(%{name: name}, true, line),
+    do: [
+      {line,
+       "#{label(name)} is an input point: its value comes from outside, so it takes no " <>
+         "initial value"}
+    ]
+
+  defp initial(%{name: name, initial: v}, false, line) when not is_integer(v),
+    do: [
+      {line, "global #{label(name)}: its initial value must be an integer, got: #{inspect(v)}"}
+    ]
+
+  defp initial(%{name: name, type: type, initial: v}, false, line) when type in [:bool, :dint],
+    do: at_line(fit(type, v, "#{label(name)} is a #{type}: its initial value"), line)
+
+  defp initial(_global, false, _line), do: []
+
+  # One rule for a value against its type, for a global's initial value and a constant.
+  defp fit(_type, v, subject) when v < 0,
+    do: [
+      "#{subject} `#{v}` is negative, which no configuration line can say until a negative " <>
+        "literal lexes"
+    ]
+
+  defp fit(type, v, subject), do: fits(Declarations.fits?(type, v), type, v, subject)
+
+  defp fits(true, _type, _v, _subject), do: []
+  defp fits(false, :bool, v, subject), do: ["#{subject} must be 0 or 1, found `#{v}`"]
+  defp fits(false, :dint, v, subject), do: ["#{subject} `#{v}` does not fit in 32 bits"]
+
+  defp at_line(messages, line), do: Enum.map(messages, &{line, &1})
+
+  # Two globals at one location would be two images of one point.
+  defp shared_points(globals) do
+    {problems, _seen} =
+      Enum.flat_map_reduce(globals, %{}, fn global, seen -> shared_point(global, seen) end)
+
+    problems
+  end
+
+  defp shared_point(%{at: at, name: name, line: line}, seen) when is_binary(at),
+    do: first_at(Map.get(seen, at), at, name, line, seen)
+
+  defp shared_point(_global, seen), do: {[], seen}
+
+  defp first_at(nil, at, name, _line, seen), do: {[], Map.put(seen, at, name)}
+
+  defp first_at(first, at, name, line, seen),
+    do:
+      {[
+         {line,
+          "#{label(name)} is at `#{at}`, where #{label(first)} already is: a point has one global"}
+       ], seen}
+
+  # ---- instances ------------------------------------------------------------------------
+
+  defp instance_problems(%{name: name, type: type, task: task, line: line}, programs, tasks),
+    do:
+      named(name, "an instance", line) ++
+        program_of(name, type, programs, line) ++ task_of(name, task, tasks, line)
+
+  defp program_of(_name, nil, _programs, _line), do: []
+  defp program_of(_name, _type, :unknown, _line), do: []
+  defp program_of(_name, type, programs, _line) when is_map_key(programs, type), do: []
+
+  defp program_of(name, type, programs, line) when is_binary(type),
+    do: [
+      {line,
+       "#{label(name)} is an instance of `#{type}`, but no program is named `#{type}`" <>
+         among(type, Map.keys(programs), "programs")}
+    ]
+
+  defp program_of(name, type, _programs, line),
+    do: [
+      {line,
+       "instance #{label(name)}: its type is the name of one of the configuration's " <>
+         "programs, got: #{inspect(type)}"}
+    ]
+
+  defp task_of(_name, nil, _tasks, _line), do: []
+  defp task_of(_name, task, :unknown, _line) when is_binary(task), do: []
+
+  defp task_of(name, task, tasks, line) when is_binary(task),
+    do: known_task(task in tasks, name, task, tasks, line)
+
+  defp task_of(name, task, _tasks, line),
+    do: [
+      {line,
+       "instance #{label(name)}: its task is the name of a task, or nil for none, got: " <>
+         inspect(task)}
+    ]
+
+  defp known_task(true, _name, _task, _tasks, _line), do: []
+
+  defp known_task(false, name, task, tasks, line),
+    do: [
+      {line,
+       "#{label(name)} runs under `#{task}`, but no task is named `#{task}`" <>
+         among(task, tasks, "tasks")}
+    ]
+
+  # IEC 61131-3 requires at least one program in a configuration (Ed 2 Annex B.1.7).
+  defp none_run([]), do: [{nil, "a configuration runs at least one instance, got: instances: []"}]
+  defp none_run(_instances), do: []
+
+  # ---- one namespace --------------------------------------------------------------------
+
+  # Globals, then instances, then tasks, each `{name, kind, line}` in declaration order.
+  defp namespace(tasks, globals, instances),
+    do:
+      for(
+        {list, kind} <- [{globals, "global"}, {instances, "instance"}, {tasks, "task"}],
+        %{name: name, line: line} <- list,
+        is_binary(name) and Declarations.name?(name),
+        do: {name, kind, line}
