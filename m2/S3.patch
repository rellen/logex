+      {problems ++
+         ["`#{member}` is already connected, to #{shown(first)}: a var_input has one source"],
+       seen}
+
+  defp shown(constant) when is_integer(constant), do: "the constant `#{constant}`"
+  defp shown(global) when is_binary(global), do: "`#{global}`"
