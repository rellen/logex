+  defp sunk([_ | _] = problems, _member, _to, seen, _world), do: {problems, seen}
+
+  defp sunk([], member, to, seen, %{globals: globals}),
+    do: drives(location(Map.fetch!(globals, to).at) == {:ok, :input}, member, to, seen)
+
+  defp drives(true, member, to, seen),
+    do: {["`#{to}` is an input point: `#{member}` cannot drive it"], seen}
+
+  defp drives(false, member, to, {sources, sinks}),
