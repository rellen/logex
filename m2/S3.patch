+      for(
+        %{name: name, type: type, line: line} <- instances,
+        is_binary(name),
+        %Program{tags: tags} <- [Map.get(programs, type)],
+        %Tag{section: :var_input, name: var} <- by_line(tags),
+        not is_map_key(sources, "#{name}.#{var}"),
