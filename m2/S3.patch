+
+    # A 10 ms task declared first at priority 2, a 30 ms task at priority 1, and a
+    # task-less instance: `b` (30 ms) passes the input point on to `a` (10 ms), and `a` to
+    # `c`, whose echo is the output point `out`. Priority, not declaration, puts `b` first.
+    defp plant do
+      {:ok, stamp} = Logex.compile(@stamp, name: "stamp")
+
+      Configuration.new!(
+        name: "plant",
+        programs: [stamp],
+        tasks: [
+          %{name: "fast", interval: 10, priority: 2},
+          %{name: "slow", interval: 30, priority: 1}
+        ],
+        globals: [
+          %{name: "in", type: :bool, at: "panel.i.0"},
+          %{name: "g1", type: :bool},
+          %{name: "g2", type: :bool},
+          %{name: "out", type: :bool, at: "panel.q.0"},
+          %{name: "busy_a", type: :dint, at: "panel.q.1"},
+          %{name: "busy_b", type: :dint, at: "panel.q.2"},
+          %{name: "busy_c", type: :dint, at: "panel.q.3"}
+        ],
+        instances: [
+          %{name: "a", type: "stamp", task: "fast"},
+          %{name: "b", type: "stamp", task: "slow"},
+          %{name: "c", type: "stamp"}
+        ],
+        connections: [
+          %{member: "a.go", to: 1},
+          %{member: "a.seen", to: "g1"},
+          %{member: "a.echo", to: "g2"},
+          %{member: "a.busy", to: "busy_a"},
+          %{member: "b.go", to: 1},
+          %{member: "b.seen", to: "in"},
+          %{member: "b.echo", to: "g1"},
+          %{member: "b.busy", to: "busy_b"},
+          %{member: "c.go", to: 1},
+          %{member: "c.seen", to: "g2"},
+          %{member: "c.echo", to: "out"},
+          %{member: "c.busy", to: "busy_c"}
+        ]
+      )
+    end
+
+    # Cycles a runtime through `{elapsed_ms, inputs}` steps: `{trace, runtime}`, each trace
+    # entry `{now, outputs, events}`. The plant's task-less `c` runs in every cycle, so its
+    # event gives the cycle's time.
+    defp cycled(rt, steps),
+      do:
+        Enum.map_reduce(steps, rt, fn {elapsed, inputs}, rt ->
+          {rt, outputs, events} = Runtime.cycle(rt, elapsed, inputs)
+          [{:ran, :none, "c", now}] = Enum.take(events, -1)
+          {{now, outputs, events}, rt}
+        end)
+
+    defp ran(trace, instance),
+      do: for({_now, _out, events} <- trace, {:ran, _, ^instance, now} <- events, do: now)
+
+    defp first_high(trace, point),
+      do: Enum.find_value(trace, fn {now, outputs, _} -> outputs[point] == 1 && now end)
+
+    # PLAN.md M2-1's Done-when, first part. One simulated second is the cycles at 0, 10,
+    # ..., 990 ms, the half-open second M2-3's counts read too (100 runs every 10 ms, 20
+    # every 50 ms), its first cycle at 0 ms, as next_due_in/1 asks after start/1.
+    test "Done-when: a 10 ms task, a 30 ms task and a task-less instance, cycled for one " <>
+           "simulated second by an injected clock, run each instance exactly as often as " <>
+           "its task dictates, in priority order" do
+      rt = Runtime.start(plant())
+      assert Runtime.next_due_in(rt) == 0
+
+      input = fn t -> %{"in" => Enum.count([600], &(t >= &1))} end
+      {trace, rt} = cycled(rt, [{0, input.(0)} | for(t <- 10..990//10, do: {10, input.(t)})])
+
+      assert ran(trace, "a") == Enum.to_list(0..990//10)
+      assert ran(trace, "b") == Enum.to_list(0..990//30)
+      assert ran(trace, "c") == Enum.to_list(0..990//10)
+      assert Enum.map(~w(a b c), &length(ran(trace, &1))) == [100, 34, 100]
+
+      # In every cycle the 30 ms task, priority 1, runs before the 10 ms one, priority 2,
+      # though declared after it, and the task-less instance runs last; nothing overlaps.
+      for {now, _outputs, events} <- trace do
+        slow = for 0 <- [rem(now, 30)], do: {:ran, "slow", "b", now}
+        assert events == slow ++ [{:ran, "fast", "a", now}, {:ran, :none, "c", now}], "#{now} ms"
+      end
+
+      # The order has its effect: the input rises at 600 ms, when `b` runs, and reaches
+      # `out` through `b`, `a` and `c` in that one cycle, each seeing what the one before
+      # it wrote. Run fast-first, it would reach `out` 10 ms later.
+      assert first_high(trace, "out") == 600
+
+      # Each instance's timer counts the time between its own scans: at 980 ms `b` last
+      # ran at 960.
+      assert {980, %{"busy_a" => 980, "busy_b" => 960, "busy_c" => 980}, _} =
+               List.keyfind(trace, 980, 0)
+
+      assert Runtime.overlaps(rt) == %{"fast" => 0, "slow" => 0}
+      assert Runtime.next_due_in(rt) == 10
+    end
+
+    # PLAN.md M2-1's Done-when, second part: the host is 25 ms late once. The 10 ms task,
+    # due at 110 ms, runs once at 135 ms and reports the two periods it missed, its runs
+    # due at 110 and 120 coalesced with 130's; the 30 ms task, due at 120, runs at 135 and
+    # misses none. Neither loses its phase: afterwards each runs at the multiples of its
+    # interval.
+    test "Done-when: a late cycle yields one {:overlap, ...} and no lost phase" do
+      {early, rt} = cycled(Runtime.start(plant()), [{0, %{}} | List.duplicate({10, %{}}, 10)])
+      assert for({_, _, events} <- early, {:overlap, _, _} = e <- events, do: e) == []
+
+      {[{135, _outputs, late}], rt} = cycled(rt, [{35, %{}}])
+
+      assert late == [
+               {:overlap, "fast", 2},
+               {:ran, "slow", "b", 135},
+               {:ran, "fast", "a", 135},
+               {:ran, :none, "c", 135}
+             ]
+
+      assert Runtime.next_due_in(rt) == 5
+
+      {after_it, rt} = cycled(rt, List.duplicate({5, %{}}, 33))
+      assert for({_, _, events} <- after_it, {:overlap, _, _} = e <- events, do: e) == []
+      assert ran(after_it, "a") == Enum.to_list(140..300//10)
+      assert ran(after_it, "b") == Enum.to_list(150..300//30)
+      assert ran(after_it, "c") == Enum.to_list(140..300//5)
+      assert Runtime.overlaps(rt) == %{"fast" => 2, "slow" => 0}
+    end
+
+    # The program as a one-instance configuration: one task-less instance, its var_inputs
+    # connected to input points and its var_outputs to output points of the same names,
+    # so the two output maps compare whole.
+    defp one_instance(program) do
+      points =
+        for %Logex.Tag{name: name, type: type, section: section, line: line} <-
+              Map.values(program.tags),
+            section in [:var_input, :var_output],
+            do: %{name: name, type: type, at: "panel.#{point_kind(section)}.#{line}"}
+
+      Configuration.new!(
+        name: "lone",
+        programs: [program],
+        globals: points,
+        instances: [%{name: "m1", type: program.name}],
+        connections: for(%{name: name} <- points, do: %{member: "m1.#{name}", to: name})
+      )
+    end
+
+    defp point_kind(:var_input), do: "i"
+    defp point_kind(:var_output), do: "q"
+
+    # Each step through put_inputs/3 and scan/3 on one side, and cycle/3 with the same
+    # inputs on the other: the same outputs, and the same latched `fault`.
+    defp agree(motor, state, rt, steps, elapsed) do
+      steps
+      |> Enum.with_index()
+      |> Enum.reduce({state, rt}, fn {inputs, i}, {state, rt} ->
+        step = elapsed * min(i, 1)
+        state = Logex.Runtime.put_inputs(motor, state, inputs)
+        {outputs, state} = Logex.Runtime.scan(motor, state, step)
+        {rt, through_configuration, _events} = Runtime.cycle(rt, step, inputs)
+        assert through_configuration == outputs, "step #{i}"
+        assert Runtime.get(rt, "m1.fault") == state.env["fault"], "step #{i}"
+        {state, rt}
+      end)
+    end
+
+    # PLAN.md M2-1's Done-when, third part: the README program gives identical outputs
+    # through scan/2 and through a one-instance configuration, step by step, its latched
+    # `fault` too, and again after a restart of each, which keeps the inputs in both
+    # (docs/organisation.md §4.6, on restart/3).
+    test "Done-when: the README program gives identical outputs through scan/2 and through " <>
+           "a one-instance configuration" do
+      {:ok, motor} = Logex.compile(@readme_motor, name: "motor")
+      rt = Runtime.start(one_instance(motor))
+      state = Logex.Runtime.instance(motor)
+      {state, rt} = agree(motor, state, rt, @readme_steps, 0)
+
+      state = Logex.Runtime.restart(motor, state, :cold)
+      rt = Runtime.restart(rt, :cold)
+      agree(motor, state, rt, Enum.reverse(@readme_steps), 0)
+    end
+
+    # And through scan/3 with time: the M2-3 motor's timer counts the same time.
+    test "the M2-3 motor gives identical outputs through scan/3 and through a one-instance " <>
+           "configuration, its timer counting the same time" do
+      {:ok, motor} = Logex.compile(@m23_motor, name: "motor")
+      rt = Runtime.start(one_instance(motor))
+      state = Logex.Runtime.instance(motor)
+      steps = [%{"start" => 1}, %{"start" => 0} | List.duplicate(%{}, 40)]
+      {state, rt} = agree(motor, state, rt, steps, 130)
+      assert {state.env["t1"]["acc"], Runtime.get(rt, "m1.t1.acc")} == {5000, 5000}
+    end
+  end
 end
