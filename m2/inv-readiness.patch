+# Probe 3: what today's compiler says to M2's words, and where a file name goes.
+defmodule Probe4 do
+  def count(f) do
+    for _ <- 1..20, do: f.()
+    Enum.min(for _ <- 1..100 do
+      {:reductions, a} = Process.info(self(), :reductions)
+      f.()
+      {:reductions, b} = Process.info(self(), :reductions)
+      b - a
+    end)
+  end
+  def outs(tags), do: for({name, %Logex.Tag{section: :var_output}} <- tags, into: %{}, do: {name, 0})
+end
+
+show = fn label, src ->
+  IO.puts("-- #{label}")
+  case Logex.compile(src, name: "probe") do
+    {:ok, p} -> IO.puts("   ok; warnings: #{inspect(Enum.map(p.warnings, &Logex.Diagnostic.format/1))}")
+    {:error, ds} -> Enum.each(ds, &IO.puts("   " <> Logex.Diagnostic.format(&1)))
+  end
+end
+
+show.("cal on a bool", "var_input a bool\nvar_input b bool\nvar_output q bool\nvar s1 bool\ncal s1 a b q")
+show.("function_block header", "function_block seal\nvar_input start bool\nvar_output run bool\nxic start ote run")
+show.("var_external", "var_external estop bool\nvar_output q bool\nxic estop ote q")
+show.("var s1 seal", "var s1 seal\nvar_output q bool\nxic s1.run ote q")
+show.("var_global in .ld", "var_global k1 bool\nvar_output q bool\nxic k1 ote q")
+show.("task as a tag", "var_input task bool\nvar_output with bool\nxic task ote with")
+show.("program as a tag", "var_input program bool\nvar_output at bool\nxic program ote at")
+show.("a .lcf body as .ld", "task fast interval 10 priority 1\nprogram m1 motor with fast\nm1.start pb_start_1")
+
+dir = Path.join(System.tmp_dir!(), "logex-probe-#{System.unique_integer([:positive])}")
+File.mkdir_p!(dir)
+for {file, src} <- [{"seal.txt", "var_input a bool\nvar_output q bool\nxic a ote q"},
+                    {"plant.lcf", "var_input a bool\nvar_output q bool\nxic a ote q"},
+                    {"motor.ld", "var_input a bool\nvar_output q bool\nxic a ote qq"},
+                    {"m.v2.ld", "var_input a bool\nvar_output q bool\nxic a ote q"}] do
+  path = Path.join(dir, file)
+  File.write!(path, src)
+  IO.puts("-- compile_file #{file}")
+  case Logex.compile_file(path) do
+    {:ok, p} -> IO.puts("   ok: name #{inspect(p.name)}; Program keys #{inspect(Map.keys(Map.from_struct(p)))}")
+    {:error, ds} -> Enum.each(ds, &IO.puts("   file=#{inspect(&1.file)} " <> &1.message))
+  end
+end
+
+# F15: an :edit diagnostic from a candidate read from a file carries no file.
+File.write!(Path.join(dir, "motor.ld"), "var_input a bool\nvar_output q bool\nxic a ote q")
+File.write!(Path.join(dir, "motor2.ld"), "var_input a bool\nvar_output q dint\nxic a move 1 q")
+{:ok, run} = Logex.compile_file(Path.join(dir, "motor.ld"))
+{:ok, cand} = Logex.compile(File.read!(Path.join(dir, "motor2.ld")), name: "motor")
+{:error, [d]} = Logex.Edit.accept(run, cand, Logex.Runtime.instance(run))
+IO.puts("-- F15: :edit diagnostic file=#{inspect(d.file)} formats as #{inspect(Logex.Diagnostic.format(d))}")
