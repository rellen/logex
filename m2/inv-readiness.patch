diff --git a/probe/call_cost.exs b/probe/call_cost.exs
new file mode 100644
index 0000000..8e57e06
--- /dev/null
+++ b/probe/call_cost.exs
@@ -0,0 +1,98 @@
+# Probe 2: the cost of one call/4 of the README motor, in reductions (least of N), as a
+# baseline for M2-1's scheduler; and how that cost splits.
+alias Logex.{Runtime, Scan}
+
+motor_src = """
+var_input start bool
+var_input stop bool
+var_input overtemp bool
+var_input reset bool
+var_output motor bool
+var_output run_lamp bool
+var_output speed_sp dint 1200
+var fault bool
+
+( xic start | xic motor ) xio stop ote motor
+xic motor ote run_lamp
+xic overtemp otl fault
+xic reset otu fault
+xic fault move 0 speed_sp
+"""
+
+{:ok, motor} = Logex.compile(motor_src, name: "motor")
+state0 = Runtime.instance(motor)
+{_, state} = Runtime.call(motor, state0, %{"start" => 1}, %Scan{now: 0, first: true})
+
+measure = fn label, f ->
+  # warm
+  for _ <- 1..50, do: f.()
+  counts =
+    for _ <- 1..200 do
+      {:reductions, a} = Process.info(self(), :reductions)
+      f.()
+      {:reductions, b} = Process.info(self(), :reductions)
+      b - a
+    end
+  sorted = Enum.sort(counts)
+  IO.puts(
+    String.pad_trailing(label, 58) <>
+      "min #{hd(sorted)}  median #{Enum.at(sorted, 100)}  max #{List.last(sorted)}"
+  )
+  hd(sorted)
+end
+
+IO.puts("== README motor, 8 tags, 5 rungs ==")
+measure.("call/4, no inputs", fn -> Runtime.call(motor, state, %{}, %Scan{now: 10, first: false}) end)
+measure.("call/4, 4 inputs (copy-in of every var_input)", fn ->
+  Runtime.call(motor, state, %{"start" => 0, "stop" => 0, "overtemp" => 0, "reset" => 0}, %Scan{now: 10, first: false})
+end)
+measure.("call/4, 1 input", fn -> Runtime.call(motor, state, %{"start" => 0}, %Scan{now: 10, first: false}) end)
+measure.("scan/3 (sugar), 10 ms", fn -> Runtime.scan(motor, state, 10) end)
+measure.("put_inputs/3, 4 inputs", fn ->
+  Runtime.put_inputs(motor, state, %{"start" => 0, "stop" => 0, "overtemp" => 0, "reset" => 0})
+end)
+measure.("put_inputs/3, no inputs (= the checks alone)", fn -> Runtime.put_inputs(motor, state, %{}) end)
+measure.("instance/1", fn -> Runtime.instance(motor) end)
+measure.("restart/3", fn -> Runtime.restart(motor, state, :cold) end)
+measure.("Logex.compile/2 of the motor", fn -> Logex.compile(motor_src, name: "motor") end)
+
+# How a call/4 scales with what a scheduler holds: N copies of the motor's tags in one
+# program (so N x tags, N x rungs), to see whether per-scan cost is in rungs or in tags.
+big = fn n ->
+  decl =
+    Enum.map_join(1..n, "\n", fn i ->
+      "var_input start#{i} bool\nvar_input stop#{i} bool\nvar_input overtemp#{i} bool\n" <>
+        "var_input reset#{i} bool\nvar_output motor#{i} bool\nvar_output run_lamp#{i} bool\n" <>
+        "var_output speed_sp#{i} dint 1200\nvar fault#{i} bool"
+    end)
+
+  rungs =
+    Enum.map_join(1..n, "\n", fn i ->
+      "( xic start#{i} | xic motor#{i} ) xio stop#{i} ote motor#{i}\nxic motor#{i} ote run_lamp#{i}\n" <>
+        "xic overtemp#{i} otl fault#{i}\nxic reset#{i} otu fault#{i}\nxic fault#{i} move 0 speed_sp#{i}"
+    end)
+
+  {:ok, p} = Logex.compile(decl <> "\n" <> rungs, name: "big")
+  p
+end
+
+IO.puts("\n== N motors in one program (8N tags, 5N rungs) ==")
+for n <- [1, 10, 100] do
+  p = big.(n)
+  s = Runtime.instance(p)
+  {_, s} = Runtime.call(p, s, %{}, %Scan{now: 0, first: true})
+  measure.("call/4, N=#{n}, no inputs", fn -> Runtime.call(p, s, %{}, %Scan{now: 10, first: false}) end)
+end
+
+# N instances of the motor, each called once, as a scheduler's cycle would: the cost of a
+# cycle is the sum of the calls, nothing shared.
+IO.puts("\n== N instances of the motor, one call/4 each (a cycle by hand) ==")
+for n <- [1, 10, 100] do
+  states = Map.new(1..n, fn i -> {"m#{i}", state} end)
+  measure.("N=#{n} instances, call/4 each, 1 input each", fn ->
+    Enum.reduce(states, {%{}, %{}}, fn {name, s}, {outs, acc} ->
+      {o, s} = Runtime.call(motor, s, %{"start" => 0}, %Scan{now: 10, first: false})
+      {Map.put(outs, name, o), Map.put(acc, name, s)}
+    end)
+  end)
+end
diff --git a/probe/call_cost2.exs b/probe/call_cost2.exs
new file mode 100644
index 0000000..d2e1f0e
--- /dev/null
+++ b/probe/call_cost2.exs
@@ -0,0 +1,144 @@
+# Probe 2b: as call_cost.exs, but every measured call is in a compiled module, so no
+# interpreted closure body is counted.
+defmodule Probe do
+  alias Logex.{Runtime, Scan}
+
+  @motor """
+  var_input start bool
+  var_input stop bool
+  var_input overtemp bool
+  var_input reset bool
+  var_output motor bool
+  var_output run_lamp bool
+  var_output speed_sp dint 1200
+  var fault bool
+
+  ( xic start | xic motor ) xio stop ote motor
+  xic motor ote run_lamp
+  xic overtemp otl fault
+  xic reset otu fault
+  xic fault move 0 speed_sp
+  """
+
+  def motor, do: @motor
+
+  def count(f) do
+    for _ <- 1..50, do: f.()
+
+    counts =
+      for _ <- 1..200 do
+        {:reductions, a} = Process.info(self(), :reductions)
+        f.()
+        {:reductions, b} = Process.info(self(), :reductions)
+        b - a
+      end
+
+    Enum.min(counts)
+  end
+
+  # The empty measurement: what count/1 charges for calling a fun that does nothing.
+  def nothing, do: :ok
+
+  def call0(p, s), do: Runtime.call(p, s, %{}, %Scan{now: 10, first: false})
+  def call1(p, s), do: Runtime.call(p, s, %{"start" => 0}, %Scan{now: 10, first: false})
+
+  def call4(p, s),
+    do:
+      Runtime.call(
+        p,
+        s,
+        %{"start" => 0, "stop" => 0, "overtemp" => 0, "reset" => 0},
+        %Scan{now: 10, first: false}
+      )
+
+  def scan3(p, s), do: Runtime.scan(p, s, 10)
+  def put0(p, s), do: Runtime.put_inputs(p, s, %{})
+
+  def put4(p, s),
+    do: Runtime.put_inputs(p, s, %{"start" => 0, "stop" => 0, "overtemp" => 0, "reset" => 0})
+
+  def inst(p), do: Runtime.instance(p)
+  def restart(p, s), do: Runtime.restart(p, s, :cold)
+  def compile, do: Logex.compile(@motor, name: "motor")
+
+  def cycle(p, states) do
+    Enum.reduce(states, {%{}, %{}}, fn {name, s}, {outs, acc} ->
+      {o, s} = Runtime.call(p, s, %{"start" => 0}, %Scan{now: 10, first: false})
+      {Map.put(outs, name, o), Map.put(acc, name, s)}
+    end)
+  end
+
+  def big(n) do
+    decl =
+      Enum.map_join(1..n, "\n", fn i ->
+        "var_input start#{i} bool\nvar_input stop#{i} bool\nvar_input overtemp#{i} bool\n" <>
+          "var_input reset#{i} bool\nvar_output motor#{i} bool\nvar_output run_lamp#{i} bool\n" <>
+          "var_output speed_sp#{i} dint 1200\nvar fault#{i} bool"
+      end)
+
+    rungs =
+      Enum.map_join(1..n, "\n", fn i ->
+        "( xic start#{i} | xic motor#{i} ) xio stop#{i} ote motor#{i}\nxic motor#{i} ote run_lamp#{i}\n" <>
+          "xic overtemp#{i} otl fault#{i}\nxic reset#{i} otu fault#{i}\nxic fault#{i} move 0 speed_sp#{i}"
+      end)
+
+    {:ok, p} = Logex.compile(decl <> "\n" <> rungs, name: "big")
+    p
+  end
+
+  # A program with many tags but one rung: does a scan cost grow with the tag table?
+  def wide(n) do
+    decl = Enum.map_join(1..n, "\n", fn i -> "var_output o#{i} bool\nvar v#{i} dint" end)
+    {:ok, p} = Logex.compile("var_input a bool\n" <> decl <> "\nxic a ote o1", name: "wide")
+    p
+  end
+
+  def run do
+    alias Logex.Runtime
+    base = count(&nothing/0)
+    {:ok, p} = compile()
+    s0 = Runtime.instance(p)
+    {_, s} = Runtime.call(p, s0, %{"start" => 1}, %Scan{now: 0, first: true})
+
+    row = fn label, f ->
+      IO.puts(String.pad_trailing(label, 52) <> "#{count(f) - base}")
+    end
+
+    IO.puts("count/1 overhead subtracted: #{base}")
+    IO.puts("== README motor, 8 tags (4 var_input, 3 var_output, 1 var), 5 rungs ==")
+    row.("call/4, no inputs", fn -> call0(p, s) end)
+    row.("call/4, 1 input", fn -> call1(p, s) end)
+    row.("call/4, 4 inputs", fn -> call4(p, s) end)
+    row.("scan/3, 10 ms", fn -> scan3(p, s) end)
+    row.("put_inputs/3, no inputs (the checks alone)", fn -> put0(p, s) end)
+    row.("put_inputs/3, 4 inputs", fn -> put4(p, s) end)
+    row.("instance/1", fn -> inst(p) end)
+    row.("restart/3", fn -> restart(p, s) end)
+    row.("Logex.compile/2", fn -> compile() end)
+
+    IO.puts("\n== N motors in one program (8N tags, 5N rungs), call/4 no inputs ==")
+
+    for n <- [1, 10, 100] do
+      q = big(n)
+      {_, t} = Runtime.call(q, Runtime.instance(q), %{}, %Scan{now: 0, first: true})
+      row.("N=#{n}", fn -> call0(q, t) end)
+    end
+
+    IO.puts("\n== one rung, 1 + 2N tags (N var_output, N var), call/4 no inputs ==")
+
+    for n <- [10, 100, 1000] do
+      q = wide(n)
+      {_, t} = Runtime.call(q, Runtime.instance(q), %{}, %Scan{now: 0, first: true})
+      row.("N=#{n}", fn -> call0(q, t) end)
+    end
+
+    IO.puts("\n== N instances of the motor, one call/4 each with 1 input ==")
+
+    for n <- [1, 10, 100] do
+      states = Map.new(1..n, fn i -> {"m#{i}", s} end)
+      row.("N=#{n}", fn -> cycle(p, states) end)
+    end
+  end
+end
+
+Probe.run()
