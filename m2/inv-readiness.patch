@@ -0,0 +1,40 @@
+# Probe 1: can today's lexer tokenise .lcf lines, and what does the parser make of them?
+lines = [
+  "task fast interval 10 priority 1",
+  "var_global k1 bool at panel.q.0",
+  "program m1 motor with fast",
+  "m1.start pb_start_1",
+  "m2.reset 0",
+  "function_block seal",
+  "cal s1 a b q",
+  # extras
+  "task trip single estop priority 0",
+  "var_global sp_1 dint at drive.q.0",
+  "  m1.speed_sp sp_1",
+  "var_global estop bool at panel.i.7",
+  "at %ix0.0",
+  "m1.t1.acc",
+  "var_config m2.speed_sp 900",
+  "a.1b"
+]
+
+for line <- lines do
+  IO.puts("#{inspect(line)}")
+  IO.puts("  tokenize: #{inspect(Logex.Compiler.tokenize(line))}")
+  case Logex.Compiler.tokenize(line) do
+    {:ok, tokens, _} -> IO.puts("  parse:    #{inspect(Logex.Compiler.parse(tokens))}")
+    _ -> :ok
+  end
+end
+
+plant = """
+// plant.lcf
+task fast interval 10 priority 1
+var_global k1 bool at panel.q.0
