+# Is a scan's per-tag cost the outputs comprehension?
+tags = Map.new(1..10000, fn i -> {"v#{i}", %Logex.Tag{name: "v#{i}", type: :dint, section: :var}} end)
+IO.puts("-- outputs comprehension alone over 10,000 tags: #{Probe4.count(fn -> Probe4.outs(tags) end)} reductions")
