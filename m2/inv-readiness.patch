diff --git a/probe/call_cost3.exs b/probe/call_cost3.exs
new file mode 100644
index 0000000..6b90b32
--- /dev/null
+++ b/probe/call_cost3.exs
@@ -0,0 +1,46 @@
+# Probe 2c: is a scan's cost in the whole tag table? One rung, one var_output, N plain vars.
+defmodule Probe3 do
+  alias Logex.{Runtime, Scan}
+
+  def count(f) do
+    for _ <- 1..50, do: f.()
+
+    Enum.min(
+      for _ <- 1..200 do
+        {:reductions, a} = Process.info(self(), :reductions)
+        f.()
+        {:reductions, b} = Process.info(self(), :reductions)
+        b - a
+      end
+    )
+  end
+
+  def call0(p, s), do: Runtime.call(p, s, %{}, %Scan{now: 10, first: false})
+
+  def vars(n) do
+    decl = Enum.map_join(1..n, "\n", fn i -> "var v#{i} dint" end)
+    {:ok, p} = Logex.compile("var_input a bool\nvar_output o bool\n" <> decl <> "\nxic a ote o", name: "vars")
+    p
+  end
+
+  def time_us(f, n) do
+    for _ <- 1..1000, do: f.()
+    {us, _} = :timer.tc(fn -> for _ <- 1..n, do: f.() end)
+    us / n
+  end
+
+  def run do
+    for n <- [10, 100, 1000, 10000] do
+      p = vars(n)
+      {_, s} = Runtime.call(p, Runtime.instance(p), %{}, %Scan{now: 0, first: true})
+      IO.puts("one rung, 1 var_output, #{n} vars: call/4 #{count(fn -> call0(p, s) end)} reductions")
+    end
+
+    {:ok, m} = Logex.compile(Probe.motor(), name: "motor")
+    {_, s} = Runtime.call(m, Runtime.instance(m), %{"start" => 1}, %Scan{now: 0, first: true})
+    IO.puts("README motor call/4, wall time: #{Float.round(time_us(fn -> call0(m, s) end, 100_000), 2)} us (mean of 100,000)")
+  end
+end
+
+Code.require_file("probe/call_cost2_mod.exs")
+Probe3.run()
