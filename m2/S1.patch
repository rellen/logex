+      end
+    end
+
+    # docs/organisation.md §4.9 (F14): an instance start/1 makes is instance/1's, so its
+    # first scan passes no one-shot, and every tag starts where instance/1 starts it.
+    test "start/1 makes each instance by instance/1: at its initial values, its first " <>
+           "scan first",
