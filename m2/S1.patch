+
+  describe "the scheduler, from Elixir data (M2-1)" do
+    alias Logex.{Configuration, Runtime}
+
+    # A relay passes its input to its output; three of them carry one value along a
+    # chain, `x` to `g` to `y` to `z`, so an output shows which scans ran in a cycle, and
+    # in which order, with no event read.
+    @relay "var_input a bool\nvar_output q bool\nxic a ote q\n"
+
+    defp relay, do: program(@relay)
+
+    # The 10 ms task is declared first, and its instance first, so only priority puts the
+    # 30 ms task's instance before it.
+    defp chain do
+      Configuration.new!(
+        name: "chain",
+        programs: %{"t" => relay()},
+        tasks: [
+          %{name: "fast", interval: 10, priority: 1},
+          %{name: "slow", interval: 30, priority: 0}
+        ],
+        globals: [
+          %{name: "x", type: :bool, at: "sim.i.0"},
+          %{name: "g", type: :bool},
+          %{name: "y", type: :bool, at: "sim.q.0"},
+          %{name: "z", type: :bool, at: "sim.q.1"}
+        ],
+        instances: [
+          %{name: "f", type: "t", task: "fast"},
+          %{name: "s", type: "t", task: "slow"},
+          %{name: "n", type: "t"}
+        ],
+        connections: [
+          %{member: "f.a", to: "g"},
+          %{member: "f.q", to: "y"},
+          %{member: "s.a", to: "x"},
+          %{member: "s.q", to: "g"},
+          %{member: "n.a", to: "y"},
+          %{member: "n.q", to: "z"}
+        ]
+      )
+    end
+
+    # `{outputs, events}` for each cycle of `steps`, each `{elapsed_ms, inputs}`.
+    defp cycles(rt, steps) do
+      {trace, _rt} =
+        Enum.map_reduce(steps, rt, fn {elapsed, inputs}, rt ->
+          {rt, outputs, events} = Runtime.cycle(rt, elapsed, inputs)
+          {{outputs, events}, rt}
+        end)
+
+      trace
+    end
+
+    # PLAN.md M2-1's Done-when, first clause. One simulated second is the cycles at 0, 10,
+    # ..., 990 ms, the first taken at the start, as M2-3's counts of 100 and 20 read it.
+    test "a 10 ms task, a 30 ms task and a task-less instance, cycled for one simulated " <>
+           "second, run as often as their tasks dictate, in priority order" do
+      times = Enum.to_list(0..990//10)
+      x = fn t -> rem(div(t, 10), 2) end
+      steps = [{0, %{"x" => x.(0)}} | for(t <- tl(times), do: {10, %{"x" => x.(t)}})]
+      trace = cycles(Runtime.start(chain()), steps)
+
+      ran = for {_out, events} <- trace, {:ran, _task, i, _now} <- events, do: i
+      assert Enum.frequencies(ran) == %{"f" => 100, "s" => 34, "n" => 100}
+
+      for {t, {outputs, events}} <- Enum.zip(times, trace) do
+        # Priority first, then the task-less instance, every one at the cycle's time.
+        slow = for _ <- [t], rem(t, 30) == 0, do: {:ran, "slow", "s", t}
+        assert events == slow ++ [{:ran, "fast", "f", t}, {:ran, :none, "n", t}], "at #{t} ms"
+
+        # What the order shows with no event read: `g` moves only when `s` runs, and `f`
+        # runs after it in the same cycle, so `y` is the sample `s` took this cycle or
+        # last took; `n` runs last and copies `y` on at once.
+        sample = x.(div(t, 30) * 30)
+        assert outputs == %{"y" => sample, "z" => sample}, "at #{t} ms"
+      end
+    end
+
+    # Second clause: a late cycle reports the runs it missed once, runs the task once,
+    # and keeps the task on its phase.
+    test "a late cycle yields one {:overlap, ...} and no lost phase" do
+      steps = [{0, %{}}, {10, %{}}, {10, %{}}, {25, %{}}] ++ List.duplicate({5, %{}}, 9)
+      trace = cycles(Runtime.start(chain()), steps)
+
+      # At 45 ms the 10 ms task, due at 30, has missed its run at 40: it runs once, after
+      # the 30 ms task, due at 30 too, which missed nothing.
+      assert elem(Enum.at(trace, 3), 1) == [
+               {:ran, "slow", "s", 45},
+               {:overlap, "fast", 1},
+               {:ran, "fast", "f", 45},
+               {:ran, :none, "n", 45}
+             ]
+
+      events = Enum.flat_map(trace, &elem(&1, 1))
+      assert for({:overlap, _, _} = event <- events, do: event) == [{:overlap, "fast", 1}]
+
+      assert for({:ran, "fast", "f", now} <- events, do: now) == [
+               0,
+               10,
+               20,
+               45,
+               50,
+               60,
+               70,
+               80,
+               90
+             ]
+
+      assert for({:ran, "slow", "s", now} <- events, do: now) == [0, 45, 60, 90]
+
+      late =
+        Enum.reduce(Enum.take(steps, 4), Runtime.start(chain()), fn {elapsed, inputs}, rt ->
+          elem(Runtime.cycle(rt, elapsed, inputs), 0)
+        end)
+
+      assert Runtime.next_due_in(late) == 5
+    end
+
+    @motor """
+    var_input start bool
+    var_input stop bool
+    var_input overtemp bool
+    var_input reset bool
+    var_output motor bool
+    var_output run_lamp bool
+    var_output speed_sp dint 1200
+    var fault bool
+
+    ( xic start | xic motor ) xio stop ote motor
+    xic motor ote run_lamp
+    xic overtemp otl fault
+    xic reset otu fault
+    xic fault move 0 speed_sp
+    """
+
+    # The README program as the one instance of a configuration with no task: an input
+    # point for each var_input and an output point for each var_output, each named like
+    # it, so the two runtimes take and give the same maps.
+    defp one_instance(program) do
+      {inputs, outputs} =
+        program.tags
+        |> Map.values()
+        |> Enum.filter(&(&1.section != :var))
+        |> Enum.sort_by(& &1.line)
+        |> Enum.split_with(&(&1.section == :var_input))
+
+      Configuration.new!(
+        name: "one",
+        programs: %{program.name => program},
+        globals:
+          Enum.with_index(inputs, &%{name: &1.name, type: &1.type, at: "panel.i.#{&2}"}) ++
+            Enum.with_index(outputs, &%{name: &1.name, type: &1.type, at: "panel.q.#{&2}"}),
+        instances: [%{name: "m1", type: program.name}],
+        connections: for(tag <- inputs ++ outputs, do: %{member: "m1.#{tag.name}", to: tag.name})
+      )
+    end
+
+    # Third clause, PLAN.md M2-1 and docs/organisation.md §4.6: or the two runtimes drift
+    # apart. The README's steps, then a seeded walk of inputs and clock.
+    test "the README program gives identical outputs through scan/2 and through a " <>
+           "one-instance configuration" do
+      {:ok, motor} = Logex.compile(@motor, name: "motor")
+
+      readme = [
+        %{"start" => 1},
+        %{"start" => 0},
+        %{"overtemp" => 1},
+        %{"stop" => 1},
+        %{"stop" => 0, "overtemp" => 0}
+      ]
+
+      :rand.seed(:exsss, {2026, 10, 2})
+
+      walk =
+        for _ <- 1..300,
+            do:
+              Map.new(
+                Enum.take_random(~w(start stop overtemp reset), :rand.uniform(3)),
+                &{&1, :rand.uniform(2) - 1}
+              )
+
+      Enum.reduce(
+        readme ++ walk,
+        {Runtime.instance(motor), Runtime.start(one_instance(motor))},
+        fn inputs, {state, rt} ->
+          {scanned, state} = Runtime.scan(motor, Runtime.put_inputs(motor, state, inputs))
+          {rt, cycled, [{:ran, :none, "m1", _now}]} = Runtime.cycle(rt, 0, inputs)
+          assert cycled == scanned
+          assert Runtime.get(rt, "m1.fault") == state.env["fault"]
+          {state, rt}
+        end
+      )
+    end
+
+    # The same with time passing, through scan/3, for a program that times (M2-3's motor).
+    test "and through scan/3 and a cycle's elapsed time, for a program that times" do
+      {:ok, timed} =
+        Logex.compile(
+          String.replace(
+            @motor,
+            "var fault bool\n",
+            "var fault bool\nvar_output running_ms dint\nvar t1 ton\n"
+          ) <>
+            "xic motor ton t1 5000\nxic motor move t1.acc running_ms\n",
+          name: "motor"
+        )
+
+      :rand.seed(:exsss, {2026, 10, 2})
+
+      steps =
+        for _ <- 1..300,
+            do:
+              {:rand.uniform(40) - 1,
+               Map.new(Enum.take_random(~w(start stop), 1), &{&1, :rand.uniform(2) - 1})}
+
+      Enum.reduce(
+        steps,
+        {Runtime.instance(timed), Runtime.start(one_instance(timed))},
+        fn {elapsed, inputs}, {state, rt} ->
+          {scanned, state} =
+            Runtime.scan(timed, Runtime.put_inputs(timed, state, inputs), elapsed)
+
+          {rt, cycled, _events} = Runtime.cycle(rt, elapsed, inputs)
+          assert cycled == scanned
+          assert Runtime.get(rt, "m1.t1.acc") == state.env["t1"]["acc"]
+          {state, rt}
+        end
+      )
+    end
+  end
 end
