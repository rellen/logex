+
+  # CONTRIBUTING.md, "Test a pass over the program for growth": a configuration of n
+  # periodic tasks, each with one instance, n instances with no task, 3n globals and 6n
+  # connections, so every check and every step of a cycle has work in proportion. The
+  # least of three counts.
+  describe "growth" do
+    alias Logex.Runtime
+
+    @small 100
+    @large 400
+
+    defp big(n) do
+      {:ok, relay} =
+        Logex.compile(
+          "var_input a bool\nvar_input n dint\nvar_output q bool\nvar_output m dint\n" <>
+            "xic a ote q\nxic a move n m\n",
+          name: "relay"
+        )
+
+      [
+        name: "big",
+        programs: %{"relay" => relay},
+        tasks:
+          for(
+            i <- 1..n,
+            do: %{name: "t#{i}", interval: 10 * (1 + rem(i, 3)), priority: rem(i, 7)}
+          ),
+        globals:
+          for(i <- 1..n, do: %{name: "x#{i}", type: :bool, at: "io.i.#{i}"}) ++
+            for(i <- 1..n, do: %{name: "y#{i}", type: :bool, at: "io.q.#{i}"}) ++
+            for(i <- 1..n, do: %{name: "g#{i}", type: :dint}),
+        instances:
+          for(i <- 1..n, do: %{name: "p#{i}", type: "relay", task: "t#{i}"}) ++
+            for(i <- 1..n, do: %{name: "s#{i}", type: "relay"}),
+        connections:
+          Enum.flat_map(1..n, fn i ->
+            [
+              %{member: "p#{i}.a", to: "x#{i}"},
+              %{member: "p#{i}.n", to: "g#{i}"},
+              %{member: "p#{i}.q", to: "y#{i}"},
+              %{member: "p#{i}.m", to: "g#{i}"},
+              %{member: "s#{i}.a", to: "y#{i}"},
+              %{member: "s#{i}.n", to: 3}
+            ]
+          end)
+      ]
+    end
+
+    defp reductions(fun) do
+      Enum.min(
+        for _ <- 1..3 do
+          {:reductions, before} = Process.info(self(), :reductions)
+          fun.()
+          {:reductions, later} = Process.info(self(), :reductions)
+          later - before
+        end
+      )
+    end
+
+    defp ratio(of), do: of.(@large) / of.(@small)
+
+    # 4x the parts took 4.00x to 4.11x the reductions over 30 runs on 1.20.4. An instance
+    # looking its task up in a list of every task's name took 5.66x to 5.77x.
+    test "new!/1 and start/1 stay linear in the parts" do
+      build = fn n ->
+        fields = big(n)
+        reductions(fn -> Runtime.start(Configuration.new!(fields)) end)
+      end
+
+      assert ratio(build) < 5
+    end
+
+    # 4x the instances, tasks and connections took 4.03x to 4.08x the reductions of three
+    # cycles over 30 runs on 1.20.4: every task due in the first, some in the others.
+    test "a cycle stays linear in the instances, tasks and connections" do
+      cycles = fn n ->
+        rt = Runtime.start(Configuration.new!(big(n)))
+        inputs = Map.new(1..n, &{"x#{&1}", rem(&1, 2)})
+
+        reductions(fn ->
+          {rt, _, _} = Runtime.cycle(rt, 0, inputs)
+          {rt, _, _} = Runtime.cycle(rt, 10, %{"x1" => 1})
+          Runtime.cycle(rt, 25, %{})
+        end)
+      end
+
+      assert ratio(cycles) < 5
+    end
+  end
+end
