+      prev: -1,
+      globals: Map.new(config.globals, &{&1.name, &1.initial || 0}),
+      states: Map.new(config.instances, &{&1.name, Runtime.instance(config.programs[&1.type])})
+    }
+  end
+
+  defp expected(model, config, elapsed, inputs) do
+    now = model.now + elapsed
+    prev = model.prev
+
+    due =
+      for {t, place} <- Enum.with_index(config.tasks),
+          floor_div(now, t.interval) > floor_div(prev, t.interval),
+          do: {t, place}
+
+    ordered =
+      Enum.sort_by(due, fn {t, place} ->
+        {t.priority, (floor_div(prev, t.interval) + 1) * t.interval, place}
+      end)
+
+    runs =
+      for(
+        {t, _place} <- ordered,
+        do:
+          {t.name, floor_div(now, t.interval) - floor_div(prev, t.interval) - 1,
+           under(config, t.name)}
+      ) ++
+        [{:none, 0, under(config, nil)}]
+
+    resource_reach(:not_due, length(due) < length(config.tasks))
+
+    resource_reach(
+      :reordered,
+      Enum.map(ordered, &elem(&1, 1)) != Enum.sort(Enum.map(ordered, &elem(&1, 1)))
+    )
+
+    resource_reach(:overlap_first, prev == -1 and Enum.any?(runs, &(elem(&1, 1) > 0)))
+
+    model = %{model | now: now, prev: now, globals: Map.merge(model.globals, inputs)}
+
+    {model, events} =
+      Enum.reduce(runs, {model, []}, fn {task, missed, instances}, {model, events} ->
+        events = if missed > 0, do: events ++ [{:overlap, task, missed}], else: events
+        Enum.reduce(instances, {model, events}, &scan_in_model(&1, task, config, &2))
+      end)
+
+    outputs =
+      for %{name: g, at: at} <- config.globals,
+          at != nil and String.contains?(at, ".q."),
+          into: %{},
+          do: {g, model.globals[g]}
+
+    {model, outputs, events}
+  end
+
+  defp under(config, task),
+    do: for(%{name: name} = i <- config.instances, Map.get(i, :task) == task, do: name)
+
+  defp scan_in_model(name, task, config, {model, events}) do
+    %{type: type} = Enum.find(config.instances, &(&1.name == name))
+    program = config.programs[type]
+
+    mine =
+      for c <- config.connections,
+          [^name, member] <- [String.split(c.member, ".")],
+          do: {program.tags[member], c.to}
+
+    inputs =
+      for {%Tag{section: :var_input, name: member}, to} <- mine, into: %{} do
+        resource_reach(:constant, is_integer(to))
+
+        resource_reach(
+          :read_back,
+          is_binary(to) and
+            String.contains?(Enum.find(config.globals, &(&1.name == to))[:at] || "", ".q.")
+        )
+
+        {member, if(is_integer(to), do: to, else: model.globals[to])}
+      end
+
+    state = model.states[name]
+
+    {outputs, state} =
+      Runtime.call(program, state, inputs, %Scan{now: model.now, first: state.first})
+
+    sinks = for {%Tag{section: :var_output, name: member}, to} <- mine, do: {member, to}
+    resource_reach(:sink_twice, length(sinks) > length(Enum.uniq_by(sinks, &elem(&1, 0))))
+
+    globals =
+      Enum.reduce(sinks, model.globals, fn {member, to}, g -> Map.put(g, to, outputs[member]) end)
+
+    resource_reach(if(task == :none, do: :ran_none, else: :ran_task), true)
+
+    {%{model | globals: globals, states: Map.put(model.states, name, state)},
+     events ++ [{:ran, task, name, model.now}]}
+  end
+
+  # The next periodic due time is the first multiple of each interval after the last
+  # cycle, or 0 before the first.
+  defp next_due(_model, %{tasks: []}), do: :infinity
+  defp next_due(%{prev: -1}, _config), do: 0
+
+  defp next_due(%{now: now}, config),
+    do: Enum.min(for t <- config.tasks, do: (floor_div(now, t.interval) + 1) * t.interval) - now
+
+  defp floor_div(a, b), do: Integer.floor_div(a, b)
+
+  defp resource_walk(_rt, _model, _config, 0), do: :ok
+
+  defp resource_walk(rt, model, config, n) do
+    case resource_operation(:rand.uniform(10), rt, model, config) do
+      {:cycle, mistake?, call, elapsed, inputs} ->
+        case resource_attempt(call) do
+          {:ok, {next, outputs, events}} ->
+            refute mistake?, "a host mistake was accepted"
+            {model, expected_outputs, expected_events} = expected(model, config, elapsed, inputs)
+            assert events == expected_events
+            assert outputs == expected_outputs
+            resource_reach(:overlap, Enum.any?(events, &match?({:overlap, _, _}, &1)))
+            agree(next, model)
+            resource_walk(next, model, config, n - 1)
+
+          :refused ->
+            assert mistake?, "a call without a host mistake was refused"
+            resource_walk(rt, model, config, n - 1)
+        end
+
+      {:other, mistake?, call} ->
+        case resource_attempt(call) do
+          {:ok, _} -> refute mistake?, "a host mistake was accepted"
+          :refused -> assert mistake?, "a call without a host mistake was refused"
+        end
+
+        resource_walk(rt, model, config, n - 1)
+    end
+  end
+
+  # Every global and every value an instance holds, read by get/2, is the model's.
+  defp agree(rt, model) do
+    for {g, value} <- model.globals, do: assert(Runtime.get(rt, g) == value, g)
+
+    for {name, state} <- model.states, {tag, value} <- state.env do
+      case value do
+        %{} = members ->
+          for m <- ~w(pre acc dn tt en),
+              do: assert(Runtime.get(rt, "#{name}.#{tag}.#{m}") == members[m])
+
+          resource_reach(:get_member, true)
+
+        value ->
+          assert Runtime.get(rt, "#{name}.#{tag}") == value, "#{name}.#{tag}"
+      end
+    end
+  end
+
+  defp resource_operation(op, rt, _model, config) when op <= 6 do
+    elapsed = pick([0, 0, 1, 5, 10, 10, 25, 60] ++ if(op == 6, do: [-1, 1.5, nil], else: []))
+    {inputs, bad?} = cycle_inputs(op == 6, config)
+    mistake? = bad? or not (is_integer(elapsed) and elapsed >= 0)
+    {:cycle, mistake?, fn -> Runtime.cycle(rt, elapsed, inputs) end, elapsed, inputs}
+  end
+
+  defp resource_operation(7, rt, model, config) do
+    expected = next_due(model, config)
+    resource_reach(next_kind(expected), true)
+    {:other, false, fn -> assert(Runtime.next_due_in(rt) == expected) end}
+  end
+
+  # A path that names a global or an instance's bool or dint, or one that does not.
+  defp resource_operation(8, rt, _model, config) do
+    values =
+      Enum.map(config.globals, & &1.name) ++
+        for i <- config.instances,
+            {t, %Tag{type: type}} <- config.programs[i.type].tags,
+            type in [:bool, :dint],
+            do: "#{i.name}.#{t}"
+
+    path =
+      pick([
+        pick(values),
+        pick(values),
+        pick(["zz", "i1", "i9.a", "i1.zz", "i1.a.b", "", "in_b1.x"]),
+        :path
+      ])
+
+    {:other, path not in values, fn -> Runtime.get(rt, path) end}
+  end
+
+  defp resource_operation(9, rt, _model, config) do
+    timers = for i <- config.instances, i.type == "timer", do: i.name
+
+    path =
+      pick(Enum.flat_map(timers, &["#{&1}.t1", "#{&1}.t1.last", "#{&1}.t1.acc"]) ++ ["in_b1"])
+
+    {:other, String.ends_with?(path, ".t1") or String.ends_with?(path, ".last"),
+     fn -> Runtime.get(rt, path) end}
+  end
+
+  defp resource_operation(10, _rt, _model, _config) do
+    case :rand.uniform(4) do
+      1 -> {:other, true, fn -> Runtime.start(pick([nil, :plant, %{}])) end}
+      2 -> {:other, true, fn -> Runtime.cycle(pick([nil, :rt, %{}]), 0, %{}) end}
+      3 -> {:other, true, fn -> Runtime.next_due_in(pick([nil, :rt])) end}
+      4 -> {:other, true, fn -> Runtime.get(pick([nil, :rt]), "in_b1") end}
+    end
+  end
+
+  defp next_kind(:infinity), do: :next_infinity
+  defp next_kind(0), do: :next_zero
+  defp next_kind(_later), do: :next_later
+
+  # The inputs of a cycle, and whether they are a host mistake: a sample of the input
+  # points with values that fit, or, broken on purpose, one thing a host may not send.
+  defp cycle_inputs(false, _config) do
+    points = Enum.take_random(["in_b1", "in_b2", "in_d"], :rand.uniform(4) - 1)
+
+    {Map.new(
+       points,
+       &{&1, if(&1 == "in_d", do: pick([0, 3, -40, 2_147_483_647]), else: pick([0, 1]))}
+     ), false}
+  end
+
+  defp cycle_inputs(true, config) do
+    instance = hd(config.instances).name
+
+    bad =
+      pick([
+        %{:in_b1 => 1},
+        %{"out_b1" => 1},
+        %{"g_b" => 1},
+        %{"#{instance}.a" => 1},
+        %{"zz" => 1},
+        %{"in_b1" => 2},
+        %{"in_d" => 2_147_483_648},
+        %{"in_d" => 1.0},
+        [],
+        %Scan{now: 0, first: true},
+        %{"in_b1" => 1}
+      ])
+
+    {bad, bad != %{"in_b1" => 1}}
+  end
+
+  defp resource_attempt(fun) do
+    result = fun.()
+    assert fun.() == result, "the same call gave two results"
+    {:ok, result}
+  rescue
+    error in ArgumentError ->
+      for line <- String.split(error.message, "\n") do
+        kind =
+          Enum.find_value(@resource_refusals, fn {kind, fragment} ->
+            String.contains?(line, fragment) && kind
+          end)
+
+        assert kind, "undocumented refusal: #{line}"
+        reached(:resource_refused, kind)
+      end
+
+      :refused
+  end
+
+  defp resource_reach(name, true), do: reached(:resource_reach, name)
+  defp resource_reach(_name, false), do: :ok
 end
diff --git a/test/logex/configuration_test.exs b/test/logex/configuration_test.exs
new file mode 100644
index 0000000..6c610b5
--- /dev/null
+++ b/test/logex/configuration_test.exs
@@ -0,0 +1,722 @@
+defmodule Logex.ConfigurationTest do
+  @moduledoc """
+  M2-1: `Logex.Configuration.new!/1`, the one checked constructor of a configuration,
+  which M2-2's configuration file will feed. Every refusal is an `ArgumentError` whose
+  message, one line per problem, is pinned here whole; each rule has a test that fails
+  without it.
+  """
+  use ExUnit.Case, async: true
+
+  alias Logex.Configuration
+
+  @relay "var_input a bool\nvar_output q bool\nxic a ote q\n"
+
+  @motor """
+  var_input start bool
+  var_input stop bool
+  var_input sp dint
+  var_output motor bool
+  var_output speed dint
+  var fault bool
+  var t1 ton
+
+  ( xic start | xic motor ) xio stop ote motor
+  xic motor move sp speed
+  xic motor ton t1 100
+  """
+
+  defp program(source, name) do
+    {:ok, program} = Logex.compile(source, name: name)
+    program
+  end
+
+  # A configuration that is right, which each test breaks in one place.
+  defp fields(changes \\ []) do
+    Keyword.merge(
+      [
+        name: "plant",
+        programs: %{"relay" => program(@relay, "relay")},
+        tasks: [%{name: "fast", interval: 10, priority: 1}],
+        globals: [
+          %{name: "x", type: :bool, at: "panel.i.0"},
+          %{name: "y", type: :bool, at: "panel.q.0"}
+        ],
+        instances: [%{name: "r1", type: "relay", task: "fast"}],
+        connections: [%{member: "r1.a", to: "x"}, %{member: "r1.q", to: "y"}]
+      ],
+      changes
+    )
+  end
+
+  # The motor's fields: a dint input and output, a var and a timer.
+  defp motor(changes) do
+    fields(
+      Keyword.merge(
+        [
+          programs: %{"motor" => program(@motor, "motor")},
+          globals: [
+            %{name: "pb", type: :bool, at: "panel.i.0"},
+            %{name: "k", type: :bool, at: "panel.q.0"},
+            %{name: "sp", type: :dint},
+            %{name: "out", type: :dint, at: "drive.q.0"}
+          ],
+          instances: [%{name: "m1", type: "motor"}],
+          connections: [
+            %{member: "m1.start", to: "pb"},
+            %{member: "m1.stop", to: 0},
+            %{member: "m1.sp", to: "sp"},
+            %{member: "m1.motor", to: "k"},
+            %{member: "m1.speed", to: "out"}
+          ]
+        ],
+        changes
+      )
+    )
+  end
+
+  defp refused(fields) do
+    error = assert_raise ArgumentError, fn -> Configuration.new!(fields) end
+    String.split(error.message, "\n")
+  end
+
+  defp opaque(value), do: Process.get(:__opaque_to_the_type_checker__, value)
+
+  describe "a configuration that is right" do
+    test "is data: every part a map with every field, one left out at nil, and no line" do
+      config =
+        Configuration.new!(
+          fields(globals: fields()[:globals] ++ [%{name: "g", type: :dint, initial: 7}])
+        )
+
+      assert %Configuration{
+               name: "plant",
+               programs: %{"relay" => %Logex.Program{name: "relay"}},
+               tasks: [%{name: "fast", interval: 10, priority: 1, line: nil}],
+               globals: [
+                 %{name: "x", type: :bool, initial: nil, at: "panel.i.0", line: nil},
+                 %{name: "y", type: :bool, initial: nil, at: "panel.q.0", line: nil},
+                 %{name: "g", type: :dint, initial: 7, at: nil, line: nil}
+               ],
+               instances: [%{name: "r1", type: "relay", task: "fast", line: nil}],
+               connections: [
+                 %{member: "r1.a", to: "x", line: nil},
+                 %{member: "r1.q", to: "y", line: nil}
+               ]
+             } = config
+    end
+
+    test "tasks, globals and connections may be left out, and a task-less instance needs none" do
+      config =
+        Configuration.new!(
+          name: "lone",
+          programs: %{"p" => program("var_output q bool\nxic q ote q\n", "p")},
+          instances: [%{name: "i1", type: "p"}]
+        )
+
+      assert %Configuration{tasks: [], globals: [], connections: []} = config
+    end
+
+    test "a var_input reads an output point back, an unlocated global, or a constant; a " <>
+           "var_output drives several globals" do
+      assert %Configuration{} =
+               Configuration.new!(
+                 motor(
+                   globals: motor([])[:globals] ++ [%{name: "k_copy", type: :bool}],
+                   connections: [
+                     %{member: "m1.start", to: "k"},
+                     %{member: "m1.stop", to: "pb"},
+                     %{member: "m1.sp", to: 1200},
+                     %{member: "m1.motor", to: "k"},
+                     %{member: "m1.motor", to: "k_copy"}
+                   ]
+                 )
+               )
+    end
+
+    test "the widest values fit, and a location may have a deeper address" do
+      assert %Configuration{} =
+               Configuration.new!(
+                 motor(
+                   tasks: [%{name: "fast", interval: 2_147_483_647, priority: 2_147_483_647}],
+                   globals: [
+                     %{name: "pb", type: :bool, at: "rack_1.i.0.15"},
+                     %{name: "k", type: :bool, at: "_p.q.10"},
+                     %{name: "sp", type: :dint, initial: 2_147_483_647},
+                     %{name: "out", type: :dint, at: "drive.q.0"}
+                   ],
+                   connections: [
+                     %{member: "m1.start", to: "pb"},
+                     %{member: "m1.stop", to: 1},
+                     %{member: "m1.sp", to: 2_147_483_647},
+                     %{member: "m1.motor", to: "k"}
+                   ]
+                 )
+               )
+    end
+  end
+
+  describe "the fields" do
+    test "are a keyword list" do
+      for junk <- [:plant, %{name: "plant"}, [1, 2], "plant"] do
+        assert refused(opaque(junk)) == [
+                 "Logex.Configuration.new!/1 takes a keyword list of name:, programs:, tasks:, " <>
+                   ~s|globals:, instances: and connections:, as in new!(name: "plant", ...), | <>
+                   "got: #{inspect(junk)}"
+               ]
+      end
+    end
+
+    test "a field it does not know, or one given twice" do
+      assert refused(fields() ++ [task: [], name: "again"]) == [
+               "unknown field :task: a configuration has name, programs, tasks, globals, " <>
+                 "instances and connections",
+               "`name` is given twice"
+             ]
+    end
+
+    test "a name, shaped like a program's; and at least one instance" do
+      assert refused([]) == [
+               ~s|a configuration needs a name, as in name: "plant"|,
+               "a configuration runs at least one instance of a program"
+             ]
+
+      for bad <- ["plant.lcf", "1plant", "", :plant] do
+        assert refused(fields(name: bad)) == [
+                 "#{inspect(bad)} cannot name a configuration: a name is a letter or `_`, then " <>
+                   "letters, digits or `_`"
+               ]
+      end
+    end
+
+    test "programs: a map of programs, each under its own name" do
+      relay = program(@relay, "relay")
+
+      {:ok, unnamed} =
+        Logex.Compiler.instructionize(
+          elem(Logex.Compiler.parse(elem(Logex.Compiler.tokenize(@relay), 1)), 1)
+        )
+
+      assert refused(fields(programs: [relay])) == [
+               ~s|programs must be a map of program names to programs, as in %{"motor" => motor}, | <>
+                 "got: #{inspect([relay])}",
+               ~s|instance `r1`: no program `relay`: this configuration has no program|
+             ]
+
+      assert refused(
+               fields(programs: %{"relay" => relay, "pump" => relay, "x" => unnamed, :y => :z})
+             ) == [
+               "the program under :y is not a %Logex.Program{} from Logex.compile/2, got: :z",
+               ~s|the program under "pump" is named "relay": key each by its own name|,
+               ~s|the program under "x" has no name: compile it with one, as in | <>
+                 ~s|Logex.compile(source, name: "motor")|
+             ]
+    end
+
+    test "each part list is a list of maps, each with its fields and no other" do
+      assert refused(fields(tasks: :fast)) == [
+               ~s|tasks must be a list of maps, as in [%{name: "fast", interval: 10, priority: 1}], | <>
+                 "got: :fast",
+               "instance `r1`: no task `fast`: this configuration has no task"
+             ]
+
+      assert refused(fields(globals: [{"x", :bool}] ++ fields()[:globals])) == [
+               ~s|a global is a map, as in %{name: "k1", type: :bool}, got: {"x", :bool}|
+             ]
+
+      task = %{name: "fast", interval: 10, prio: 1}
+
+      assert refused(fields(tasks: [task])) == [
+               ~s|a task needs `priority`, as in %{name: "fast", interval: 10, priority: 1}, | <>
+                 "got: #{inspect(task)}",
+               "a task has no field :prio: its fields are `name`, `interval` and `priority`, " <>
+                 "got: #{inspect(task)}",
+               "instance `r1`: no task `fast`: this configuration has no task"
+             ]
+
+      # A part refused for its shape is left out, so what names it finds nothing. A line
+      # is the configuration file's to give.
+      bad = %{name: "r1", type: "relay", task: "fast", with: "fast", line: 3}
+
+      assert refused(fields(instances: [bad])) == [
+               "an instance has no field :line or :with: its fields are `name`, `type` and " <>
+                 "`task`, got: #{inspect(bad)}",
+               "`r1.a`: no instance `r1`: this configuration has no instance",
+               "`r1.q`: no instance `r1`: this configuration has no instance"
+             ]
+    end
+  end
+
+  describe "names" do
+    test "tasks, globals and instances share one set of names" do
+      assert refused(
+               fields(
+                 tasks: [
+                   %{name: "fast", interval: 10, priority: 1},
+                   %{name: "x", interval: 5, priority: 0}
+                 ],
+                 globals:
+                   fields()[:globals] ++
+                     [%{name: "fast", type: :bool}, %{name: "r1", type: :bool}]
+               )
+             ) == [
+               "`x` names a task and a global: tasks, globals and instances share one set of names",
+               "`fast` names a task and a global: tasks, globals and instances share one set of names",
+               "`r1` names a global and an instance: tasks, globals and instances share one set " <>
+                 "of names"
+             ]
+    end
+
+    test "one of a kind declared twice, and two that differ only in case" do
+      assert refused(
+               fields(
+                 tasks: [
+                   %{name: "fast", interval: 10, priority: 1},
+                   %{name: "fast", interval: 5, priority: 0}
+                 ],
+                 globals: fields()[:globals] ++ [%{name: "Y", type: :bool}]
+               )
+             ) == [
+               "task `fast` is declared twice",
+               "`Y` and `y` differ only in case: names are case-sensitive, so these would be two names"
+             ]
+    end
+
+    test "each is one name token, with no `.`" do
+      assert refused(
+               fields(
+                 tasks: [
+                   %{name: "fast", interval: 10, priority: 1},
+                   %{name: "a.b", interval: 5, priority: 0}
+                 ],
+                 globals: fields()[:globals] ++ [%{name: "1g", type: :bool}],
+                 instances: fields()[:instances] ++ [%{name: :r2, type: "relay"}]
+               )
+             ) == [
+               "task `a.b`: a name is a letter or `_`, then letters, digits or `_`",
+               "global `1g`: a name is a letter or `_`, then letters, digits or `_`",
+               "instance :r2: a name is a letter or `_`, then letters, digits or `_`"
+             ]
+    end
+  end
+
+  describe "a task" do
+    test "runs every 1 to 2147483647 ms, at a priority from 0, the highest, to 2147483647" do
+      for {interval, priority} <- [{0, -1}, {2_147_483_648, 2_147_483_648}, {1.5, nil}] do
+        assert refused(fields(tasks: [%{name: "fast", interval: interval, priority: priority}])) ==
+                 [
+                   "task `fast`: its interval is a whole number of milliseconds from 1 to " <>
+                     "2147483647, got: #{inspect(interval)}",
+                   "task `fast`: its priority is a whole number from 0, the highest, to " <>
+                     "2147483647, got: #{inspect(priority)}"
+                 ]
+      end
+    end
+  end
+
+  describe "a global" do
+    test "is a bool or a dint" do
+      assert refused(fields(globals: fields()[:globals] ++ [%{name: "g", type: :ton}])) == [
+               "global `g`: its type is :bool or :dint, got: :ton"
+             ]
+    end
+
