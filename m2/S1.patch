index 0000000..5fc4acd
--- /dev/null
+++ b/lib/logex/configuration.ex
@@ -0,0 +1,690 @@
+defmodule Logex.Configuration do
+  @moduledoc """
+  A configuration with one resource, in IEC 61131-3's terms (M2-1, `docs/organisation.md`
+  §4.4): which program types it runs, as which instances, under which tasks, and how each
+  instance's interface is wired to globals. It is data, made by `new!/1`, and
+  `Logex.Runtime.start/1` runs it.
+
+      config =
+        Logex.Configuration.new!(
+          name: "plant",
+          programs: %{"motor" => motor},
+          tasks: [%{name: "fast", interval: 10, priority: 1}],
+          globals: [
+            %{name: "pb_start", type: :bool, at: "panel.i.0"},
+            %{name: "pb_stop", type: :bool, at: "panel.i.1"},
+            %{name: "k1", type: :bool, at: "panel.q.0"}
+          ],
+          instances: [%{name: "m1", type: "motor", task: "fast"}],
+          connections: [
+            %{member: "m1.start", to: "pb_start"},
+            %{member: "m1.stop", to: "pb_stop"},
+            %{member: "m1.motor", to: "k1"}
+          ]
+        )
+
+  Each part says what one line of the configuration file of `docs/organisation.md` §4.4
+  says, as data:
+
+  - a **task**, `%{name:, interval:, priority:}`: periodic, every `interval` ms from 1 to
+    2147483647, at a `priority` from 0, the highest, to 2147483647 (`task fast interval
+    10 priority 1`);
+  - a **global**, `%{name:, type:, initial:, at:}`: `:bool` or `:dint`, with an initial
+    value, or at a location, `"<device>.i.<n>"` for an input point or `"<device>.q.<n>"`
+    for an output point, more numbers after the first giving a deeper address
+    (`var_global k1 bool at panel.q.0`). A located global takes no initial value: its
+    value is the I/O's. `initial` and `at` may be left out;
+  - an **instance** of a program type, `%{name:, type:, task:}`, `task` a task's name, or
+    left out for none (`program m1 motor with fast`);
+  - a **connection**, `%{member:, to:}`: an instance's var_input to a global or a
+    constant, copied in before each scan, or its var_output to a global, copied out after
+    it (`m1.start pb_start`, `m2.reset 0`, `m1.motor k1`). Its direction is the member's.
+
+  `programs` holds the program types the instances name, keyed by name, each a
+  `%Logex.Program{}` from `Logex.compile/2`. A part is kept as a map with every field, one
+  left out at nil, and a `line`: nil from Elixir, and, once the configuration file exists,
+  the line that said it, which its diagnostics cite.
+
+  **The checks** (`docs/organisation.md` §4.4). `new!/1` refuses, all in one
+  `ArgumentError`, a line each:
+  - what a configuration file could not say: a name that is not one name token; an
+    interval, priority, initial value or constant out of range, a negative one included
+    until a negative literal lexes; a location of another shape; a field it does not know;
+  - a name used twice: tasks, globals and instances share one set of names, and two that
+    differ only in case are refused, as tags are;
+  - an unknown program type, task, instance, member or global, with a did-you-mean;
+  - a located global with an initial value, and two globals at one location;
+  - a connection of anything but a var_input or a var_output, or of two types; a
+    var_output that drives a constant, an input point, or a global another var_output
+    already drives; a var_input connected twice;
+  - a var_input connected to nothing (decision 7), and a configuration of no instance.
+
+  No word is reserved: a configuration has no text yet, and the item that gives it text
+  reserves its words in both of its ways in. A `%Logex.Configuration{}` built or edited by
+  hand is outside the contract of `Logex.Runtime`.
+  """
+
+  alias Logex.{Declarations, Program, Tag}
+
+  @enforce_keys [:name, :programs, :tasks, :globals, :instances, :connections]
+  defstruct @enforce_keys
+
+  @type task :: %{
+          name: String.t(),
+          interval: pos_integer,
+          priority: non_neg_integer,
+          line: pos_integer | nil
+        }
+  @type global :: %{
+          name: String.t(),
+          type: :bool | :dint,
+          initial: non_neg_integer | nil,
+          at: String.t() | nil,
+          line: pos_integer | nil
+        }
+  @type instance :: %{
+          name: String.t(),
+          type: String.t(),
+          task: String.t() | nil,
+          line: pos_integer | nil
+        }
+  @type connection :: %{
+          member: String.t(),
+          to: String.t() | non_neg_integer,
+          line: pos_integer | nil
+        }
+  @type t :: %__MODULE__{
+          name: String.t(),
+          programs: %{String.t() => Program.t()},
+          tasks: [task],
+          globals: [global],
+          instances: [instance],
+          connections: [connection]
+        }
+
+  @fields [:name, :programs, :tasks, :globals, :instances, :connections]
+
+  # Each kind of part: what it is called, the fields it must have, those it may leave out,
+  # and an example for a message.
+  @parts %{
+    tasks:
+      {"task", [:name, :interval, :priority], [], ~s|%{name: "fast", interval: 10, priority: 1}|},
+    globals: {"global", [:name, :type], [:initial, :at], ~s|%{name: "k1", type: :bool}|},
+    instances: {"instance", [:name, :type], [:task], ~s|%{name: "m1", type: "motor"}|},
+    connections: {"connection", [:member, :to], [], ~s|%{member: "m1.start", to: "pb_start"}|}
+  }
+
+  # A dint, as a preset is (Logex.Declarations.preset?/1): the most a task's numbers take.
+  @most 2_147_483_647
+
+  # A location: a device, `i` or `q`, then one or more numbers, none with a leading zero,
+  # so that an address has one spelling; it lexes as one name (docs/organisation.md §4.5).
+  # Logex.Runtime reads a point's direction from its second field, so a device of more
+  # than one field changes both.
+  @location ~r/\A[A-Za-z_][A-Za-z0-9_]*\.([iq])(?:\.(?:0|[1-9][0-9]*))+\z/
+
+  @doc """
+  A configuration from Elixir data, checked: the fields are `name:`, `programs:`,
+  `tasks:`, `globals:`, `instances:` and `connections:`, each but `name` empty when left
+  out. Raises `ArgumentError` with every problem, a line each, in the order of the fields.
+  """
+  def new!(fields) do
+    {config, shape} = built(keyword!(fields))
+    raised(shape ++ Enum.map(problems(config), &elem(&1, 1)), config)
+  end
+
+  defp raised([], config), do: config
+  defp raised(problems, _config), do: raise(ArgumentError, Enum.join(problems, "\n"))
+
+  defp keyword!(fields) when is_list(fields), do: keyword(Keyword.keyword?(fields), fields)
+  defp keyword!(fields), do: keyword(false, fields)
+
+  defp keyword(true, fields), do: fields
+
+  defp keyword(false, fields),
+    do:
+      raise(
+        ArgumentError,
+        "Logex.Configuration.new!/1 takes a keyword list of name:, programs:, tasks:, " <>
+          ~s|globals:, instances: and connections:, as in new!(name: "plant", ...), | <>
+          "got: #{inspect(fields)}"
+      )
+
+  # The fields, each part made a map with every field, which is what the checks and
+  # Logex.Runtime read. A part of the wrong shape is reported here and left out.
+  defp built(fields) do
+    {programs, bad_programs} = programs(Keyword.get(fields, :programs, %{}))
+
+    {parts, bad_parts} =
+      Enum.map_reduce([:tasks, :globals, :instances, :connections], [], fn kind, bad ->
+        {parts, problems} = parts(kind, Keyword.get(fields, kind, []))
+        {{kind, parts}, bad ++ problems}
+      end)
+
+    name = Keyword.get(fields, :name)
+    config = struct!(__MODULE__, [name: name, programs: programs] ++ parts)
+
+    {config,
+     fields(fields) ++
+       name(name) ++ bad_programs ++ bad_parts ++ none(Keyword.get(fields, :instances, []))}
+  end
+
+  defp fields(fields),
+    do:
+      for({key, _value} <- fields, key not in @fields, do: unknown_field(key)) ++
+        for(
+          {key, n} <- Enum.frequencies(Keyword.keys(fields)),
+          n > 1,
+          do: "`#{key}` is given twice"
+        )
+
+  defp unknown_field(key),
+    do:
+      "unknown field #{inspect(key)}: a configuration has name, programs, tasks, globals, " <>
+        "instances and connections"
+
+  defp name(nil), do: [~s|a configuration needs a name, as in name: "plant"|]
+
+  defp name(name),
+    do: shaped(Declarations.name?(name), "#{inspect(name)} cannot name a configuration")
+
+  defp shaped(true, _what), do: []
+
+  defp shaped(false, what),
+    do: ["#{what}: a name is a letter or `_`, then letters, digits or `_`"]
+
+  # IEC 61131-3 requires a program in every configuration (Ed 2 Annex B.1.7, Ed 3 Annex A).
+  defp none([]), do: ["a configuration runs at least one instance of a program"]
+  defp none(_instances), do: []
+
+  defp programs(programs) when is_map(programs) and not is_struct(programs) do
+    {good, bad} = Enum.split_with(Enum.sort(programs), &program?/1)
+    {Map.new(good), Enum.map(bad, &bad_program/1)}
+  end
+
+  defp programs(other),
+    do:
+      {%{},
+       [
+         ~s|programs must be a map of program names to programs, as in %{"motor" => motor}, | <>
+           "got: #{inspect(other)}"
+       ]}
+
+  defp program?({name, %Program{name: name, tags: tags, rungs: rungs}}),
+    do: is_binary(name) and is_map(tags) and is_list(rungs)
+
+  defp program?(_entry), do: false
+
+  defp bad_program({key, %Program{name: nil, tags: tags, rungs: rungs}})
+       when is_map(tags) and is_list(rungs),
+       do:
+         "the program under #{inspect(key)} has no name: compile it with one, as in " <>
+           ~s|Logex.compile(source, name: "motor")|
+
+  defp bad_program({key, %Program{name: name, tags: tags, rungs: rungs}})
+       when is_map(tags) and is_list(rungs),
+       do: "the program under #{inspect(key)} is named #{inspect(name)}: key each by its own name"
+
+  defp bad_program({key, other}),
+    do:
+      "the program under #{inspect(key)} is not a %Logex.Program{} from Logex.compile/2, " <>
+        "got: #{inspect(other)}"
+
+  defp parts(kind, list) when is_list(list) do
+    {parts, problems} = Enum.map_reduce(list, [], &part(kind, &1, &2))
+    {Enum.reject(parts, &is_nil/1), problems}
+  end
+
+  defp parts(kind, other) do
+    {_what, _required, _optional, example} = Map.fetch!(@parts, kind)
+    {[], ["#{kind} must be a list of maps, as in [#{example}], got: #{inspect(other)}"]}
+  end
+
+  defp part(kind, part, problems) when is_map(part) and not is_struct(part) do
+    {what, required, optional, example} = Map.fetch!(@parts, kind)
+    keys = required ++ optional
+    missing = for key <- required, not is_map_key(part, key), do: key
+    unknown = for key <- Enum.sort(Map.keys(part)), key not in keys, do: key
+    found = needs(missing, what, example, part) ++ unknown(unknown, what, keys, part)
+
+    {whole(found, Map.merge(Map.from_keys(keys, nil), Map.put(part, :line, nil))),
+     problems ++ found}
+  end
+
+  defp part(kind, other, problems) do
+    {what, _required, _optional, example} = Map.fetch!(@parts, kind)
+    {nil, problems ++ ["#{a(what)} is a map, as in #{example}, got: #{inspect(other)}"]}
+  end
+
+  defp whole([], part), do: part
+  defp whole(_problems, _part), do: nil
+
+  defp needs([], _what, _example, _part), do: []
+
+  defp needs(missing, what, example, part),
+    do: ["#{a(what)} needs #{listed(missing)}, as in #{example}, got: #{inspect(part)}"]
+
+  defp unknown([], _what, _keys, _part), do: []
+
+  defp unknown(unknown, what, keys, part),
+    do: [
+      "#{a(what)} has no field #{Enum.map_join(unknown, " or ", &inspect/1)}: its fields are " <>
+        "#{listed(keys)}, got: #{inspect(part)}"
+    ]
+
+  defp listed([one]), do: "`#{one}`"
+
+  defp listed(keys) do
+    {init, [last]} = Enum.split(keys, -1)
+    Enum.map_join(init, ", ", &"`#{&1}`") <> " and `#{last}`"
+  end
+
+  defp a("instance"), do: "an instance"
+  defp a(what), do: "a #{what}"
+
+  # The checks of docs/organisation.md §4.4 over parts of the right shape, each problem
+  # with the line of the part it is about: nil from Elixir, and from the configuration
+  # file, once it exists, the line its diagnostic cites.
+  defp problems(%__MODULE__{} = config) do
+    names(config) ++
+      Enum.flat_map(config.tasks, &task/1) ++
+      globals(config.globals) ++
+      instances(config) ++
+      connections(config)
+  end
+
+  # Tasks, globals and instances share one set of names, and two names that differ only in
+  # case are refused, as tags are.
+  defp names(config) do
+    named =
+      for {what, parts} <- [
+            task: config.tasks,
+            global: config.globals,
+            instance: config.instances
+          ],
+          %{name: name} = part <- parts,
+          is_binary(name),
+          do: {Atom.to_string(what), part}
+
+    {_seen, problems} = Enum.reduce(named, {%{}, []}, &seen/2)
+    Enum.reverse(problems)
+  end
+
+  defp seen({what, %{name: name} = part}, {seen, problems}) do
+    key = String.downcase(name)
+    {Map.put_new(seen, key, {what, name}), twice(Map.get(seen, key), what, part, problems)}
+  end
+
+  defp twice(nil, _what, _part, problems), do: problems
+
+  defp twice({what, name}, what, %{name: name} = part, problems),
+    do: [{part.line, "#{what} `#{name}` is declared twice"} | problems]
+
+  defp twice({first, name}, what, %{name: name} = part, problems),
+    do: [
+      {part.line,
+       "`#{name}` names #{a(first)} and #{a(what)}: tasks, globals and instances share one " <>
+         "set of names"}
+      | problems
+    ]
+
+  defp twice({_first, other}, _what, %{name: name} = part, problems),
+    do: [
+      {part.line,
+       "`#{name}` and `#{other}` differ only in case: names are case-sensitive, so these " <>
+         "would be two names"}
+      | problems
+    ]
+
+  defp task(%{name: name, interval: interval, priority: priority, line: line}) do
+    label = label("task", name)
+
+    named(label, name, line) ++
+      ranged(interval, 1, label, "its interval is a whole number of milliseconds from 1", line) ++
+      ranged(priority, 0, label, "its priority is a whole number from 0, the highest,", line)
+  end
+
+  defp named(label, name, line),
+    do: for(message <- shaped(Declarations.name?(name), label), do: {line, message})
+
+  defp ranged(n, least, _label, _what, _line) when is_integer(n) and n >= least and n <= @most,
+    do: []
+
+  defp ranged(n, _least, label, what, line),
+    do: [{line, "#{label}: #{what} to #{@most}, got: #{inspect(n)}"}]
+
+  defp label(what, name) when is_binary(name), do: "#{what} `#{name}`"
+  defp label(what, name), do: "#{what} #{inspect(name)}"
+
+  # Each global in order, with the locations taken so far, by the global that took each.
+  defp globals(globals) do
+    {_taken, problems} = Enum.reduce(globals, {%{}, []}, &global/2)
+    Enum.reverse(problems)
+  end
+
+  defp global(%{name: name, line: line} = global, {taken, problems}) do
+    label = label("global", name)
+    {placed, taken} = located(global.at, global, taken, label)
+    found = named(label, name, line) ++ typed(global, label) ++ initial(global, label) ++ placed
+    {taken, Enum.reverse(found, problems)}
+  end
+
+  defp typed(%{type: type}, _label) when type in [:bool, :dint], do: []
+
+  defp typed(%{type: type, line: line}, label),
+    do: [{line, "#{label}: its type is :bool or :dint, got: #{inspect(type)}"}]
+
+  defp initial(%{initial: nil}, _label), do: []
+
+  defp initial(%{initial: value, at: at, line: line}, label) when at != nil,
+    do: [
+      {line,
+       "#{label} is #{point(kind(at))}: a located global takes no initial value, its value " <>
+         "is the I/O's, found #{inspect(value)}"}
+    ]
+
+  defp initial(%{initial: value, type: type, line: line}, label) when type in [:bool, :dint],
+    do: for(message <- fit(type, value, "its initial value"), do: {line, "#{label}: #{message}"})
+
+  defp initial(_global, _label), do: []
+
+  defp point(:input), do: "an input point"
+  defp point(:output), do: "an output point"
+  defp point(nil), do: "located"
+
+  # :input, :output, or nil for what is not a location.
+  defp kind(at) when is_binary(at),
+    do: direction(Regex.run(@location, at, capture: :all_but_first))
+
+  defp kind(_at), do: nil
+
+  defp direction(["i"]), do: :input
+  defp direction(["q"]), do: :output
+  defp direction(nil), do: nil
+
+  defp located(nil, _global, taken, _label), do: {[], taken}
+
+  defp located(at, %{name: name, line: line}, taken, label) when is_binary(at),
+    do: place(kind(at), at, name, line, taken, label)
+
+  defp located(at, %{line: line}, taken, label),
+    do:
+      {[{line, ~s|#{label}: its location is a string, as in "panel.q.0", got: #{inspect(at)}|}],
+       taken}
+
+  defp place(nil, at, _name, line, taken, label),
+    do:
+      {[
+         {line,
+          "#{label}: `#{at}` is not a location: a location is a device, `i` or `q`, then one " <>
+            "or more numbers, as in `panel.q.0`"}
+       ], taken}
+
