+      end
+    end
+
+    test "every function of the resource takes one from start/1, checked first", %{config: c} do
+      for f <- [
+            fn rt -> Runtime.cycle(rt, -1, :junk) end,
+            fn rt -> Runtime.next_due_in(rt) end,
+            fn rt -> Runtime.get(rt, :junk) end
