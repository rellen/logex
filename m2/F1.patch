+      {_, state} = driven(program, [%{"a" => 1}, %{"a" => 0}], nil)
+      assert state.env["p1"]["x"]["run"] == 1
+      assert state.env["p1"]["y"]["run"] == 0
+      assert state.env["p2"]["x"]["run"] == 0
+      assert state.env["p2"]["y"]["run"] == 1
+    end
+
+    test "a one-shot inside an instance is blocked by its path, and only by it" do
+      program =
+        program(
+          "var_input go bool\nvar_output fired bool\nvar_output top bool\nvar edge bool\n" <>
+            "var p pulse\ncal p go fired\nxic go ons edge ote top\n",
+          [block(@pulse, "pulse")]
+        )
+
+      {_, state} = driven(program, [%{}], nil)
+
+      for {blocked, expected} <- [
+            {["p.edge"], %{"fired" => 0, "top" => 1}},
+            {["edge"], %{"fired" => 1, "top" => 0}},
+            {["edge", "p.edge"], %{"fired" => 0, "top" => 0}}
+          ] do
+        state = %{state | ons_blocked: blocked}
+
+        assert {^expected, %Instance{ons_blocked: []}} =
+                 Runtime.call(program, state, %{"go" => 1}, %Scan{now: 20, first: false})
+      end
+    end
+
+    test "a hand-built env without the instance runs the block from nothing" do
+      program =
+        program("var_input a bool\nvar_output o bool\nvar s1 seal\ncal s1 a 0 o\n", [seal()])
+
+      state = %Instance{type: "p", env: %{"s1" => 7}, now: 0, first: true}
+
+      assert {%{"o" => 1}, %Instance{env: %{"s1" => %{"run" => 1}}}} =
+               Runtime.call(program, state, %{"a" => 1}, %Scan{now: 0, first: true})
+    end
+  end
+
+  describe "the host contract" do
+    test "a function block type is not a program" do
+      assert_raise ArgumentError,
+                   "`seal` is a function block type, which runs inside a program through `cal`: " <>
+                     "an instance is of a %Logex.Program{}",
+                   fn -> Runtime.instance(seal()) end
+    end
+
+    test "a scan's tags are the runtime's" do
+      program = program("var_input a bool\nvar_output o bool\nxic a ote o\n", [])
+      state = Runtime.instance(program)
+
+      assert_raise ArgumentError,
+                   "scan.tags is the runtime's, taken from the program: a host leaves it out, got: %{}",
+                   fn ->
+                     Runtime.call(program, state, %{}, %Scan{now: 0, first: true, tags: %{}})
+                   end
+    end
+  end
+
+  describe "warnings" do
+    test "an instance no cal runs never runs" do
+      assert warnings(
+               "var_input a bool\nvar_output o bool\nvar_output p bool\nvar s1 seal\n" <>
+                 "var s2 seal\ncal s1 a a o\nxic s2.run ote p\n",
+               [seal()]
+             ) ==
+               ["line 5: warning: `s2` is a seal, but no `cal` runs it: it never runs"]
+    end
+
+    test "a cal's operands are uses: an output it writes is written" do
+      assert warnings("var_input a bool\nvar_output o bool\nvar s1 seal\ncal s1 a a o\n", [seal()]) ==
+               []
+
+      assert warnings(
+               "var_input a bool\nvar_output o bool\nvar e bool\nvar s1 seal\nxic a ons e ote o\ncal s1 a a e\n",
+               [seal()]
+             ) == [
+               "line 6: warning: `cal` writes `e`, the storage bit of the `ons` on line 5: the " <>
+                 "one-shot then fires on the wrong scans"
+             ]
+    end
+  end
+
+  describe "growth in the depth of nesting" do
+    # A chain of blocks, each holding and calling the one below it, a one-shot at the
+    # bottom: every walk into a block reaches every level. At 100 and 400 levels, over 40
+    # runs, a scan grew 3.96x to 4.09x, compiling the next block 2.23x (its recursion check
+    # walks the chain; the rest of the compile is fixed), and an accept and a test 3.70x to
+    # 3.91x. Each bound is a fifth or more above the highest.
+    defp chain(depth) do
+      Enum.reduce(0..(depth - 1), [], fn k, below ->
+        {:ok, type} = Logex.compile(link(k), name: "b#{k}", types: Enum.take(below, 1))
+        [type | below]
+      end)
+    end
+
+    defp link(0),
+      do:
+        "function_block b0\nvar_input a bool\nvar_output q bool\nvar e bool\nxic a ons e ote q\n"
+
+    defp link(k),
+      do:
+        "function_block b#{k}\nvar_input a bool\nvar_output q bool\nvar x b#{k - 1}\ncal x a q\n"
+
+    defp least(fun) do
+      Enum.min(
+        for _ <- 1..3 do
+          {:reductions, before} = Process.info(self(), :reductions)
+          fun.()
+          {:reductions, later} = Process.info(self(), :reductions)
+          later - before
+        end
+      )
+    end
+
+    defp costs(depth) do
+      [top | _] = chain(depth)
+      source = "var_input a bool\nvar_output q bool\nvar top #{top.name}\n"
+      original = program(source <> "cal top a q\n", [top])
+      candidate = program(source <> "var z bool\ncal top a q\nxic a ote z\n", [top])
+      {_, state} = driven(original, [%{}], nil)
+
+      {least(fn -> Runtime.call(original, state, %{"a" => 1}, %Scan{now: 20, first: false}) end),
+       least(fn -> Logex.compile(link(depth), name: "b#{depth}", types: [top]) end),
+       least(fn ->
+         {:ok, edit, _} = Logex.Edit.accept(original, candidate, state)
+         Logex.Edit.test(edit, state)
+       end)}
+    end
+
+    test "a scan, compiling a block and an edit stay linear in it" do
+      {scan, compile, edit} = costs(100)
+      {scan4, compile4, edit4} = costs(400)
+      assert scan4 / scan < 5, "4x the depth took #{Float.round(scan4 / scan, 2)}x to scan"
+      assert compile4 / compile < 2.8, "#{Float.round(compile4 / compile, 2)}x to compile"
+      assert edit4 / edit < 4.8, "#{Float.round(edit4 / edit, 2)}x to accept and test"
+    end
+  end
+end
