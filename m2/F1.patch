@@ -0,0 +1,831 @@
+defmodule Logex.FunctionBlockTest do
+  @moduledoc """
+  M2-5: user function blocks (`docs/organisation.md` §4.3). A `.ld` file headed
+  `function_block <name>` compiles to its `%Logex.FbType{}`, a program given it in
+  `types:` declares instances of it, `var s1 seal`, and runs each with `cal`, rung power
+  as EN and nothing copied on a false EN (decision 12). Every program here comes from
+  source, and every diagnostic case asserts the whole list.
+  """
+  use ExUnit.Case, async: true
+
+  alias Logex.{Diagnostic, FbType, Instance, Runtime, Scan, Tag}
+
+  @seal """
+  function_block seal
+  var_input start bool
+  var_input stop bool
+  var_output run bool
+
+  ( xic start | xic run ) xio stop ote run
+  """
+
+  # A block that holds a one-shot and a counter of its pulses, for the first-scan and
+  # online-edit cases.
+  @pulse """
+  function_block pulse
+  var_input go bool
+  var_output fired bool
+  var edge bool
+  var count dint
+
+  xic go ons edge ote fired
+  xic fired move 1 count
+  """
+
+  # A block that holds a timer, for the frozen-timer case.
+  @delay """
+  function_block delay
+  var_input go bool
+  var_output done bool
+  var t1 ton
+
+  xic go ton t1 100
+  xic t1.dn ote done
+  """
+
+  defp block(source, name, types \\ []) do
+    {:ok, %FbType{} = type} = Logex.compile(source, name: name, types: types)
+    type
+  end
+
+  defp seal, do: block(@seal, "seal")
+
+  defp program(source, types) do
+    {:ok, program} = Logex.compile(source, name: "p", types: types)
+    program
+  end
+
+  defp errors(source, types \\ nil, name \\ "p") do
+    {:error, diagnostics} = Logex.compile(source, name: name, types: types || [seal()])
+    Enum.map(diagnostics, &Diagnostic.format/1)
+  end
+
+  # Through the compiler alone, which names no block: a header's own mistakes, with no
+  # name to match.
+  defp compiled_errors(source, types \\ []) do
+    {:ok, tokens, _} = Logex.Compiler.tokenize(source)
+    {:ok, tree} = Logex.Compiler.parse(tokens)
+    {:error, diagnostics} = Logex.Compiler.instructionize(tree, [], types)
+    Enum.map(diagnostics, &Diagnostic.format/1)
+  end
+
+  defp warnings(source, types) do
+    Enum.map(program(source, types).warnings, &Diagnostic.format/1)
+  end
+
+  # Each step's inputs, scanned 10 ms after the last; the outputs of every scan.
+  defp drive(program, steps, state \\ nil) do
+    {outputs, _state} = driven(program, steps, state)
+    outputs
+  end
+
+  defp driven(program, steps, state) do
+    Enum.map_reduce(steps, state || Runtime.instance(program), fn inputs, state ->
+      Runtime.call(program, state, inputs, %Scan{now: state.now + 10, first: state.first})
+    end)
+  end
+
+  describe "a function block's file" do
+    test "is headed by its name, and compiles to its type, a member per declaration" do
+      type = seal()
+
+      assert %FbType{name: "seal", body: %Logex.Program{name: "seal", source: @seal}} = type
+
+      assert Enum.map(type.members, &{&1.name, &1.role, &1.type, &1.write, &1.initial}) == [
+               {"start", :input, :bool, false, 0},
+               {"stop", :input, :bool, false, 0},
+               {"run", :output, :bool, false, 0}
+             ]
+
+      assert FbType.signature(type) ==
+               [{:instance, "seal"}, {:value, :bool}, {:value, :bool}, {:write, :bool}]
+    end
+
+    test "its members follow the text, inputs then outputs as cal's operands, vars local" do
+      type =
+        block(
+          """
+          function_block mixed
+          var_output q dint 7
+          var n dint 3
+          var_input a bool
+          var t1 ton
+          var s seal
+          var_input b dint
+          var flag bool
+
+          xic a ton t1 250
+          xic a cal s a a flag
+          move b q
+          """,
+          "mixed",
+          [seal()]
+        )
+
+      assert Enum.map(type.members, &{&1.name, &1.role}) == [
+               {"q", :output},
+               {"n", :local},
+               {"a", :input},
+               {"t1", :local},
+               {"s", :local},
+               {"b", :input},
+               {"flag", :local}
+             ]
+
+      assert Enum.map(FbType.formals(type), & &1.name) == ["a", "b", "q"]
+
+      # A member starts where its declaration says: a timer at the preset on its `ton`.
+      assert %{"q" => 7, "n" => 3, "t1" => %{"pre" => 250, "acc" => 0}, "s" => %{"run" => 0}} =
+               FbType.initial(type)
+    end
+
+    test "its header is the first rung: blank lines and comments may come before it" do
+      assert %FbType{name: "seal"} = block("// a seal-in\n\n" <> @seal, "seal")
+
+      assert errors("// a seal-in\n" <> @seal, [], "seel") == [
+               "line 2: `function_block seal` names this block `seal`, but it is compiled as " <>
+                 "`seel`: a function block's first line names it as its file does"
+             ]
+    end
+
+    test "the keyword is matched in any case" do
+      assert %FbType{name: "seal"} =
+               block(String.replace(@seal, "function_block", "FUNCTION_BLOCK"), "seal")
+    end
+
+    test "its first line names it as the file does" do
+      assert errors(@seal, [], "seel") == [
